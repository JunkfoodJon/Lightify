// ─────────────────────────────────────────────────────────────────────────────
// Lightify — Tier 2 native shell (Slint, software renderer)
// Ports the existing HTML/CSS design: same palette, layout, now-playing centrepiece.
// Data is mock for the spike; the real port wires these props to the Rust host.
// ─────────────────────────────────────────────────────────────────────────────
import { ListView, ScrollView } from "std-widgets.slint";

// Bundled faces (OFL, licences beside them in ui/fonts/): the redesign's UI face and
// its mono for times, counts and `// kicker` labels. Bundled so every machine renders
// the same, with nothing to install.
import "./fonts/SpaceGrotesk-Regular.ttf";
import "./fonts/SpaceGrotesk-Medium.ttf";
import "./fonts/SpaceGrotesk-Bold.ttf";
import "./fonts/JetBrainsMono-Regular.ttf";
import "./fonts/JetBrainsMono-Medium.ttf";
import "./fonts/Yellowtail-Regular.ttf";

// Palette — the v3 redesign (redesign-mockups/v3/Main.dc.html): six greys and one
// accent. `accent` is `in-out`, not `out` — the host reassigns it at runtime from the
// current cover's sampled colour, so everything that marks "now" tints to the song.
// Only "now" takes it: the play button, the seek fill, the playing row, the Local dot,
// an open drawer's icon, the active Beatport mode.
export global Pal {
    out property <color> bg:        #0a0a0a;
    out property <color> card:      #111111;   // cards, fields, raised blocks
    out property <color> surface:   #161616;   // hover
    out property <color> surface2:  #1e1e1e;   // selected / pressed
    out property <color> panel:     #0d0d0d;   // side panels, drawers
    out property <color> border:    #232323;
    out property <color> border-hi: #2e2e2e;
    out property <color> border-strong: #4a4a4a;
    in-out property <color> accent: #34d399;
    out property <color> accent-dim:#10b981;
    out property <color> text:      #f5f5f5;
    // Secondary text tiers; both pass 4.5:1 on `card`. `faint` is for decoration only
    // — rules, grips, disabled glyphs — never for text someone needs to read.
    out property <color> text2:     #b3b3b3;
    out property <color> text3:     #969696;
    out property <color> faint:     #5c5c5c;
    out property <color> heart:     #fb7185;
    out property <color> danger:    #f87171;
    out property <color> ink:       #0a0a0a;   // glyphs on the accent / inverted pills
}

// The two faces, by family name (registered by the imports above).
export global Fonts {
    out property <string> ui:   "Space Grotesk";
    out property <string> mono: "JetBrains Mono";
}

// Motion (UI-PLAN A6). `reduced` mirrors Windows' "Animation effects" setting
// (SPI_GETCLIENTAREAANIMATION, set by the host); every transition checks it. All
// motion here is transition-only — nothing animates while the UI is idle.
export global Motion {
    in-out property <bool> reduced: false;
    // Panel slides and the cover expand always run: the user asked for them by name,
    // and with Windows' Animation effects off (`reduced`) they would otherwise snap.
    // (`in-out` only so a headless `--shot` can zero it and render the end state.)
    in-out property <duration> slide: 260ms;
}

// Spacing scale (4-based). New and reworked layouts use these; older hand-tuned
// paddings migrate section by section, each checked by render (UI-PLAN B3).
export global Space {
    out property <length> xs:  4px;
    out property <length> s:   8px;
    out property <length> m:   12px;
    out property <length> l:   16px;
    out property <length> xl:  24px;
    out property <length> xxl: 32px;
}

// Type scale. Nothing in the UI goes below `micro`; uppercase letter-spaced labels
// use `micro`, subtitles / meta / small buttons use `caption`.
export global TypeScale {
    out property <length> micro:   10px;
    out property <length> caption: 11px;
    out property <length> small:   12px;
    out property <length> body:    13px;
    out property <length> section: 15px;
    out property <length> title:   20px;
}

// `active` = this row is the current playback source (`.list-item.playing`);
// `playing` = and it is actually playing (`.playing-active` vs `.playing-paused`).
struct Row { id: string, name: string, sub: string, active: bool, liked: bool, playing: bool }
struct Trk { uri: string, name: string, artist: string, playable: bool, active: bool, playing: bool, selected: bool }
// `kind`: track | artist | album | playlist (a hit), top (the Top result card; `meta`
// then holds the hit's own kind), header (a section title; `meta` = its link text),
// recent (a past query). `art` = cover URL (the host resolves it into `search-art`);
// `meta` on a track = its duration.
struct SearchRow { name: string, sub: string, kind: string, selected: bool, art: string, meta: string }
// `pending`: 0 = a real queue row; 1 = a Beatport chart row being looked up on Spotify
// right now; 2 = one waiting its turn (see the QUEUE panel's chart strip).
struct SideRow { name: string, artist: string, time: string, playing: bool, selected: bool, pending: int }
// One row of the DOWNLOADS sidebar. `progress` is 0..100; `state` is
// 0 = queued/working, 1 = finished on disk, 2 = failed/unavailable.
struct DlRow { name: string, sub: string, progress: int, state: int }
struct BpItem { title: string, sub: string, selected: bool }
struct DeviceRow { name: string, active: bool }
struct CmdRow { title: string, hint: string }
// One row of a right-click menu (`.ctx-menu-item`). `muted` = the action exists in
// the shipped app but not here (host-only downloads, unported station); clicking it
// says so in the status bar rather than pretending the row isn't there.
struct MenuItem { label: string, danger: bool, muted: bool }

// A monochrome SVG-path icon inside a round hover target (`.ib`). On (`is-active`):
// white glyph on the selected grey with a 4px accent dot under it.
component IconBtn inherits Rectangle {
    in property <string> cmds;
    in property <color> tint: Pal.text3;
    in property <color> hover-tint: Pal.text;
    in property <length> icon: 18px;
    in property <length> box: 32px;
    in property <bool> is-active: false;
    in property <bool> stroked: false;      // stroke the path instead of filling it
    in property <bool> fill-too: false;     // stroked AND filled (closed shapes solid)
    in property <length> stroke-w: 1.6px;
    in property <bool> show-dot: true;      // the accent dot when on
    callback clicked <=> ta.clicked;
    width: box;
    height: box;
    border-radius: self.width / 2;
    background: ta.pressed ? Pal.surface2 : (root.is-active ? Pal.surface2 : (ta.has-hover ? Pal.surface : transparent));
    animate background { duration: 150ms; easing: ease-out; }
    ta := TouchArea { }
    property <color> icon-paint: root.is-active ? Pal.text : (ta.has-hover ? root.hover-tint : root.tint);
    Path {
        width: root.icon;
        height: root.icon;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.cmds;
        fill: (root.stroked && !root.fill-too) ? transparent : root.icon-paint;
        stroke: root.stroked ? root.icon-paint : transparent;
        stroke-width: root.stroke-w;
        stroke-line-cap: round;
    }
    if root.is-active && root.show-dot : Rectangle {
        width: 4px; height: 4px; border-radius: 2px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 7px;
        background: Pal.accent;
    }
}

// Stroke icon paths (24 grid, 1.6 stroke, round caps) — the redesign's set.
export global Icons {
    out property <string> library: "M5 4v16M10 4v16M14.5 4.5l4.5 15";
    out property <string> search: "M11 4.5a6.5 6.5 0 1 1 0 13a6.5 6.5 0 1 1 0-13zM16 16l4 4";
    out property <string> charts: "M6 19v-6M12 19V5M18 19v-9";
    out property <string> shuffle: "M16 4h4v4M4 20L20 4M20 16v4h-4M15 15l5 5M4 4l5 5";
    out property <string> prev: "M18 6v12L9 12zM6 6v12";
    out property <string> next: "M6 6v12l9-6zM18 6v12";
    out property <string> repeat: "M17 3.5l3 3-3 3M4 11.5v-1a4 4 0 0 1 4-4h12M7 20.5l-3-3 3-3M20 12.5v1a4 4 0 0 1-4 4H4";
    out property <string> volume: "M4 9.5v5h3.5L12 18.5v-13L7.5 9.5zM15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11";
    out property <string> heart: "M12 19.5s-7.5-4.4-7.5-10A4.2 4.2 0 0 1 12 7a4.2 4.2 0 0 1 7.5 2.5c0 5.6-7.5 10-7.5 10z";
    out property <string> station: "M12 10.2a1.8 1.8 0 1 1 0 3.6a1.8 1.8 0 1 1 0-3.6zM8.2 8.2a5.4 5.4 0 0 0 0 7.6M15.8 8.2a5.4 5.4 0 0 1 0 7.6M5.4 5.4a9.3 9.3 0 0 0 0 13.2M18.6 5.4a9.3 9.3 0 0 1 0 13.2";
    out property <string> add-queue: "M4 6h12M4 11h12M4 16h7M17 14v6M14 17h6";
    out property <string> queue: "M4 6h16M4 12h16M4 18h10";
    out property <string> recent: "M12 4a8 8 0 1 1 0 16a8 8 0 1 1 0-16zM12 7.5V12l3 2";
    out property <string> download: "M12 4v11M7.5 10.5L12 15l4.5-4.5M5 19.5h14";
    out property <string> gear: "M12 9a3 3 0 1 1 0 6a3 3 0 1 1 0-6zM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z";
    out property <string> close: "M6.5 6.5l11 11M17.5 6.5l-11 11";
    out property <string> back: "M14.5 6L8.5 12l6 6";
    out property <string> note: "M9 18V6l10-2v12M6.5 15.5a2.5 2.5 0 1 1 0 5a2.5 2.5 0 1 1 0-5zM16.5 13.5a2.5 2.5 0 1 1 0 5a2.5 2.5 0 1 1 0-5z";
    out property <string> check: "M5 12.5l4.5 4.5L19 7.5";
    out property <string> play: "M8.5 5.5v13l11-6.5z";
    out property <string> pause: "M7 5.5h3.4v13H7zM13.6 5.5H17v13h-3.4z";
    out property <string> bars: "M6 18v-5M12 18V7M18 18v-8";
    // A dotted ring (waiting) and a ring + quarter arc (looking it up now).
    out property <string> ring-dots: "M18.90 12.00a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0 -2.2 0zM16.56 17.66a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0 -2.2 0zM10.90 20.00a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0 -2.2 0zM5.24 17.66a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0 -2.2 0zM2.90 12.00a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0 -2.2 0zM5.24 6.34a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0 -2.2 0zM10.90 4.00a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0 -2.2 0zM16.56 6.34a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0 -2.2 0z";
    out property <string> ring: "M12 4a8 8 0 1 1 0 16a8 8 0 1 1 0-16z";
    out property <string> ring-arc: "M12 4a8 8 0 0 1 8 8";
}

// A footer toggle (Queue / Recent / Downloads): stroked icon + label (UI-PLAN A4).
// With `show-label` off it is icon-only and names itself in a small tooltip above on
// hover, so no control is ever unidentifiable.
component FootTab inherits Rectangle {
    in property <string> cmds;
    in property <string> label;
    in property <bool> active;
    in property <bool> show-label: true;
    callback clicked <=> ta.clicked;
    // `.ft`: a pill; on = selected grey, white label, accent icon.
    property <color> ink: root.active ? Pal.text : (ta.has-hover ? Pal.text : Pal.text3);
    height: 28px;
    width: lay.preferred-width;
    border-radius: 14px;
    background: ta.pressed || root.active ? Pal.surface2 : (ta.has-hover ? Pal.surface : transparent);
    animate background { duration: 200ms; easing: ease-out; }
    ta := TouchArea { }
    lay := HorizontalLayout {
        padding-left: 11px;
        padding-right: root.show-label ? 12px : 11px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 15px; height: 15px;
                viewbox-width: 24; viewbox-height: 24;
                commands: root.cmds;
                fill: transparent;
                stroke: root.active ? Pal.accent : root.ink;
                stroke-width: 1.8px;
                stroke-line-cap: round;
            }
        }
        if root.show-label : Text {
            text: root.label;
            color: root.ink;
            font-size: TypeScale.small;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    if !root.show-label && ta.has-hover : Rectangle {
        y: -self.height - 6px;
        x: (parent.width - self.width) / 2;
        width: tip.preferred-width + 14px;
        height: 22px;
        border-radius: 4px;
        background: Pal.surface2;
        border-width: 1px;
        border-color: Pal.border-hi;
        tip := Text { text: root.label; color: Pal.text; font-size: TypeScale.caption; x: 7px; y: (parent.height - self.height) / 2; }
    }
}

// One left-panel list row (icon dot + name + sub/count).
component ListRow inherits Rectangle {
    in property <image> art;             // cover thumbnail; empty = placeholder glyph
    in property <string> name;
    in property <string> sub;
    in property <bool> active: false;    // is the active playback source
    in property <bool> playing: false;   // …and playback is running (vs paused)
    in property <bool> liked: false;
    callback clicked <=> ta.clicked;
    // Double-click plays the whole playlist (the original's row `dblclick`); the
    // single click still expands it first, exactly as in the browser.
    callback double-clicked <=> ta.double-clicked;
    // Right-click → open the row menu at the pointer (window coordinates).
    callback menu(mx: length, my: length);
    height: 52px;
    ta := TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(ta.absolute-position.x + ta.mouse-x, ta.absolute-position.y + ta.mouse-y);
            }
        }
    }
    // Row background: an inset rounded tile (`.row`), hover grey; the active source
    // row (`.row.now`) holds a quiet grey and marks itself with its name + the bars.
    Rectangle {
        x: 6px; width: parent.width - 12px;
        border-radius: 12px;
        background: root.active ? #1a1a1a : (ta.has-hover ? Pal.surface : transparent);
        animate background { duration: 150ms; }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            // Cover slot. Until a cover arrives — or for a playlist without one, and
            // for Liked Songs — it holds the state-tinted glyph on a quiet tile.
            Rectangle {
                width: 38px; height: 38px;
                border-radius: 8px;
                clip: true;
                background: Pal.surface2;
                if !root.liked && root.art.width > 0 : Image {
                    source: root.art;
                    width: parent.width; height: parent.height;
                    image-fit: cover;
                }
                if root.liked : Path {
                    width: 17px; height: 17px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 24; viewbox-height: 24;
                    fill: root.active && !root.playing ? Pal.text2 : Pal.heart;
                    commands: "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z";
                }
                // Plain 3-line playlist glyph — mirrors `getTypeIcon('playlist')`.
                // Tinted like `.item-icon` under `.list-item.playing`/`.playing-paused`:
                // accent while this row is playing, grey while paused-here, dim (--text-3)
                // otherwise.
                if !root.liked && root.art.width == 0 : Path {
                    width: 14px; height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 24; viewbox-height: 24;
                    fill: root.active ? (root.playing ? Pal.accent : Pal.text2) : Pal.faint;
                    commands: "M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h11v2H3v-2z";
                }
            }
        }
        // Two-line body: name over "N tracks • owner" — mirrors makeListItem.
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: root.active && root.playing ? Pal.accent : Pal.text;
                font-size: 13.5px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.sub;
                color: Pal.text3;
                font-size: 11px;
                font-family: Fonts.mono;
                overflow: elide;
            }
        }
        // The now-playing bars: accent while playing here, grey while paused here.
        if root.active : VerticalLayout {
            alignment: center;
            Path {
                width: 16px; height: 16px;
                viewbox-width: 24; viewbox-height: 24;
                commands: Icons.bars;
                fill: transparent;
                stroke: root.playing ? Pal.accent : Pal.text3;
                stroke-width: 2px;
                stroke-line-cap: round;
            }
        }
    }
}

// The touch handling shared by every selectable list row:
//   • quick click → `activate` (play/open) — or, while anything is selected,
//     `clear-sel` instead (a quick click is how a selection is dropped);
//   • press and HOLD (`hold-ms`) → a drag-selection starts on this row: `hold-begin`,
//     then `hold-move(content-y)` as the pointer moves (the y is in the list's
//     CONTENT coordinates, so it stays right while the list auto-scrolls), `hold-end`
//     on release. The host adds each drag on top of what is already selected, so
//     separate groups can be built with gaps between them;
//   • Ctrl/Shift + click → `mod-click` (toggle / extend), as before;
//   • right click → `menu-at` (window coordinates).
// A press that wanders more than a few px before the hold time is just a click.
component RowTouch inherits TouchArea {
    in property <bool> selectable: true;
    in property <bool> has-selection: false;
    in property <length> row-y;
    in property <duration> hold-ms: 300ms;
    callback activate();
    callback clear-sel();
    callback menu-at(mx: length, my: length);
    callback mod-click(ctrl: bool, shift: bool);
    callback hold-begin();
    callback hold-move(content-y: length);
    callback hold-tick();
    callback hold-end();
    property <bool> skip: false;
    property <bool> armed: false;
    property <bool> dragging: false;
    property <length> px;
    property <length> py;
    // While a drag is live: a steady tick so the list can auto-scroll even when the
    // pointer is held still at an edge.
    Timer {
        interval: 30ms;
        running: root.dragging;
        triggered => { root.hold-tick(); }
    }
    Timer {
        interval: root.hold-ms;
        running: root.armed;
        triggered => {
            root.armed = false;
            root.dragging = true;
            root.skip = true;
            root.hold-begin();
            // Report where the pointer is now: the list's edge auto-scroll ticks from
            // here on and would otherwise act on a stale position (the list's top).
            root.hold-move(root.row-y + root.mouse-y);
        }
    }
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down) {
            if (e.button == PointerEventButton.right) {
                root.menu-at(root.absolute-position.x + root.mouse-x, root.absolute-position.y + root.mouse-y);
            } else if (e.button == PointerEventButton.left) {
                root.skip = false;
                if (root.selectable && (e.modifiers.control || e.modifiers.shift)) {
                    root.skip = true;
                    root.mod-click(e.modifiers.control, e.modifiers.shift);
                } else if (root.selectable) {
                    root.armed = true;
                    root.px = root.mouse-x;
                    root.py = root.mouse-y;
                }
            }
        }
        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
            root.armed = false;
            if (root.dragging) {
                root.dragging = false;
                root.hold-end();
            }
        }
    }
    moved => {
        if (root.armed && (abs(root.mouse-x - root.px) > 8px || abs(root.mouse-y - root.py) > 8px)) {
            root.armed = false;
        }
        if (root.dragging) {
            root.hold-move(root.row-y + root.mouse-y);
        }
    }
    clicked => {
        if (root.skip) {
            root.skip = false;
        } else if (root.selectable && root.has-selection) {
            root.clear-sel();
        } else {
            root.activate();
        }
    }
}

// A two-line track row (name over artist), dimmed when unplayable — like the original.
component TrackRow inherits Rectangle {
    in property <string> name;
    in property <string> artist;
    in property <bool> playable: true;
    in property <bool> active: false;    // this row is the currently-loaded track
    in property <bool> playing: false;   // ...and playback is running
    callback clicked();
    // Double-click anywhere in the list drops the selection, like the original's
    // document-level `dblclick` handler.
    callback double-clicked <=> ta.double-clicked;
    // Right-click → the track menu (Play / Add to queue / Share / …).
    callback menu(mx: length, my: length);
    // Multi-select: hold to drag-select (adds to the selection), a quick click clears
    // it, Ctrl+click toggles a row, Shift+click extends — see `RowTouch`.
    in property <bool> selected: false;
    in property <bool> has-selection: false;
    callback select-click(ctrl: bool, shift: bool);
    callback clear-sel();
    callback hold-begin();
    callback hold-move(content-y: length);
    callback hold-tick();
    callback hold-end();
    height: 46px;
    opacity: root.playable ? 1.0 : 0.4;
    ta := RowTouch {
        row-y: root.y;
        has-selection: root.has-selection;
        activate => { root.clicked(); }
        clear-sel => { root.clear-sel(); }
        menu-at(mx, my) => { root.menu(mx, my); }
        mod-click(c, s) => { root.select-click(c, s); }
        hold-begin => { root.hold-begin(); }
        hold-move(y) => { root.hold-move(y); }
        hold-tick => { root.hold-tick(); }
        hold-end => { root.hold-end(); }
    }
    // Inset tile: hover grey, selected (`.trow.sel`) the selected grey with an accent
    // hairline, the loaded track a quiet grey.
    Rectangle {
        x: 6px; width: parent.width - 12px;
        border-radius: 10px;
        background: root.selected ? Pal.surface2 : (root.active ? #1a1a1a : (ta.has-hover ? Pal.surface : transparent));
        border-width: root.selected ? 1px : 0px;
        border-color: Pal.accent.with-alpha(0.45);
        animate background { duration: 150ms; }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            if !root.active : Path {
                width: 15px; height: 15px;
                viewbox-width: 24; viewbox-height: 24;
                fill: transparent;
                stroke: Pal.faint;
                stroke-width: 1.6px;
                commands: Icons.note;
            }
            if root.active : Path {
                width: 15px; height: 15px;
                viewbox-width: 24; viewbox-height: 24;
                fill: transparent;
                stroke: root.playing ? Pal.accent : Pal.text3;
                stroke-width: 2px;
                stroke-line-cap: round;
                commands: Icons.bars;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: root.active && root.playing ? Pal.accent : Pal.text;
                font-size: 13px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.artist;
                color: Pal.text3;
                font-size: TypeScale.small;
                overflow: elide;
            }
        }
    }
}

// A DOWNLOADS sidebar row: name + "status - artist - 42%" summary, with a thin
// progress bar while the bridge is actually working on it. Mirrors
// `renderSidebarDownloads` (`app.js:5910`): left-click on a finished row opens its
// folder, right-click opens the retry/cancel/open/delete menu.
component DlTrackRow inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <int> progress: 0;      // 0..100
    in property <int> state: 0;         // 0 = working, 1 = done, 2 = failed
    callback clicked();
    callback menu(mx: length, my: length);
    height: 52px;
    Rectangle {
        x: 6px; width: parent.width - 12px;
        border-radius: 10px;
        background: dta.has-hover ? Pal.surface : transparent;
    }
    dta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu(dta.absolute-position.x + dta.mouse-x, dta.absolute-position.y + dta.mouse-y);
            }
        }
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 11px;
        // No `alignment` on purpose: `alignment: start` packs children at their
        // natural width and IGNORES stretch factors, which sized the text column
        // (and with it the progress bar) to the track name instead of the row.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            // Done -> check, failed -> cross, otherwise the download arrow.
            Path {
                width: 15px; height: 15px;
                viewbox-width: 24; viewbox-height: 24;
                fill: transparent;
                stroke: root.state == 1 ? Pal.text : root.state == 2 ? Pal.danger : Pal.text3;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                commands: root.state == 1
                    ? "M5 12.5l4.5 4.5L19 7.5"
                    : root.state == 2
                        ? "M6.5 6.5l11 11M17.5 6.5l-11 11"
                        : "M12 4.5v9.6M8.3 10.4L12 14.1l3.7-3.7M5 18.5h14";
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: root.state == 2 ? Pal.text2 : Pal.text;
                font-size: 13px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.sub;
                color: root.state == 2 ? Pal.danger : Pal.text3;
                font-size: 11px;
                font-family: Fonts.mono;
                overflow: elide;
            }
            // Progress track - only while a download is genuinely in flight.
            if root.state == 0 && root.progress > 0 : Rectangle {
                height: 3px;
                border-radius: 1.5px;
                background: Pal.border;
                Rectangle {
                    x: 0;
                    width: parent.width * (min(root.progress, 100) / 100);
                    height: parent.height;
                    border-radius: 1.5px;
                    background: Pal.text;
                }
            }
        }
    }
}

// A sidebar (queue / recent) track row: two-line name+artist, the active row shows
// an accent equalizer + accent name (mirrors #sidebar-list .list-item.playing);
// recent rows show a right-aligned relative timestamp (.item-time).
component SideTrackRow inherits Rectangle {
    in property <string> name;
    in property <string> artist;
    in property <string> time;
    in property <bool> playing: false;
    in property <bool> selectable: true;
    in property <bool> selected: false;
    // QUEUE mode only (RECENT/DOWNLOADS pass false) — per-row remove: one local
    // `removefromqueue` on our engine (see `Cmd::RemoveQueuedTrack`).
    in property <bool> removable: false;
    // See `SideRow.pending`.
    in property <int> pending: 0;
    callback clicked();
    callback menu(mx: length, my: length);
    callback select-click(ctrl: bool, shift: bool);
    in property <bool> has-selection: false;
    callback clear-sel();
    callback hold-begin();
    callback hold-move(content-y: length);
    callback hold-tick();
    callback hold-end();
    callback remove();
    height: 48px;
    Rectangle {
        x: 6px; width: parent.width - 12px;
        border-radius: 10px;
        background: root.selected ? Pal.surface2 : (root.playing ? #1a1a1a : (ta.has-hover ? Pal.surface : transparent));
        border-width: root.selected ? 1px : 0px;
        border-color: Pal.accent.with-alpha(0.45);
    }
    ta := RowTouch {
        selectable: root.selectable;
        row-y: root.y;
        has-selection: root.has-selection;
        activate => { root.clicked(); }
        clear-sel => { root.clear-sel(); }
        menu-at(mx, my) => { root.menu(mx, my); }
        mod-click(c, s) => { root.select-click(c, s); }
        hold-begin => { root.hold-begin(); }
        hold-move(y) => { root.hold-move(y); }
        hold-tick => { root.hold-tick(); }
        hold-end => { root.hold-end(); }
    }
    // No `alignment: start`: it packs children at their natural width and ignores
    // the text column's stretch, which left the timestamp floating mid-row.
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            // Playing → the accent bars; a chart row still being found → a ring;
            // otherwise the note icon.
            if root.pending == 0 : Path {
                width: 15px; height: 15px;
                viewbox-width: 24; viewbox-height: 24;
                fill: transparent;
                stroke: root.playing ? Pal.accent : Pal.faint;
                stroke-width: root.playing ? 2px : 1.6px;
                stroke-line-cap: round;
                commands: root.playing ? Icons.bars : Icons.note;
            }
            if root.pending == 1 : Rectangle {
                width: 15px; height: 15px;
                Path {
                    width: 100%; height: 100%;
                    viewbox-width: 24; viewbox-height: 24;
                    fill: transparent; stroke: Pal.border-hi; stroke-width: 2px;
                    commands: Icons.ring;
                }
                Path {
                    width: 100%; height: 100%;
                    viewbox-width: 24; viewbox-height: 24;
                    fill: transparent; stroke: Pal.accent; stroke-width: 2px; stroke-line-cap: round;
                    commands: Icons.ring-arc;
                }
            }
            if root.pending == 2 : Path {
                width: 15px; height: 15px;
                viewbox-width: 24; viewbox-height: 24;
                fill: #3a3a3a;
                commands: Icons.ring-dots;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: root.pending > 0 ? #7a7a7a : (root.playing ? Pal.accent : Pal.text);
                font-size: 13px;
                font-weight: root.pending > 0 ? 400 : 500;
                overflow: elide;
            }
            Text { text: root.artist; color: root.pending > 0 ? Pal.faint : Pal.text3; font-size: TypeScale.small; overflow: elide; }
        }
        if root.pending == 1 : VerticalLayout {
            alignment: center;
            // Pulses only while this one row is being looked up (a few seconds).
            Text {
                text: "finding";
                color: Pal.accent;
                font-size: 11px;
                font-family: Fonts.mono;
                opacity: 0.45 + 0.55 * abs(sin(animation-tick() / 1ms * 0.13deg));
            }
        }
        if root.pending == 0 && root.time != "" : VerticalLayout {
            alignment: center;
            Text { text: root.time; color: Pal.text3; font-size: 11px; font-family: Fonts.mono; }
        }
        if root.removable : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px; height: 20px; border-radius: 5px;
                background: rmta.has-hover ? #f8717122 : transparent;
                rmta := TouchArea { clicked => { root.remove(); } }
                Text {
                    text: "\u{00D7}";
                    color: rmta.has-hover ? Pal.danger : Pal.text3;
                    font-size: 13px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2 - 1px;
                }
            }
        }
    }
}

// One segment of the Library / Search / Beatport tab control (`.seg .tb`): icon +
// label; the selected one sits on the selected grey.
component TabBtn inherits Rectangle {
    in property <string> label;
    in property <string> cmds;
    in property <bool> active;
    callback clicked <=> ta.clicked;
    horizontal-stretch: 1;
    height: 32px;
    border-radius: 16px;
    background: root.active ? Pal.surface2 : transparent;
    animate background { duration: 200ms; easing: ease-out; }
    ta := TouchArea { }
    property <color> ink: root.active || ta.has-hover ? Pal.text : Pal.text3;
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 15px; height: 15px;
                viewbox-width: 24; viewbox-height: 24;
                commands: root.cmds;
                fill: transparent;
                stroke: root.ink;
                stroke-width: 1.7px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            color: root.ink;
            font-size: 12.5px;
            font-weight: 500;
        }
    }
}

// A segment in a small segmented control (`.seg .sg`): Recent | A→Z, poll rate.
component SegBtn inherits Rectangle {
    in property <string> label;
    in property <string> note;      // optional mono suffix ("5s")
    in property <bool> active;
    in property <length> h: 24px;
    in property <bool> stretch: false;
    callback clicked <=> ta.clicked;
    height: root.h;
    horizontal-stretch: root.stretch ? 1 : 0;
    preferred-width: lay.preferred-width;
    min-width: lay.preferred-width;
    border-radius: self.height / 2;
    background: root.active ? Pal.surface2 : transparent;
    animate background { duration: 200ms; easing: ease-out; }
    ta := TouchArea { }
    lay := HorizontalLayout {
        alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: root.active || ta.has-hover ? Pal.text : Pal.text3;
            font-size: TypeScale.small;
            font-weight: 500;
        }
        if root.note != "" : Text {
            text: root.note;
            vertical-alignment: center;
            color: Pal.text3;
            font-size: 11px;
            font-family: Fonts.mono;
        }
    }
}

// The track the segments sit in (`.seg`).
component SegTrack inherits Rectangle {
    border-radius: self.height / 2;
    background: Pal.card;
    border-width: 1px;
    border-color: Pal.border;
}

// `.btn-primary.btn-xs` / `.btn-sm` — a small bordered action button. `enabled:
// false` reproduces `:disabled { opacity: 0.32; pointer-events: none }`.
component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <length> pad: 10px;
    callback clicked();
    height: 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.enabled && ta.has-hover ? Pal.border-hi : Pal.border;
    background: root.enabled && ta.has-hover ? Pal.surface2 : transparent;
    opacity: root.enabled ? 1.0 : 0.32;
    ta := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: root.enabled && ta.has-hover ? Pal.text : Pal.text2;
            font-size: TypeScale.caption;
        }
    }
}

// `#library-toolbar`: a `// kicker` on the left, the Recent | A→Z segments on the
// right. The alpha segment flips direction on a second press (like
// `updateLibrarySortControls`).
component LibraryToolbar inherits Rectangle {
    in property <string> mode: "recent";   // "recent" | "alpha"
    in property <string> dir: "asc";       // "asc" | "desc"
    in property <string> kicker: "";
    callback recent-clicked();
    callback alpha-clicked();
    height: 42px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        Text {
            text: root.kicker;
            color: Pal.text3;
            font-size: 11px;
            font-family: Fonts.mono;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        SegTrack {
            width: segs.preferred-width;
            segs := HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                SegBtn {
                    label: "Recent";
                    active: root.mode == "recent";
                    clicked => { root.recent-clicked(); }
                }
                SegBtn {
                    label: root.dir == "asc" ? "A \u{2192} Z" : "Z \u{2192} A";
                    active: root.mode == "alpha";
                    clicked => { root.alpha-clicked(); }
                }
            }
        }
    }
}

component SearchResultRow inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <string> kind;
    in property <string> meta;
    in property <image> art;
    // Only track rows are selectable — the original registers selectable rows for
    // search *tracks* only; playlist/album/artist hits just get a menu.
    in property <bool> selectable: false;
    in property <bool> selected: false;
    callback clicked();
    callback menu(mx: length, my: length);
    callback select-click(ctrl: bool, shift: bool);
    in property <bool> has-selection: false;
    callback clear-sel();
    callback hold-begin();
    callback hold-move(content-y: length);
    callback hold-tick();
    callback hold-end();
    property <bool> is-header: root.kind == "header";
    property <bool> is-top: root.kind == "top";
    property <bool> is-recent: root.kind == "recent";
    // The hit's own kind (a Top result card carries it in `meta`).
    property <string> hit: root.is-top ? root.meta : root.kind;
    height: root.is-header ? 36px : root.is-top ? 96px : root.is-recent ? 36px : 52px;
    Rectangle {
        x: 6px; width: parent.width - 12px;
        border-radius: 10px;
        background: root.selected ? Pal.surface2 : ((ta.has-hover && !root.is-header && !root.is-top) ? Pal.surface : transparent);
        border-width: root.selected ? 1px : 0px;
        border-color: Pal.accent.with-alpha(0.45);
    }
    ta := RowTouch {
        selectable: root.selectable;
        row-y: root.y;
        has-selection: root.has-selection;
        activate => { root.clicked(); }
        clear-sel => { root.clear-sel(); }
        menu-at(mx, my) => { root.menu(mx, my); }
        mod-click(c, s) => { root.select-click(c, s); }
        hold-begin => { root.hold-begin(); }
        hold-move(y) => { root.hold-move(y); }
        hold-tick => { root.hold-tick(); }
        hold-end => { root.hold-end(); }
    }
    // Section title ("Songs", "Artists", …) with its "See all" / "Clear" link.
    if root.is-header : HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: Space.s;
        Text {
            text: root.name;
            color: Pal.text;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.meta;
            color: ta.has-hover ? Pal.text : Pal.text3;
            font-size: 11px;
            font-family: Fonts.mono;
            vertical-alignment: center;
        }
    }

    // Top result: a card with a larger cover (round for an artist).
    if root.is-top : Rectangle {
        x: 8px;
        y: Space.xs;
        width: parent.width - 16px;
        height: parent.height - Space.s;
        border-radius: 14px;
        background: ta.has-hover ? Pal.surface : Pal.card;
        border-width: 1px;
        border-color: Pal.surface2;
        HorizontalLayout {
            padding: Space.m;
            spacing: 14px;
            Rectangle {
                width: 62px; height: 62px;
                border-radius: root.hit == "artist" ? 31px : 8px;
                clip: true;
                background: Pal.surface2;
                if root.art.width > 0 : Image { source: root.art; width: parent.width; height: parent.height; image-fit: cover; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 5px;
                horizontal-stretch: 1;
                Text { text: root.name; color: Pal.text; font-size: 18px; font-weight: 700; overflow: elide; }
                Text {
                    text: (root.hit == "artist" ? "artist" : root.hit == "track" ? "song" : root.hit == "album" ? "album" : "playlist")
                        + (root.sub == "" ? " \u{00B7} top result" : " \u{00B7} " + root.sub);
                    color: Pal.text3; font-size: 11px; font-family: Fonts.mono; overflow: elide;
                }
            }
        }
    }

    // A past query.
    if root.is-recent : HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 15px; height: 15px;
                viewbox-width: 24; viewbox-height: 24;
                fill: transparent; stroke: Pal.text3; stroke-width: 1.8px;
                commands: "M12 4.5a7.5 7.5 0 110 15 7.5 7.5 0 010-15zM12 8v4.2l2.8 1.7";
            }
        }
        Text { text: root.name; color: Pal.text2; font-size: TypeScale.small; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }

    // A hit: 40px cover (round for artists) + name/sub (+ duration for songs).
    if !root.is-header && !root.is-top && !root.is-recent : HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px; height: 40px;
                border-radius: root.kind == "artist" ? 20px : 8px;
                clip: true;
                background: Pal.surface2;
                if root.art.width > 0 : Image { source: root.art; width: parent.width; height: parent.height; image-fit: cover; }
                if root.art.width == 0 : Path {
                    width: 16px; height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 24; viewbox-height: 24;
                    fill: Pal.faint;
                    commands: root.kind == "track" ? "M12 3v10.55A4 4 0 1014 17V7h4V3h-6z"
                        : root.kind == "playlist" ? "M3 6h13v2H3V6zm0 5h13v2H3v-2zm0 5h9v2H3v-2z"
                        : root.kind == "album" ? "M12 3a9 9 0 100 18 9 9 0 000-18zm0 12a3 3 0 110-6 3 3 0 010 6z"
                        : "M12 12a4 4 0 100-8 4 4 0 000 8zm0 2c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z";
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.name; color: Pal.text; font-size: 13px; font-weight: 500; overflow: elide; }
            Text { text: root.sub; color: Pal.text3; font-size: TypeScale.small; overflow: elide; }
        }
        if root.kind == "track" && root.meta != "" : Text {
            text: root.meta;
            color: Pal.text3;
            font-size: 11px;
            font-family: Fonts.mono;
            vertical-alignment: center;
        }
    }
}

// Beatport chart-mode icon button (TOP 100 / HYPE / RELEASES) — the original renders
// these as icon-only buttons (custom art in `ui-icons/beatport-{tracks,hype,releases}.png`,
// no visible label, just a `title` tooltip), not text chips (`.bp-mode-btn img`: 18px,
// opacity 0.72 → 1 on active/hover; `.bp-mode-btn.active`: a soft accent wash + a 2px
// accent line on the bottom edge, ported here as a Rectangle since Slint has no
// `box-shadow: inset`). Ported as real image assets, not redrawn paths, since these are
// hand-designed art (see `icon_factory.py`), not simple glyphs.
component BpModeIconBtn inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    callback clicked <=> ta.clicked;
    height: 26px;
    border-radius: 8px;
    background: root.active ? Pal.accent.with-alpha(0.12) : (ta.has-hover ? #ffffff08 : transparent);
    ta := TouchArea { }
    Image {
        source: root.icon;
        width: 18px; height: 18px;
        opacity: (root.active || ta.has-hover) ? 1.0 : 0.72;
    }
    if root.active : Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Pal.accent;
    }
}

// A Beatport chart row: "N. Title" over "artists • label".
component BpRow inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <bool> selectable: true;
    in property <bool> selected: false;
    callback clicked();
    callback menu(mx: length, my: length);
    callback select-click(ctrl: bool, shift: bool);
    in property <bool> has-selection: false;
    callback clear-sel();
    callback hold-begin();
    callback hold-move(content-y: length);
    callback hold-tick();
    callback hold-end();
    height: 46px;
    Rectangle {
        x: 6px; width: parent.width - 12px;
        border-radius: 10px;
        background: root.selected ? Pal.surface2 : (ta.has-hover ? Pal.surface : transparent);
        border-width: root.selected ? 1px : 0px;
        border-color: Pal.accent.with-alpha(0.45);
    }
    ta := RowTouch {
        selectable: root.selectable;
        row-y: root.y;
        has-selection: root.has-selection;
        activate => { root.clicked(); }
        clear-sel => { root.clear-sel(); }
        menu-at(mx, my) => { root.menu(mx, my); }
        mod-click(c, s) => { root.select-click(c, s); }
        hold-begin => { root.hold-begin(); }
        hold-move(y) => { root.hold-move(y); }
        hold-tick => { root.hold-tick(); }
        hold-end => { root.hold-end(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text { text: root.title; color: Pal.text; font-size: 13px; font-weight: 500; overflow: elide; }
            Text { text: root.sub; color: Pal.text3; font-size: 11px; font-family: Fonts.mono; overflow: elide; }
        }
        if root.selected : VerticalLayout {
            alignment: center;
            Path {
                width: 15px; height: 15px;
                viewbox-width: 24; viewbox-height: 24;
                fill: transparent; stroke: Pal.text; stroke-width: 2px;
                stroke-line-cap: round; stroke-line-join: round;
                commands: Icons.check;
            }
        }
    }
}

// One segment: just a label and a hit target. No border of its own - the track and
// the sliding pill carry all the chrome.
// One search filter chip, sized to its label.
component FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked <=> ta.clicked;
    // `.chip`: ghost pill; selected = the inverted white pill.
    height: 26px;
    width: t.preferred-width + 16px;
    border-radius: 13px;
    background: root.active ? Pal.text : (ta.has-hover ? Pal.surface : transparent);
    border-width: 1px;
    border-color: root.active ? Pal.text : (ta.has-hover ? Pal.border-strong : Pal.border-hi);
    animate background { duration: 150ms; }
    ta := TouchArea { }
    t := Text {
        text: root.label;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        color: root.active ? Pal.ink : (ta.has-hover ? Pal.text : Pal.text2);
        font-size: TypeScale.small;
        font-weight: 500;
    }
}

// Search result filters: All · Songs · Artists · Albums · Playlists (Spotify's order).
// Label-sized chips — the old five equal segments couldn't hold "PLAYLISTS" in a
// 264px panel and clipped "ALBUMS" off the end.
component FilterBar inherits Rectangle {
    // 0 all · 1 songs · 2 artists · 3 albums · 4 playlists
    in property <int> active;
    callback pick(int);
    height: 26px;
    HorizontalLayout {
        spacing: 3px;
        alignment: start;
        FilterChip { label: "All";       active: root.active == 0; clicked => { root.pick(0); } }
        FilterChip { label: "Songs";     active: root.active == 1; clicked => { root.pick(1); } }
        FilterChip { label: "Artists";   active: root.active == 2; clicked => { root.pick(2); } }
        FilterChip { label: "Albums";    active: root.active == 3; clicked => { root.pick(3); } }
        FilterChip { label: "Playlists"; active: root.active == 4; clicked => { root.pick(4); } }
    }
}

// One button of the titlebar mini-player snap control (#mini-modes): a mode glyph
// in a small hover/active target. square = portrait outline · bar = wide outline ·
// nano = filled square (mirrors the shipped SVG glyphs).
component MiniSnapBtn inherits Rectangle {
    in property <string> kind;      // square | bar | nano
    in property <bool> active;
    callback clicked <=> ta.clicked;
    width: 26px; height: 22px; border-radius: 11px;
    background: root.active ? Pal.surface2 : transparent;
    ta := TouchArea { }
    property <color> tint: root.active || ta.has-hover ? Pal.text : Pal.text3;
    if root.kind == "square" : Rectangle {
        width: 8px; height: 11px; border-radius: 1.5px;
        border-width: 1.4px; border-color: root.tint; background: transparent;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
    if root.kind == "bar" : Rectangle {
        width: 12px; height: 5px; border-radius: 1.5px;
        border-width: 1.4px; border-color: root.tint; background: transparent;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
    if root.kind == "nano" : Rectangle {
        width: 9px; height: 9px; border-radius: 1.5px;
        background: root.tint;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

// The reduced mini transport (prev / play-pause / next only — shuffle & repeat are
// hidden in mini, per the shipped layout). Sizes scale per mode.
component MiniTransport inherits HorizontalLayout {
    in property <bool> playing;
    in property <length> play-size: 44px;
    in property <length> nav-icon: 20px;
    in property <length> gap: 8px;
    callback prev();
    callback toggle();
    callback next();
    alignment: center;
    spacing: root.gap;
    VerticalLayout { alignment: center; IconBtn { cmds: Icons.prev; stroked: true; fill-too: true; tint: Pal.text; icon: root.nav-icon; clicked => { root.prev(); } } }
    Rectangle {
        width: root.play-size; height: root.play-size; border-radius: self.width / 2;
        // Hover-brighten off the live accent so it still reads right once the accent
        // itself has shifted to the cover's colour.
        background: pta.has-hover ? Pal.accent.brighter(0.2) : Pal.accent;
        pta := TouchArea { clicked => { root.toggle(); } }
        Path {
            width: root.play-size * 0.46; height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 24; viewbox-height: 24;
            fill: Pal.ink;
            commands: root.playing ? Icons.pause : Icons.play;
        }
    }
    VerticalLayout { alignment: center; IconBtn { cmds: Icons.next; stroked: true; fill-too: true; tint: Pal.text; icon: root.nav-icon; clicked => { root.next(); } } }
}

// The inline mini progress bar (bar mode): click / drag to seek, mirrors the full
// #progress-bar but compact. Self-contained scrub state.
component MiniSeekBar inherits Rectangle {
    in property <float> progress;
    callback seek(float);
    property <float> scrub;
    property <bool> scrubbing;
    property <float> shown: root.scrubbing ? root.scrub : root.progress;
    height: 14px;
    ta := TouchArea {
        moved => {
            if (self.pressed) {
                root.scrub = clamp(self.mouse-x / root.width, 0.0, 1.0);
                root.scrubbing = true;
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.scrub = clamp(self.mouse-x / root.width, 0.0, 1.0);
                root.scrubbing = true;
            }
            if (ev.kind == PointerEventKind.up) {
                root.seek(root.scrub);
                root.scrubbing = false;
            }
        }
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width; height: 3px; border-radius: 2px; background: Pal.border-hi;
        Rectangle { x: 0; height: parent.height; width: parent.width * root.shown; border-radius: 2px; background: Pal.accent; }
    }
}

// ── Settings / sign-in parts ────────────────────────────────────────────────

// `.card`: a raised block on the settings panel; children stack with 10px gaps.
component Card inherits Rectangle {
    background: Pal.panel;
    border-radius: 14px;
    border-width: 1px;
    border-color: Pal.border;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 10px;
        @children
    }
}

// A `// lowercase` mono kicker label.
component Kicker inherits Text {
    color: Pal.text3;
    font-size: 11px;
    font-family: Fonts.mono;
    vertical-alignment: center;
    horizontal-stretch: 1;
    overflow: elide;
}

// `.btn` ghost pill (secondary actions). `enabled: false` dims it and ignores clicks.
component PillBtn inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <length> h: 28px;
    callback clicked();
    height: root.h;
    width: t.preferred-width + 26px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: root.enabled && ta.has-hover ? Pal.border-strong : (root.enabled ? Pal.border-hi : Pal.surface2);
    background: root.enabled && ta.has-hover ? Pal.surface : transparent;
    animate background { duration: 150ms; }
    ta := TouchArea { clicked => { if (root.enabled) { root.clicked(); } } }
    t := Text {
        text: root.label;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        color: root.enabled ? Pal.text : Pal.faint;
        font-size: TypeScale.small;
        font-weight: 500;
    }
}

// 7px status dot: accent when on, faint grey when off.
component StatusDot inherits VerticalLayout {
    in property <bool> on;
    alignment: center;
    Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: root.on ? Pal.accent : Pal.faint; }
}

// On/off switch (`.sw`): white track with an ink knob when on.
component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Pal.text : Pal.border-hi;
    animate background { duration: 200ms; }
    TouchArea { clicked => { root.toggled(); } }
    Rectangle {
        y: 3px;
        x: root.on ? 17px : 3px;
        animate x { duration: 200ms; easing: cubic-bezier(0.22, 0.85, 0.28, 1); }
        width: 14px; height: 14px; border-radius: 7px;
        background: root.on ? Pal.ink : Pal.text2;
    }
}

// A numbered step circle on the sign-in card.
component StepNum inherits VerticalLayout {
    in property <string> n;
    alignment: start;
    Rectangle {
        width: 24px; height: 24px; border-radius: 12px;
        border-width: 1px; border-color: Pal.border-hi;
        Text { text: root.n; color: Pal.text2; font-size: 11px; font-family: Fonts.mono;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    }
}

// A mono code line in a box, with an optional action pill (`.code` + `.cp`).
component CodeBox inherits Rectangle {
    in property <string> text;
    in property <string> action;
    callback clicked();
    height: 38px;
    border-radius: 10px;
    background: Pal.panel;
    border-width: 1px;
    border-color: Pal.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;
        Text { text: root.text; color: Pal.text; font-size: 12.5px; font-family: Fonts.mono; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if root.action != "" : VerticalLayout {
            alignment: center;
            Rectangle {
                width: at.preferred-width + 20px; height: 26px; border-radius: 13px;
                border-width: 1px;
                border-color: ata.has-hover ? Pal.border-strong : Pal.border-hi;
                ata := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
                at := Text { text: root.action; color: ata.has-hover ? Pal.text : Pal.text2; font-size: 11px; font-family: Fonts.mono;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
        }
    }
}

// ── Local library mode (v8) ──────────────────────────────────────────────────

// One row of the library tree. kind: 0 section header (Artists, Albums…), 1 item
// under an open section, 2 the "New playlist" row.
struct LocalNode { label: string, count: string, kind: int, open: bool, selected: bool, droppable: bool }
// One row of the track list. `num` is the position (or ▶ while playing).
struct LocalRow { num: string, title: string, artist: string, album: string, time: string, playing: bool, selected: bool }
// A folder "Find music on this PC" suggests.
struct LocalCand { name: string, path: string, count: string, on: bool, added: bool }
// A file-type chip in the Local filters (MP3, FLAC, …): shown when `on`.
struct LocalFlag { label: string, on: bool }

// The footer toggle (right of the settings cog): grey when off, lit when on.
component LocalToggle inherits Rectangle {
    in property <bool> on;
    callback clicked <=> ta.clicked;
    height: 28px;
    width: lbl.preferred-width + 34px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.on ? #3a3a3a : (ta.has-hover ? Pal.border-hi : Pal.border);
    background: ta.has-hover ? Pal.surface : (root.on ? Pal.card : transparent);
    animate background, border-color { duration: 200ms; }
    ta := TouchArea { mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 12px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px; height: 6px; border-radius: 3px;
                background: root.on ? Pal.accent : #3a3a3a;
                animate background { duration: 200ms; }
            }
        }
        lbl := Text {
            text: "Local";
            vertical-alignment: center;
            font-size: 12.5px;
            font-weight: 500;
            color: root.on ? Pal.text : (ta.has-hover ? Pal.text2 : Pal.faint);
            animate color { duration: 200ms; }
        }
    }
}

component LocalTreeRow inherits Rectangle {
    in property <LocalNode> node;
    // Something is being dragged and the pointer is over this row (a playlist).
    in property <bool> drop-hot;
    callback clicked();
    // Where the row is in the window. Read from a child: inside a scrolled ListView the
    // repeated row's own `absolute-position` leaves out the scroll offset.
    out property <length> win-x: ta.absolute-position.x;
    out property <length> win-y: ta.absolute-position.y;
    callback menu(mx: length, my: length);
    // kind: 0 a section head (chevron), 1 an item, 2 "+ New playlist", 3 a head that
    // is itself a view (All music, Recently added: no chevron, label aligned with heads).
    property <bool> head: root.node.kind == 0 || root.node.kind == 3;
    height: root.head ? 32px : 28px;
    Rectangle {
        x: 6px; width: parent.width - 12px;
        border-radius: 9px;
        background: root.drop-hot ? Pal.accent.with-alpha(0.16)
            : root.node.selected ? Pal.surface2 : (ta.has-hover ? Pal.surface : transparent);
        border-width: root.drop-hot ? 1px : 0px;
        border-color: Pal.accent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: root.node.kind == 0 ? 20px : root.node.kind == 3 ? 39px : (root.node.kind == 2 ? 42px : 44px);
        padding-right: 18px;
        spacing: 8px;
        if root.node.kind == 0 : VerticalLayout {
            alignment: center;
            Path {
                width: 11px; height: 11px;
                viewbox-width: 24; viewbox-height: 24;
                fill: transparent; stroke: Pal.faint; stroke-width: 2px; stroke-line-cap: round;
                commands: root.node.open ? "M6 9l6 6 6-6" : "M9 6l6 6-6 6";
            }
        }
        if root.node.kind == 2 : VerticalLayout {
            alignment: center;
            Path {
                width: 11px; height: 11px;
                viewbox-width: 24; viewbox-height: 24;
                fill: transparent; stroke: Pal.text3; stroke-width: 2px; stroke-line-cap: round;
                commands: "M12 5v14M5 12h14";
            }
        }
        Text {
            text: root.node.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: root.head ? 13px : 12.5px;
            color: root.drop-hot || root.node.selected ? Pal.text : (root.node.kind == 2 ? Pal.text3 : (ta.has-hover ? Pal.text : Pal.text2));
        }
        Text {
            text: root.node.count;
            vertical-alignment: center;
            font-size: 10.5px;
            font-family: Fonts.mono;
            color: Pal.faint;
        }
    }
}

// A track row: # · Title · Artist · Album · Time. Click plays; Ctrl/Shift-click
// select; press a SELECTED row and move to carry the selection (onto a playlist).
component LocalTrackRow inherits Rectangle {
    in property <LocalRow> t;
    in property <bool> has-selection;
    callback activate();
    callback select(ctrl: bool, shift: bool);
    callback clear-sel();
    callback menu(mx: length, my: length);
    // Press and hold (300 ms, as in every list — `RowTouch`) → drag-select from this
    // row; `hold-move` gets the pointer's y in the list's content.
    callback hold-begin();
    callback hold-move(content-y: length);
    callback hold-tick();
    callback hold-end();
    // Press a SELECTED row and move before the hold time → carry the selection (onto
    // a playlist in the tree).
    callback carry-begin();
    callback carry-move(x: length, y: length);
    callback carry-end();
    height: 36px;
    property <bool> armed: false;
    property <bool> dragging: false;
    property <bool> carrying: false;
    property <bool> skip: false;
    property <length> px;
    property <length> py;
    Rectangle {
        x: 6px; width: parent.width - 12px;
        border-radius: 9px;
        opacity: root.carrying ? 0.45 : 1;
        background: root.t.selected ? Pal.surface2 : (ta.has-hover ? Pal.surface : transparent);
        border-width: root.t.selected ? 1px : 0px;
        border-color: Pal.accent.with-alpha(0.4);
    }
    Timer {
        interval: 30ms;
        running: root.dragging;
        triggered => { root.hold-tick(); }
    }
    Timer {
        interval: 300ms;
        running: root.armed;
        triggered => {
            root.armed = false;
            root.dragging = true;
            root.skip = true;
            root.hold-begin();
            // As `RowTouch`: the edge auto-scroll must not act on a stale position.
            root.hold-move(root.y + ta.mouse-y);
        }
    }
    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                if (e.button == PointerEventButton.right) {
                    root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                } else if (e.button == PointerEventButton.left) {
                    root.skip = false;
                    if (e.modifiers.control || e.modifiers.shift) {
                        root.skip = true;
                        root.select(e.modifiers.control, e.modifiers.shift);
                    } else {
                        root.armed = true;
                        root.px = self.mouse-x;
                        root.py = self.mouse-y;
                    }
                }
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                root.armed = false;
                if (root.dragging) {
                    root.dragging = false;
                    root.hold-end();
                }
                if (root.carrying) {
                    root.carrying = false;
                    root.skip = true;
                    root.carry-end();
                }
            }
        }
        moved => {
            if (root.armed && (abs(self.mouse-x - root.px) > 8px || abs(self.mouse-y - root.py) > 8px)) {
                // Moved before the hold: a carry from a selected row, else just a click.
                root.armed = false;
                if (root.t.selected) {
                    root.carrying = true;
                    root.carry-begin();
                }
            }
            if (root.dragging) {
                root.hold-move(root.y + self.mouse-y);
            }
            if (root.carrying) {
                root.carry-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            if (root.skip) {
                root.skip = false;
            } else if (root.has-selection) {
                root.clear-sel();
            } else {
                root.activate();
            }
        }
    }
    // Title / Artist / Album split what # and Time leave 4:3:3, the same as the column
    // heads. Zero preferred widths: a plain stretch would add each row's own text
    // width first, and the columns would wander row to row.
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 12px;
        Text {
            width: 24px;
            text: root.t.num;
            vertical-alignment: center;
            font-size: 11px;
            font-family: Fonts.mono;
            color: root.t.playing ? Pal.accent : Pal.faint;
        }
        Text {
            horizontal-stretch: 4; preferred-width: 0px; min-width: 0px;
            text: root.t.title;
            vertical-alignment: center;
            overflow: elide;
            font-size: 13px;
            font-weight: root.t.playing ? 600 : 500;
            color: root.t.playing ? Pal.accent : Pal.text;
        }
        Text { horizontal-stretch: 3; preferred-width: 0px; min-width: 0px; text: root.t.artist; vertical-alignment: center; overflow: elide; font-size: 13px; color: Pal.text2; }
        Text { horizontal-stretch: 3; preferred-width: 0px; min-width: 0px; text: root.t.album; vertical-alignment: center; overflow: elide; font-size: 13px; color: Pal.text3; }
        Text { width: 40px; text: root.t.time; vertical-alignment: center; horizontal-alignment: right; font-size: 11px; font-family: Fonts.mono; color: Pal.text3; }
    }
}

// A sortable column header.
component LocalColHead inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> desc;
    in property <bool> right: false;
    callback clicked <=> ta.clicked;
    ta := TouchArea { mouse-cursor: pointer; }
    HorizontalLayout {
        alignment: root.right ? end : start;
        spacing: 4px;
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 10.5px;
            font-family: Fonts.mono;
            letter-spacing: 0.3px;
            color: root.active ? Pal.text2 : (ta.has-hover ? Pal.text3 : Pal.faint);
        }
        if root.active : Text {
            text: root.desc ? "\u{2193}" : "\u{2191}";
            vertical-alignment: center;
            font-size: 10.5px;
            color: Pal.text3;
        }
    }
}

// A thin scrub bar (seek / volume): click or drag anywhere on it.
component LocalScrub inherits Rectangle {
    in property <float> value;
    in property <color> fill: Pal.text;
    in property <bool> knob: false;
    // The bar's thickness; `hover-knob` shows the knob only under the pointer.
    in property <length> line: 4px;
    in property <bool> hover-knob: false;
    callback scrubbed(v: float);
    height: 16px;
    property <float> shown: ta.pressed ? clamp(ta.mouse-x / self.width, 0, 1) : root.value;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.line; border-radius: root.line / 2; background: Pal.border-hi;
        Rectangle { x: 0; width: parent.width * root.shown; border-radius: root.line / 2; background: root.fill; }
    }
    if root.knob || (root.hover-knob && (ta.has-hover || ta.pressed)) : Rectangle {
        width: 12px; height: 12px; border-radius: 6px; background: Pal.text;
        x: parent.width * root.shown - 6px;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                root.scrubbed(clamp(self.mouse-x / root.width, 0, 1));
            }
        }
    }
}

// A small toggle chip (Local filters).
component LocalChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked <=> cta.clicked;
    height: 24px;
    width: ct.preferred-width + 18px;
    border-radius: 12px;
    background: root.on ? Pal.accent.with-alpha(0.16) : (cta.has-hover ? Pal.surface : transparent);
    border-width: 1px;
    border-color: root.on ? Pal.accent.with-alpha(0.6) : Pal.border;
    cta := TouchArea { mouse-cursor: pointer; }
    // Centred: a chip may be given a width (the filter panel's type grid).
    ct := Text {
        text: root.label;
        width: self.preferred-width;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        font-size: 10.5px; font-family: Fonts.mono;
        color: root.on ? Pal.text : Pal.text3;
    }
}

// A typed length limit in the Local filters ("Shortest" / "Longest"): commits on
// Enter or when it loses focus; red when the host could not read it.
component LocalLenField inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <bool> invalid;
    callback commit(string);
    height: 34px;
    border-radius: 9px;
    background: Pal.bg;
    border-width: 1px;
    border-color: root.invalid ? #e5484d : (inp.has-focus ? Pal.accent.with-alpha(0.6) : Pal.border);
    // A click anywhere on the field (its label too) puts the cursor in it.
    TouchArea { mouse-cursor: MouseCursor.text; clicked => { inp.focus(); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 6px;
        Text { text: root.label; vertical-alignment: center; font-size: 11px; color: Pal.text3; }
        Rectangle {
            horizontal-stretch: 1;
            inp := TextInput {
                text <=> root.text;
                vertical-alignment: center;
                horizontal-alignment: right;
                color: Pal.text; font-size: 12px; font-family: Fonts.mono; single-line: true;
                accepted => { self.clear-focus(); }
                changed has-focus => { if (!self.has-focus) { root.commit(self.text); } }
            }
            if inp.text == "" && !inp.has-focus : Text {
                width: 100%;
                text: "any";
                vertical-alignment: center; horizontal-alignment: right;
                font-size: 12px; font-family: Fonts.mono; color: Pal.faint;
            }
        }
    }
}

// A neon word: the text over a soft glow of itself. The software renderer has no
// text shadow, so the glow is the same text repeated faintly at small offsets around
// it — two rings, `strength` 0 (none) to ~1.6 (hover).
component NeonText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 22px;
    in property <string> font-family: "Yellowtail";
    in property <color> ink;
    in property <color> glow;
    in property <float> strength: 1;
    width: main.preferred-width;
    height: main.preferred-height;
    if root.strength > 0.01 : Rectangle {
        for o in [{x: 1, y: 0}, {x: 0.71, y: 0.71}, {x: 0, y: 1}, {x: -0.71, y: 0.71},
                  {x: -1, y: 0}, {x: -0.71, y: -0.71}, {x: 0, y: -1}, {x: 0.71, y: -0.71}] : Text {
            x: o.x * 2.6px; y: o.y * 2.6px;
            text: root.text; font-size: root.font-size; font-family: root.font-family;
            color: root.glow.with-alpha(min(1, 0.11 * root.strength));
        }
        for o in [{x: 1, y: 0}, {x: 0.71, y: 0.71}, {x: 0, y: 1}, {x: -0.71, y: 0.71},
                  {x: -1, y: 0}, {x: -0.71, y: -0.71}, {x: 0, y: -1}, {x: 0.71, y: -0.71}] : Text {
            x: o.x * 1.2px; y: o.y * 1.2px;
            text: root.text; font-size: root.font-size; font-family: root.font-family;
            color: root.glow.with-alpha(min(1, 0.3 * root.strength));
        }
    }
    main := Text {
        x: 0; y: 0;
        text: root.text; font-size: root.font-size; font-family: root.font-family;
        color: root.ink;
    }
}

// The Local view's ASCII lava backdrop: the host draws `frame` at the size reported.
component LocalBackdrop inherits Rectangle {
    in property <image> frame;
    callback sized(length, length);
    clip: true;
    init => { root.sized(self.width, self.height); }
    changed width => { root.sized(self.width, self.height); }
    changed height => { root.sized(self.width, self.height); }
    Image { source: root.frame; width: parent.width; height: parent.height; image-fit: fill; }
}

// Local now playing, in the main area (opened from the player strip): the cover with
// its colour glow, title, seek, transport and volume — the main player's layout.
component LocalNowView inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <image> art-img;
    in property <color> glow;
    in property <string> elapsed;
    in property <string> duration;
    in property <float> progress;
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> volume;
    in property <bool> glow-baked;
    // The glow's centre and diameter in this view, for the backdrop to draw it.
    callback glow-geom(length, length, length);
    // Right-click on the backdrop (window coordinates): the screensaver menu.
    callback bg-menu(length, length);
    callback close();
    callback toggle-play();
    callback prev();
    callback next();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    // The cover follows the view's size. Set from change handlers, not a binding: the
    // cover is part of the view's own size request (as `npane.art-size`).
    property <length> art-size: 236px;
    property <length> seek-w: 300px;
    function fit-art() {
        self.art-size = clamp(min(self.width * 0.46, self.height - 280px), 120px, 440px);
        self.seek-w = clamp(self.width - 160px, 120px, 420px);
    }
    init => { self.fit-art(); }
    changed width => { self.fit-art(); }
    changed height => { self.fit-art(); }
    bgta := TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.bg-menu(bgta.absolute-position.x + bgta.mouse-x, bgta.absolute-position.y + bgta.mouse-y);
            }
        }
    }
    // The colour glow, centred on the cover. While the ASCII backdrop runs, the host
    // draws this same glow into its frames (`glow-baked`) — re-evaluating the gradient
    // under every backdrop frame is the costliest part of a repaint here.
    Rectangle {
        width: root.art-size * 2.63;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: cov.absolute-position.y - root.absolute-position.y + (cov.height - self.height) / 2 + 12px;
        visible: !root.glow-baked;
        background: @radial-gradient(circle, root.glow 0%, transparent 60%);
        init => { root.glow-geom(self.x + self.width / 2, self.y + self.height / 2, self.width); }
        changed x => { root.glow-geom(self.x + self.width / 2, self.y + self.height / 2, self.width); }
        changed y => { root.glow-geom(self.x + self.width / 2, self.y + self.height / 2, self.width); }
        changed width => { root.glow-geom(self.x + self.width / 2, self.y + self.height / 2, self.width); }
    }
    VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            cov := Rectangle {
                width: root.art-size; height: root.art-size;
                border-radius: 14px;
                clip: true;
                border-width: 1px;
                border-color: #ffffff10;
                background: @linear-gradient(145deg, #2b3a44 0%, #17242b 55%, #101a1f 100%);
                Image { source: root.art-img; width: 100%; height: 100%; image-fit: cover; }
                TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
            }
        }
        VerticalLayout {
            spacing: 4px;
            Text { text: root.title; horizontal-alignment: center; font-size: 22px; font-weight: 700; color: Pal.text; overflow: elide; }
            Text {
                text: root.album == "" ? root.artist : root.artist + " \u{00b7} " + root.album;
                horizontal-alignment: center; font-size: 13px; color: Pal.text3; overflow: elide;
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            Text { width: 40px; text: root.elapsed; vertical-alignment: center; horizontal-alignment: right; font-size: 11px; font-family: Fonts.mono; color: Pal.text3; }
            VerticalLayout {
                alignment: center;
                LocalScrub { width: root.seek-w; value: root.progress; fill: Pal.accent; knob: true; scrubbed(v) => { root.seek(v); } }
            }
            Text { width: 40px; text: root.duration; vertical-alignment: center; font-size: 11px; font-family: Fonts.mono; color: Pal.text3; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 16px;
            VerticalLayout { alignment: center; IconBtn { cmds: Icons.shuffle; stroked: true; icon: 18px; box: 36px; is-active: root.shuffle; clicked => { root.toggle-shuffle(); } } }
            VerticalLayout { alignment: center; IconBtn { cmds: Icons.prev; stroked: true; fill-too: true; tint: Pal.text; icon: 20px; box: 38px; clicked => { root.prev(); } } }
            Rectangle {
                width: 54px; height: 54px; border-radius: 27px;
                background: bplta.has-hover ? Pal.accent.brighter(0.2) : Pal.accent;
                bplta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-play(); } }
                Path {
                    width: 20px; height: 20px;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    viewbox-width: 24; viewbox-height: 24;
                    fill: Pal.ink;
                    commands: root.playing ? Icons.pause : Icons.play;
                }
            }
            VerticalLayout { alignment: center; IconBtn { cmds: Icons.next; stroked: true; fill-too: true; tint: Pal.text; icon: 20px; box: 38px; clicked => { root.next(); } } }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px; height: 36px;
                    IconBtn { cmds: Icons.repeat; stroked: true; icon: 18px; box: 36px; is-active: root.repeat != 0; clicked => { root.cycle-repeat(); } }
                    if root.repeat == 2 : Text { text: "1"; x: 25px; y: 4px; font-size: 9px; font-family: Fonts.mono; color: Pal.text; }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Path { width: 16px; height: 16px; viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke: Pal.text3; stroke-width: 1.6px; stroke-line-cap: round; stroke-line-join: round; commands: Icons.volume; }
            }
            VerticalLayout { alignment: center; LocalScrub { width: 130px; value: root.volume; scrubbed(v) => { root.set-volume(v); } } }
        }
    }
    // Back to the track list: a dark round chevron.
    Rectangle {
        x: 14px; y: 12px;
        width: 32px; height: 32px;
        border-radius: 16px;
        background: bta.has-hover ? Pal.surface : Pal.card;
        border-width: 1px;
        border-color: Pal.border;
        bta := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
        Path {
            x: 9px; y: 9px; width: 14px; height: 14px;
            viewbox-width: 24; viewbox-height: 24;
            commands: "M15 5l-7 7 7 7";
            fill: transparent;
            stroke: bta.has-hover ? Pal.text : Pal.text2;
            stroke-width: 2.2px; stroke-line-cap: round; stroke-line-join: round;
        }
    }
}

component LocalView inherits Rectangle {
    in property <[LocalNode]> nodes;
    in property <[LocalRow]> rows;
    in property <string> kicker;
    in property <string> title;
    in property <string> stats;
    in property <string> empty;
    in property <int> sort-col;
    in property <bool> sort-desc;
    in property <bool> has-selection;
    // now playing (local)
    in property <bool> now-has;
    in property <string> now-title;
    in property <string> now-artist;
    in property <image> now-cover;
    in property <string> now-elapsed;
    in property <string> now-duration;
    in property <float> now-progress;
    in property <bool> now-playing;
    in property <float> volume;
    in property <bool> shuffle;
    in property <int> repeat;   // 0 off, 1 all, 2 one
    // The ASCII lava backdrop (drawn by the host at this panel's size).
    in property <image> bg;
    in-out property <length> bg-w;
    in-out property <length> bg-h;
    // The window's width: the strip centres its transport on the window.
    in property <length> win-w;
    // The now-playing glow, drawn by the backdrop while it runs.
    in-out property <length> glow-x;
    in-out property <length> glow-y;
    in-out property <length> glow-d;
    in property <bool> glow-baked;
    // Explorer drag-over
    in property <bool> drop-active;
    in property <string> drop-detail;
    // carrying tracks onto a playlist
    in property <bool> carry-active;
    in property <string> carry-label;
    in property <length> carry-x;
    in property <length> carry-y;
    in-out property <int> drop-target: -1;

    callback node-click(int);
    callback node-menu(int, length, length);
    callback row-activate(int);
    callback row-select(int, bool, bool);
    callback row-clear-sel();
    callback row-menu(int, length, length);
    callback bg-menu(length, length);
    callback sort(int);
    callback find();
    callback rescan();
    callback filter-edited(string);
    callback toggle-play();
    callback prev();
    callback next();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback carry-begin(int);
    callback carry-move(length, length);
    callback carry-end();
    // Hold-to-select drag in the track list (rows, in display order).
    callback drag-begin(int);
    callback drag-to(int);
    callback drag-end();
    // The now-playing view in the main area (from the player strip).
    in-out property <bool> now-open: false;
    in property <string> now-album;
    in property <color> now-glow;
    // Library filters (the funnel in the tree header).
    in-out property <bool> filters-open: false;
    in property <int> flt-mode;          // 0 all, 1 music only, 2 long sets
    in-out property <string> flt-min-text; // typed length limits ("0:30"; "" = any)
    in-out property <string> flt-max-text;
    in property <bool> flt-min-bad;
    in property <bool> flt-max-bad;
    in property <[LocalFlag]> flt-types;
    in property <string> flt-note;       // "12 of 62 hidden"
    in property <bool> flt-active;
    in property <bool> flt-custom;       // anything differs from the defaults
    callback flt-set-mode(int);
    callback flt-set-len(bool, string);  // (the "longest" field?, its text)
    callback flt-reset();
    callback flt-toggle-type(int);
    // The tree collapses with the titlebar wordmark — the same flag as the Spotify
    // view's left panel, so the two views agree.
    in-out property <bool> collapsed;
    // Carrying tracks needs the playlists: a closed tree opens for the carry and
    // closes again after it.
    property <bool> carry-opened: false;
    changed carry-active => {
        if (root.carry-active && root.collapsed) {
            root.carry-opened = true;
            root.collapsed = false;
        } else if (!root.carry-active && root.carry-opened) {
            root.carry-opened = false;
            root.collapsed = true;
        }
    }
    // A hidden filter field must not keep taking keys.
    changed collapsed => {
        if (root.collapsed && fin.has-focus) { fin.clear-focus(); }
    }

    background: Pal.bg;
    HorizontalLayout {
        // ── the library tree ──
        Rectangle {
            width: root.collapsed ? 0px : 288px;
            background: Pal.panel;
            clip: true;
            // Slides like the Spotify view's left panel.
            animate width { duration: Motion.slide; easing: cubic-bezier(0.22, 0.85, 0.28, 1); }
            VerticalLayout {
                // Pinned to the full width and the RIGHT edge, so while the panel
                // narrows its content slides out to the left instead of squashing.
                width: 288px;
                x: parent.width - 288px;
                HorizontalLayout {
                    height: 44px;
                    padding-left: 18px;
                    padding-right: 8px;
                    spacing: 4px;
                    Text { text: root.kicker; vertical-alignment: center; horizontal-stretch: 1; font-size: 11px; font-family: Fonts.mono; color: Pal.text3; overflow: elide; }
                    // Filters: the dot shows while they hide anything.
                    VerticalLayout { alignment: center; IconBtn { cmds: "M4 5h16l-6.2 7.6V18l-3.6 1.8v-7.2z"; stroked: true; icon: 15px; box: 32px; is-active: root.flt-active || root.filters-open; show-dot: root.flt-active; clicked => { root.filters-open = !root.filters-open; } } }
                    VerticalLayout { alignment: center; IconBtn { cmds: "M12 5v14M5 12h14"; stroked: true; icon: 16px; box: 32px; show-dot: false; clicked => { root.find(); } } }
                    VerticalLayout { alignment: center; IconBtn { cmds: "M19.5 12a7.5 7.5 0 1 1-2.2-5.3M19.5 4.5v4h-4"; stroked: true; icon: 16px; box: 32px; show-dot: false; clicked => { root.rescan(); } } }
                }
                Rectangle {
                    height: 44px;
                    Rectangle {
                        x: 12px; y: 4px;
                        width: parent.width - 24px; height: 32px;
                        border-radius: 9px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: fin.has-focus ? Pal.border-strong : Pal.border;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Path { width: 13px; height: 13px; viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke: Pal.faint; stroke-width: 1.6px; stroke-line-cap: round; commands: Icons.search; }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                fin := TextInput {
                                    vertical-alignment: center;
                                    color: Pal.text; font-size: 12.5px; single-line: true;
                                    edited => { root.filter-edited(self.text); }
                                }
                                if fin.text == "" : Text { text: "Filter the library"; vertical-alignment: center; color: Pal.faint; font-size: 12.5px; }
                            }
                        }
                    }
                }
                if root.filters-open : VerticalLayout {
                    vertical-stretch: 0;
                    padding-left: 12px; padding-right: 12px; padding-top: 2px; padding-bottom: 12px;
                    Rectangle {
                        background: Pal.card;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Pal.border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Filters"; vertical-alignment: center; horizontal-stretch: 1; font-size: 13px; font-weight: 600; color: Pal.text; }
                                Text { text: root.flt-note; vertical-alignment: center; font-size: 10.5px; font-family: Fonts.mono; color: root.flt-active ? Pal.accent : Pal.faint; }
                                if root.flt-custom : Rectangle {
                                    width: rst.preferred-width + 14px; height: 22px; border-radius: 11px;
                                    background: rta.has-hover ? Pal.surface : transparent;
                                    rta := TouchArea { mouse-cursor: pointer; clicked => { root.flt-reset(); } }
                                    rst := Text { x: 7px; y: (parent.height - self.height) / 2; text: "Reset"; font-size: 11px; color: rta.has-hover ? Pal.text : Pal.text3; }
                                }
                            }
                            Text { text: "SHOW"; font-size: 10px; font-family: Fonts.mono; letter-spacing: 0.6px; color: Pal.faint; }
                            HorizontalLayout {
                                spacing: 4px; alignment: start;
                                for m[i] in ["All", "Music only", "Long sets"] : LocalChip { label: m; on: root.flt-mode == i; clicked => { root.flt-set-mode(i); } }
                            }
                            if root.flt-mode > 0 : Text {
                                text: root.flt-mode == 1 ? "Hides clips under 1:00 \u{2014} songs, long tracks and sets stay." : "Only tracks of 20:00 or more (mixes, sets).";
                                font-size: 11px; color: Pal.text3; wrap: word-wrap;
                            }
                            Text { text: "LENGTH"; font-size: 10px; font-family: Fonts.mono; letter-spacing: 0.6px; color: Pal.faint; }
                            HorizontalLayout {
                                spacing: 6px;
                                LocalLenField {
                                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                                    label: "Shortest"; text <=> root.flt-min-text; invalid: root.flt-min-bad;
                                    commit(t) => { root.flt-set-len(false, t); }
                                }
                                LocalLenField {
                                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                                    label: "Longest"; text <=> root.flt-max-text; invalid: root.flt-max-bad;
                                    commit(t) => { root.flt-set-len(true, t); }
                                }
                            }
                            Text {
                                text: root.flt-min-bad || root.flt-max-bad ? "Couldn't read that \u{2014} try 90, 1:30, 5m or 1:02:00." : "Type 90, 1:30, 5m or 1:02:00 \u{00b7} empty = any.";
                                font-size: 10.5px; wrap: word-wrap;
                                color: root.flt-min-bad || root.flt-max-bad ? #e5484d : Pal.faint;
                            }
                            if root.flt-types.length > 0 : Text { text: "FILE TYPES"; font-size: 10px; font-family: Fonts.mono; letter-spacing: 0.6px; color: Pal.faint; }
                            // Four to a row, however many types the library has.
                            if root.flt-types.length > 0 : Rectangle {
                                property <length> cw: (self.width - 3 * 6px) / 4;
                                height: ceil(root.flt-types.length / 4) * 30px - 6px;
                                for c[i] in root.flt-types : LocalChip {
                                    x: Math.mod(i, 4) * (parent.cw + 6px);
                                    y: floor(i / 4) * 30px;
                                    width: parent.cw;
                                    label: c.label; on: c.on;
                                    clicked => { root.flt-toggle-type(i); }
                                }
                            }
                        }
                    }
                }
                if root.filters-open : Rectangle { height: 1px; background: #1a1a1a; }
                tree := ListView {
                    vertical-stretch: 1;
                    for n[i] in root.nodes : LocalTreeRow {
                        node: n;
                        // A playlist row under the pointer while tracks are carried.
                        drop-hot: root.carry-active && n.droppable
                            && root.carry-x >= self.win-x - root.absolute-position.x
                            && root.carry-x < self.win-x - root.absolute-position.x + self.width
                            && root.carry-y >= self.win-y - root.absolute-position.y
                            && root.carry-y < self.win-y - root.absolute-position.y + self.height;
                        changed drop-hot => {
                            if (self.drop-hot) { root.drop-target = i; }
                            else if (root.drop-target == i) { root.drop-target = -1; }
                        }
                        clicked => { root.node-click(i); }
                        menu(mx, my) => { root.node-menu(i, mx, my); }
                    }
                }
            }
            Rectangle { x: parent.width - 1px; width: 1px; background: #1a1a1a; }
        }
        // ── the track list (or the now-playing view) + the player strip ──
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                if !root.now-open : HorizontalLayout {
                    padding-left: 20px; padding-right: 20px; padding-top: 14px; padding-bottom: 10px;
                    spacing: 10px;
                    Text { text: root.title; vertical-alignment: center; font-size: 20px; font-weight: 700; overflow: elide; color: Pal.text; }
                    Text { text: root.stats; vertical-alignment: center; horizontal-stretch: 1; font-size: 11px; font-family: Fonts.mono; color: Pal.text3; overflow: elide; }
                }
                if !root.now-open : Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        // Right: the list ends 8px short of the window edge (see `lst`).
                        padding-left: 20px; padding-right: 28px; spacing: 12px;
                        LocalColHead { width: 24px; label: "#"; active: root.sort-col == 0; desc: root.sort-desc; clicked => { root.sort(0); } }
                        LocalColHead { horizontal-stretch: 4; preferred-width: 0px; min-width: 0px; label: "TITLE"; active: root.sort-col == 1; desc: root.sort-desc; clicked => { root.sort(1); } }
                        LocalColHead { horizontal-stretch: 3; preferred-width: 0px; min-width: 0px; label: "ARTIST"; active: root.sort-col == 2; desc: root.sort-desc; clicked => { root.sort(2); } }
                        LocalColHead { horizontal-stretch: 3; preferred-width: 0px; min-width: 0px; label: "ALBUM"; active: root.sort-col == 3; desc: root.sort-desc; clicked => { root.sort(3); } }
                        LocalColHead { width: 40px; label: "TIME"; right: true; active: root.sort-col == 4; desc: root.sort-desc; clicked => { root.sort(4); } }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: #1a1a1a; }
                }
                if !root.now-open && root.rows.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: root.empty;
                        width: min(parent.width - 60px, 420px);
                        x: (parent.width - self.width) / 2; y: 40px;
                        horizontal-alignment: center; wrap: word-wrap;
                        color: Pal.text3; font-size: 13px;
                    }
                }
                if !root.now-open && root.rows.length > 0 : Rectangle {
                    vertical-stretch: 1;
                    LocalBackdrop { frame: root.bg; sized(w, h) => { root.bg-w = w; root.bg-h = h; } }
                lst := ListView {
                    x: 0; y: 0;
                    width: parent.width - 8px; height: parent.height;
                    // Hold-to-select drag: the pointer's y inside the visible list, the
                    // row last reported, and an auto-scroll near an edge (as `trklist`).
                    property <bool> dsel: false;
                    property <length> dvis;
                    property <int> dlast: -1;
                    function drow(content-y: length) {
                        if (Math.max(0, Math.min(root.rows.length - 1, floor(content-y / 36px))) != lst.dlast) {
                            lst.dlast = Math.max(0, Math.min(root.rows.length - 1, floor(content-y / 36px)));
                            root.drag-to(lst.dlast);
                        }
                    }
                    function dmove(content-y: length) {
                        lst.dvis = content-y + lst.viewport-y;
                        lst.drow(content-y);
                    }
                    function dtick() {
                        if (lst.dvis < 36px || lst.dvis > lst.visible-height - 36px) {
                            if (lst.dvis < 36px) {
                                lst.viewport-y = min(0px, lst.viewport-y + 16px);
                            } else {
                                lst.viewport-y = max(min(0px, lst.visible-height - lst.viewport-height), lst.viewport-y - 16px);
                            }
                            lst.drow(lst.dvis - lst.viewport-y);
                        }
                    }
                    for r[i] in root.rows : LocalTrackRow {
                        t: r;
                        has-selection: root.has-selection;
                        activate => { root.row-activate(i); }
                        select(c, s) => { root.row-select(i, c, s); }
                        clear-sel => { root.row-clear-sel(); }
                        menu(mx, my) => { root.row-menu(i, mx, my); }
                        hold-begin => { lst.dsel = true; lst.dlast = i; root.drag-begin(i); }
                        hold-move(y) => { lst.dmove(y); }
                        hold-tick => { lst.dtick(); }
                        hold-end => { lst.dsel = false; lst.dlast = -1; root.drag-end(); }
                        carry-begin => { root.carry-begin(i); }
                        carry-move(x, y) => { root.carry-move(x - root.absolute-position.x, y - root.absolute-position.y); }
                        carry-end => { root.carry-end(); }
                    }
                }
                }
                if root.now-open : Rectangle {
                    vertical-stretch: 1;
                    LocalBackdrop { frame: root.bg; sized(w, h) => { root.bg-w = w; root.bg-h = h; } }
                LocalNowView {
                    title: root.now-has ? root.now-title : "Nothing playing";
                    artist: root.now-artist;
                    album: root.now-album;
                    art-img: root.now-cover;
                    glow: root.now-glow;
                    elapsed: root.now-elapsed;
                    duration: root.now-duration;
                    progress: root.now-progress;
                    playing: root.now-playing;
                    shuffle: root.shuffle;
                    repeat: root.repeat;
                    volume: root.volume;
                    close => { root.now-open = false; }
                    toggle-play => { root.toggle-play(); }
                    prev => { root.prev(); }
                    next => { root.next(); }
                    seek(v) => { root.seek(v); }
                    set-volume(v) => { root.set-volume(v); }
                    toggle-shuffle => { root.toggle-shuffle(); }
                    cycle-repeat => { root.cycle-repeat(); }
                    glow-baked: root.glow-baked;
                    glow-geom(x, y, d) => { root.glow-x = x; root.glow-y = y; root.glow-d = d; }
                    bg-menu(x, y) => { root.bg-menu(x, y); }
                }
                }
                // The player strip: time and volume · transport, centred on the window ·
                // the track (click → now-playing view).
                if !root.now-open : strip := Rectangle {
                    height: 64px;
                    // Narrow (the Queue drawer open beside it): the volume goes first,
                    // then the time, shuffle and repeat (the now-playing view keeps them
                    // all), and the track takes the room. Set from a change handler — the
                    // strip's contents are part of its own size request.
                    property <int> fit: 2;
                    function refit() { self.fit = self.width >= 600px ? 2 : self.width >= 470px ? 1 : 0; }
                    init => { self.refit(); }
                    changed width => { self.refit(); }
                    Rectangle { y: 0; height: 1px; background: #1a1a1a; }
                    // Time and volume on the left.
                    lg := HorizontalLayout {
                        x: 16px; y: 3px; height: parent.height - 3px;
                        width: self.preferred-width;
                        spacing: 10px;
                        if strip.fit >= 1 : Text {
                            text: root.now-has ? root.now-elapsed + " / " + root.now-duration : "";
                            vertical-alignment: center;
                            font-size: 11px; font-family: Fonts.mono; color: Pal.text3;
                        }
                        if strip.fit >= 2 : VerticalLayout {
                            alignment: center;
                            Path { width: 16px; height: 16px; viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke: Pal.text3; stroke-width: 1.6px; stroke-line-cap: round; stroke-line-join: round; commands: Icons.volume; }
                        }
                        if strip.fit >= 2 : VerticalLayout { alignment: center; LocalScrub { width: 70px; value: root.volume; scrubbed(v) => { root.set-volume(v); } } }
                    }
                    // The transport, centred on the window (the library tree beside this
                    // panel would otherwise push it right), kept clear of both sides.
                    tp := HorizontalLayout {
                        property <length> left-min: strip.fit >= 1 ? 16px + lg.preferred-width + 24px : 16px;
                        property <length> centred: root.win-w / 2 - strip.absolute-position.x - self.preferred-width / 2;
                        x: max(self.left-min, min(self.centred, strip.width - 16px - 160px - self.preferred-width));
                        y: 3px; height: parent.height - 3px;
                        width: self.preferred-width;
                        spacing: 10px;
                            if strip.fit >= 1 : VerticalLayout { alignment: center; IconBtn { cmds: Icons.shuffle; stroked: true; icon: 16px; box: 32px; is-active: root.shuffle; clicked => { root.toggle-shuffle(); } } }
                            VerticalLayout { alignment: center; IconBtn { cmds: Icons.prev; stroked: true; fill-too: true; tint: Pal.text; icon: 18px; box: 34px; clicked => { root.prev(); } } }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 38px; height: 38px; border-radius: 19px;
                                    background: plta.has-hover ? Pal.accent.brighter(0.2) : Pal.accent;
                                    plta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-play(); } }
                                    Path {
                                        width: 16px; height: 16px;
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        viewbox-width: 24; viewbox-height: 24;
                                        fill: Pal.ink;
                                        commands: root.now-playing ? Icons.pause : Icons.play;
                                    }
                                }
                            }
                            VerticalLayout { alignment: center; IconBtn { cmds: Icons.next; stroked: true; fill-too: true; tint: Pal.text; icon: 18px; box: 34px; clicked => { root.next(); } } }
                            if strip.fit >= 1 : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px; height: 32px;
                                    IconBtn { cmds: Icons.repeat; stroked: true; icon: 16px; box: 32px; is-active: root.repeat != 0; clicked => { root.cycle-repeat(); } }
                                    if root.repeat == 2 : Text { text: "1"; x: 22px; y: 3px; font-size: 9px; font-family: Fonts.mono; color: Pal.text; }
                                }
                            }
                    }
                    // The track on the right; click → the now-playing view.
                    Rectangle {
                        property <length> avail: max(0px, strip.width - 16px - (tp.x + tp.width + 24px));
                        width: min(self.avail, trk.preferred-width);
                        x: strip.width - 16px - self.width;
                        y: 3px; height: parent.height - 3px;
                        nta := TouchArea { mouse-cursor: root.now-has ? pointer : default; clicked => { if (root.now-has) { root.now-open = true; } } }
                        trk := HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 44px; height: 44px; border-radius: 8px; clip: true;
                                    background: Pal.surface2;
                                    Image { width: 100%; height: 100%; source: root.now-cover; image-fit: cover; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                alignment: center;
                                spacing: 1px;
                                Text { text: root.now-has ? root.now-title : "Nothing playing"; font-size: 13px; font-weight: 600; overflow: elide; color: root.now-has ? (nta.has-hover ? #ffffff : Pal.text) : Pal.text3; }
                                Text { text: root.now-artist; font-size: 12px; color: Pal.text3; overflow: elide; }
                            }
                        }
                    }
                    // Seek: along the strip's top edge, inset like its contents.
                    if root.now-has : LocalScrub {
                        x: 16px; y: -6px; width: parent.width - 32px; height: 12px;
                        line: 3px; hover-knob: true;
                        value: root.now-progress; fill: Pal.accent;
                        scrubbed(v) => { root.seek(v); }
                    }
                }
            }
        }
    }
    // Files dragged in from Explorer: only audio is taken.
    if root.drop-active : Rectangle {
        x: 10px; y: 10px; width: parent.width - 20px; height: parent.height - 20px;
        border-radius: 16px;
        border-width: 1.5px;
        border-color: Pal.accent;
        background: #0a0a0af4;
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 52px; height: 52px; border-radius: 26px;
                    background: Pal.accent.with-alpha(0.18);
                    Path { width: 24px; height: 24px; x: 14px; y: 14px; viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke: Pal.accent; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round; commands: Icons.download; }
                }
            }
            Text { text: "Drop to add to your local library"; horizontal-alignment: center; font-size: 18px; font-weight: 700; color: Pal.text; }
            Text { text: root.drop-detail; horizontal-alignment: center; font-size: 11.5px; font-family: Fonts.mono; color: Pal.text2; }
            Text { text: "Files stay where they are \u{2014} Lightify only indexes them. Drop a folder to add everything in it."; horizontal-alignment: center; font-size: 12.5px; color: Pal.text3; }
        }
    }
    // The chip that follows the pointer while tracks are carried.
    if root.carry-active : Rectangle {
        x: root.carry-x + 14px;
        y: root.carry-y + 10px;
        height: 30px;
        width: chip.preferred-width + 40px;
        border-radius: 15px;
        background: Pal.accent;
        HorizontalLayout {
            padding-left: 10px; padding-right: 12px; spacing: 8px;
            VerticalLayout { alignment: center; Path { width: 14px; height: 14px; viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke: Pal.ink; stroke-width: 2px; stroke-line-cap: round; commands: Icons.note; } }
            chip := Text { text: root.carry-label; vertical-alignment: center; font-size: 12.5px; font-weight: 700; color: Pal.ink; }
        }
    }
}

// "Find music on this PC".
component LocalFind inherits Rectangle {
    in property <[LocalCand]> cands;
    in property <bool> busy;
    in property <string> confirm-label;
    callback toggle(int);
    callback add-folder();
    callback add-files();
    callback confirm();
    callback close();
    background: #00000099;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: min(parent.width - 40px, 540px);
        height: min(fbody.preferred-height, parent.height - 40px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Pal.card;
        border-radius: 18px;
        border-width: 1px;
        border-color: Pal.border-hi;
        clip: true;
        TouchArea { }
        fbody := VerticalLayout {
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 22px; padding-right: 10px;
                    Text { text: "Find music on this PC"; vertical-alignment: center; horizontal-stretch: 1; font-size: 17px; font-weight: 700; color: Pal.text; }
                    VerticalLayout { alignment: center; IconBtn { cmds: Icons.close; stroked: true; icon: 15px; box: 34px; clicked => { root.close(); } } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Pal.surface2; }
            }
            VerticalLayout {
                padding-left: 22px; padding-right: 22px; padding-top: 14px; padding-bottom: 4px;
                spacing: 2px;
                Text { text: root.busy ? "// looking in the usual places\u{2026}" : "// found in the usual places"; font-size: 11px; font-family: Fonts.mono; color: Pal.text3; }
                if !root.busy && root.cands.length == 0 : Text { text: "No music found in the usual folders \u{2014} add a folder or files below."; font-size: 12.5px; color: Pal.text3; wrap: word-wrap; }
                for c[i] in root.cands : Rectangle {
                    height: 46px;
                    cta := TouchArea { mouse-cursor: pointer; clicked => { if (!c.added) { root.toggle(i); } } }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px; height: 16px; border-radius: 5px;
                                background: c.on || c.added ? Pal.accent : transparent;
                                border-width: 1px;
                                border-color: c.on || c.added ? Pal.accent : Pal.border-strong;
                                opacity: c.added ? 0.5 : 1;
                                if c.on || c.added : Path { width: 11px; height: 11px; x: 2.5px; y: 2.5px; viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke: Pal.ink; stroke-width: 3px; stroke-line-cap: round; stroke-line-join: round; commands: "M5 12.5l4.5 4.5L19 7.5"; }
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1; spacing: 1px;
                            Text { text: c.name; font-size: 13px; font-weight: 500; overflow: elide; color: c.added ? Pal.text3 : Pal.text; }
                            Text { text: c.path; font-size: 10.5px; font-family: Fonts.mono; color: Pal.faint; overflow: elide; }
                        }
                        Text { text: c.added ? "added" : c.count; vertical-alignment: center; font-size: 11px; font-family: Fonts.mono; color: Pal.text3; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: #191919; }
                }
            }
            HorizontalLayout {
                padding-left: 22px; padding-right: 22px; padding-top: 14px; padding-bottom: 18px;
                spacing: 8px;
                PillBtn { label: "Add a folder\u{2026}"; clicked => { root.add-folder(); } }
                PillBtn { label: "Add files\u{2026}"; clicked => { root.add-files(); } }
                Rectangle { horizontal-stretch: 1; }
                if root.confirm-label != "" : Rectangle {
                    height: 28px; width: cfl.preferred-width + 26px; border-radius: 14px;
                    background: cfta.has-hover ? #ffffff : Pal.text;
                    cfta := TouchArea { mouse-cursor: pointer; clicked => { root.confirm(); } }
                    cfl := Text { text: root.confirm-label; color: Pal.ink; font-size: 12.5px; font-weight: 700; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
            }
        }
    }
}

// One invisible resize handle of the frameless window: a press starts the OS's own
// resize drag in `dir` (see `start-resize`).
component ResizeGrip inherits TouchArea {
    in property <int> dir;
    callback grab(int);
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
            root.grab(root.dir);
        }
    }
}

export component MainWindow inherits Window {
    title: "Lightify";
    // The live window's icon (titlebar-less, so this is what the taskbar button and
    // Alt-Tab show while it runs). The .exe's own icon - what Explorer and a pinned
    // shortcut read - is embedded separately as a Win32 resource in build.rs; they
    // are two different things and the app needs both.
    icon: @image-url("../assets/lightify-icon.png");
    no-frame: true;
    background: Pal.bg;
    // The bundled Space Grotesk (imported at the top); the host can still override.
    in property <string> ui-font: Fonts.ui;
    default-font-family: root.ui-font;
    preferred-width: 980px;
    preferred-height: 660px;
    // Relax the min-size in a mini mode so the window can shrink below the full min
    // (the mini targets are far smaller); Rust sets the exact per-mode min via winit.
    min-width: root.mini-mode == "off" ? 640px : 180px;
    min-height: root.mini-mode == "off" ? 460px : 100px;

    // Playback state (mock defaults; wired to the host in the real port).
    in-out property <bool> playing: true;
    in property <string> track-name: "Midnight City";
    in property <string> track-artist: "M83";
    in property <float> progress: 0.42;      // 0..1
    in property <string> elapsed: "2:38";
    in property <string> duration: "4:04";
    in property <float> volume: 0.8;          // 0..1
    in property <string> status-text: "Connecting\u{2026}";

    // Library sort toolbar (#library-toolbar). The worker keeps a separate mode/dir
    // per surface (playlist list vs drilled track list) and pushes the visible one.
    in property <string> lib-sort-mode: "recent";   // "recent" | "alpha"
    in property <string> lib-sort-dir: "asc";       // "asc" | "desc"

    // Library drill-in (slice 2): when drilled, the left panel shows a track list.
    // Infinite scroll for the drilled track list. `tracks-more` is false while a
    // page is in flight and once the list is complete, so the scroll handler can't
    // fire the same page twice (the original's `pager.loading` / `pager.done`).
    in-out property <bool> tracks-more: false;
    in property <bool> drilled: false;
    in property <string> drill-title: "";
    in-out property <[Trk]> tracks: [];

    // Now-playing album art + its extracted accent glow colour.
    in property <image> album-art;
    // The cover being replaced, kept under the new one while it fades in (A6). The
    // host sets it just before `album-art`; it is released once the fade is done.
    in-out property <image> prev-art;
    property <image> no-image;
    out property <float> art-fade: 1;
    // Instant on the way down, eased on the way up (`fade-in` picks which).
    property <bool> fade-in: false;
    animate art-fade { duration: root.fade-in ? 220ms : 0ms; easing: ease-out; }
    changed album-art => {
        if (!Motion.reduced && root.prev-art.width > 0) {
            root.fade-in = false;
            root.art-fade = 0;
            art-fade-start.running = true;
        } else {
            root.fade-in = false;
            root.art-fade = 1;
            root.prev-art = root.no-image;
        }
    }
    // Two steps: drop to 0 without animating, then (next frame) rise to 1 animated.
    art-fade-start := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.fade-in = true;
            root.art-fade = 1;
            art-fade-done.running = true;
        }
    }
    art-fade-done := Timer {
        interval: 260ms;
        running: false;
        triggered => {
            self.running = false;
            root.prev-art = root.no-image;
        }
    }
    in property <color> glow: #34d39955;

    // Tabs + search (slice 3). tab: 0=library, 1=search, 2=beatport.
    // Search drill-in (`#search-drill` / `#btn-search-back`): drilling a playlist or
    // album hit stays INSIDE the search tab instead of hijacking the library list.
    in property <bool> search-drilled: false;
    in property <string> search-drill-title: "";
    in-out property <[Trk]> search-tracks: [];
    in-out property <bool> search-tracks-more: false;
    // More playlist hits available. The original pages search results only under the
    // PLAYLISTS filter (`searchResultsPagerIsActive`), so this is only ever set there.
    in-out property <bool> search-more: false;
    in property <int> tab: 0;
    in-out property <string> search-filter: "all";
    in-out property <[SearchRow]> search-results: [];

    // Now-playing extras: Liked-Songs state for the current track (me/tracks/contains).
    in property <bool> liked-current: false;
    in property <bool> like-pending: false;   // a save/un-save is in flight

    // Now-playing control states (live from me/player).
    in property <bool> shuffle-on: false;
    in property <string> repeat-mode: "off";      // "off" | "context" | "track"
    // Local drag feedback for the progress + volume bars (committed on release).
    in-out property <float> scrub-progress: 0;
    in-out property <bool> scrubbing-progress: false;
    in-out property <float> scrub-volume: 0;
    in-out property <bool> scrubbing-volume: false;
    // A volume change the user just made, which Spotify has not echoed back yet.
    // Playback polls keep reporting the OLD level for a beat after the write, and
    // writing that back is exactly the "slider snaps back, then jumps" flicker.
    // While `volume-pending` is set, only a report that matches `volume-target` is
    // allowed to move the slider.
    in-out property <bool> volume-pending: false;
    in-out property <float> volume-target: 0;

    // Sidebar overlay (queue / recent / downloads). 0=hidden 1=queue 2=recent 3=downloads.
    in property <int> sidebar-mode: 0;
    in-out property <[SideRow]> sidebar-rows: [];
    // A Beatport chart lining up on the QUEUE panel: the strip under the header
    // (hidden while `bp-strip-title` is empty), and the one-line summary once done.
    in property <string> bp-strip-title: "";
    in property <int> bp-strip-found: 0;
    in property <int> bp-strip-total: 0;
    in property <string> bp-done-note: "";
    in property <string> sidebar-empty: "No queued tracks";
    // DOWNLOADS mode rows (their own model: a download row shows progress, not a
    // track's artist/time). Only read when `sidebar-mode == 3`.
    in-out property <[DlRow]> sidebar-dl-rows: [];
    // `updateSidebarClearButton` disables Clear in DOWNLOADS mode when no row is in a
    // finished state (nothing for `/api/clear_items` to drop).
    in property <bool> downloads-clearable: false;

    // Beatport tab.
    in-out property <[string]> bp-genres: [];
    in property <string> bp-genre-label: "Overall";
    in property <int> bp-genre-idx: 0;
    in-out property <bool> bp-genre-open: false;
    in property <string> bp-kind: "tracks";      // tracks | hype | releases
    in-out property <[BpItem]> bp-rows: [];
    in property <string> bp-status: "Select a genre to load a Beatport chart";

    // Settings modal.
    in-out property <bool> settings-open: false;
    in-out property <[DeviceRow]> settings-devices: [];
    in property <string> settings-device-status: "Loading\u{2026}";
    in property <int> poll-ms: 5000;             // 5000 (default) | 3000 | 1000
    // Bundled playback engine (lightify-audio) — Lightify's own Connect device.
    in property <string> engine-status: "Starting\u{2026}";
    in property <bool> engine-ok: false;
    // Where the engine sends sound. Row 0 is always "System default".
    in-out property <[DeviceRow]> settings-outputs: [];
    in property <string> settings-output-note: "";
    // Downloader (bundled OnTheSpot bridge).
    in-out property <string> settings-download-path: "";
    in property <string> downloader-status: "Checking\u{2026}";
    in property <bool> downloader-ready: false;
    in property <bool> downloader-busy: false;
    in property <string> account: "";
    // Shown in Settings → About (the host sets it from CARGO_PKG_VERSION).
    in property <string> app-version: "";

    // Window chrome (`minimized` / `maximized` are builtin Window properties).
    in-out property <bool> left-collapsed: false;

    // Cover expand: double-click the cover (or the pane) and the art fills the whole
    // centre pane behind the controls; double-click again to shrink it. A double-click
    // that also closed a sidebar does NOT toggle it — the sidebars go first.
    in-out property <bool> art-full: false;
    out property <float> art-expand: root.art-full ? 1 : 0;
    animate art-expand { duration: Motion.slide; easing: cubic-bezier(0.22, 0.85, 0.28, 1); }
    // When the last click on the pane dismissed something (`animation-tick()` time).
    property <duration> last-dismiss: -10s;
    function pane-click() {
        if (root.sidebar-mode != 0 || !root.left-collapsed) {
            root.last-dismiss = animation-tick();
        }
        root.dismiss-overlays();
    }
    function pane-double-click() {
        if (animation-tick() - root.last-dismiss > 700ms) {
            root.art-full = !root.art-full;
        }
    }

    // Self-update (lightify_core::update). state: "idle" | "checking" | "downloading"
    // | "ready" | "current" | "error". `update-version` = the version on offer.
    in property <string> update-state: "idle";
    in property <string> update-version: "";
    in property <string> update-note: "";
    in property <float> update-progress: 0;     // 0..1 while downloading
    // The version the user pressed "Mark seen" on (persisted): it stops asking for
    // attention, and isn't downloaded on its own.
    in property <string> update-seen-version: "";
    callback update-mark-seen();
    // A newer version is waiting (found, or downloaded) and hasn't been marked seen:
    // the settings cog pulses in the accent colour until it is.
    property <bool> update-attention: (root.update-state == "ready" || root.update-state == "available")
        && root.update-version != "" && root.update-seen-version != root.update-version;
    in-out property <bool> update-auto: true;
    callback update-check();
    callback update-restart();
    callback set-update-auto(bool);

    // Mini-player (compact always-on-top layouts). "off" | "square" | "bar" | "nano".
    in-out property <string> mini-mode: "off";
    in-out property <string> mini-last: "square";     // last active layout (persisted; recalled by the toggle)
    // Presence: what is "now" — the local track while it is the one playing (or Local
    // mode is on and Spotify isn't playing), else Spotify. The cover tint everything
    // "now" takes (Pal.accent, the mini frame) and the mini player follow it. The host
    // sets `spotify-accent` from Spotify covers; a local cover's comes with its glow.
    in property <color> spotify-accent: #34d399;
    out property <bool> local-present: root.local-now-has && (root.local-now-playing || (root.local-mode && !root.playing));
    out property <color> mini-accent: root.local-present ? root.local-now-glow.with-alpha(1) : root.spotify-accent;
    changed mini-accent => { Pal.accent = root.mini-accent; }
    out property <image> mini-art: root.local-present ? root.local-now-cover : root.album-art;
    out property <string> mini-title: root.local-present ? root.local-now-title : root.track-name;
    out property <string> mini-artist: root.local-present ? root.local-now-artist : root.track-artist;
    out property <bool> mini-playing: root.local-present ? root.local-now-playing : root.playing;
    out property <string> mini-elapsed: root.local-present ? root.local-now-elapsed : root.elapsed;
    out property <string> mini-duration: root.local-present ? root.local-now-duration : root.duration;
    out property <float> mini-progress: root.local-present ? root.local-now-progress : root.progress;
    function mini-prev() { if (root.local-present) { root.local-prev(); } else { root.prev-clicked(); } }
    function mini-toggle() { if (root.local-present) { root.local-toggle-play(); } else { root.toggle-play(); } }
    function mini-next() { if (root.local-present) { root.local-next(); } else { root.next-clicked(); } }
    function mini-seek(f: float) { if (root.local-present) { root.local-seek(f); } else { root.seek(f); } }
    // (The full window's size, place and maximized state across the mini player live
    // in the saved window record — `window_geom` — not here.)

    // Command palette (Ctrl+K).
    // Right-click menu (`.ctx-menu`) + the delete-playlist confirm dialog
    // (`#confirm-overlay`). `ctx-x`/`ctx-y` are window coordinates of the pointer.
    // Track-list multi-select. Only track rows are selectable — in the original
    // `registerSelectableRow` is never used for playlist rows.
    in property <int> sel-count: 0;

    in-out property <bool> ctx-open: false;
    in-out property <[MenuItem]> ctx-items: [];
    // `.ctx-menu` is min-width:156px and grows to fit its longest label; the width
    // is measured in Rust because a non-layout element can't size to its content.
    in-out property <length> ctx-w: 156px;
    in-out property <length> ctx-x: 0;
    in-out property <length> ctx-y: 0;
    in-out property <bool> confirm-open: false;
    in property <string> confirm-title: "DELETE PLAYLIST";
    in property <string> confirm-message: "Are you sure?";

    in-out property <bool> palette-open: false;
    in-out property <[CmdRow]> cmdk-rows: [];
    in-out property <int> cmdk-selected: 0;
    in-out property <string> search-text: "";     // controlled search-box text

    // Cover thumbnails, index-parallel to `playlists` (a `Row` can't carry an image:
    // rows are built off the UI thread). Missing entries draw the placeholder glyph.
    in property <[image]> playlist-art;
    in-out property <[Row]> playlists: [
        { name: "Liked Songs",        sub: "1,240", liked: true },
        { name: "Deep Focus",         sub: "86" },
        { name: "Late Night Drive",   sub: "132", active: true, playing: true },
        { name: "Techno Bunker",      sub: "204" },
        { name: "Sunday Coffee",      sub: "57" },
        { name: "Rooftop Sunsets",    sub: "91" },
        { name: "Workout Heat",       sub: "148" },
        { name: "Ambient Rain",       sub: "40" },
        { name: "90s Throwback",      sub: "220" },
        { name: "Beatport Hype 100",  sub: "100" },
        { name: "Jazz & Vinyl",       sub: "63" },
        { name: "Lo-fi Beats",        sub: "310" },
    ];

    // Fired when anything Windows' media flyout shows changes (the host mirrors
    // it into the System Media Transport Controls). Change handlers, so every path
    // that updates now-playing is covered without each one having to remember.
    callback media-changed();

    // Search (rework): covers index-parallel to `search-results`, a busy flag for the
    // empty state, and Enter-to-open-the-top-result.
    in property <[image]> search-art;
    in property <bool> search-loading: false;
    callback search-enter();

    // Type-to-filter (UI-PLAN D7): typing over the Library tab filters the visible
    // left list (playlists, or the open track list). The host does the filtering.
    in-out property <string> list-filter: "";
    in property <int> list-filter-count: -1;   // matches, -1 = no filter
    callback list-filter-edited(string);
    pure callback is-printable(string) -> bool;
    pure callback chop-last(string) -> string;
    function list-filter-chop() -> string { return root.chop-last(root.list-filter); }
    changed track-name => { root.media-changed(); }
    changed track-artist => { root.media-changed(); }
    changed playing => { root.media-changed(); root.local-bg-wake(); }

    callback close-clicked();
    callback start-drag();
    // The main titlebar's empty area was pressed: the host starts a window move, or
    // returns true for the second press of a double-click (no move then).
    callback titlebar-press(length, length) -> bool;
    callback toggle-left-panel();
    callback toggle-play();
    callback next-clicked();
    callback prev-clicked();
    callback open-row(int);
    callback back-clicked();
    callback play-track(int);
    callback select-tab(int);
    callback query-changed(string);
    callback set-search-filter(string);
    callback open-search(int);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback add-queue();
    callback start-station();        // #btn-station — Spotify song radio for the current track
    callback toggle-like();          // save / un-save the current track
    callback sort-recent();          // #btn-library-sort-recent
    callback sort-alpha();           // #btn-library-sort-alpha (2nd press flips direction)
    callback seek(float);           // 0..1 fraction of the track
    callback set-volume(float);     // 0..1
    callback toggle-sidebar(int);   // 1=queue 2=recent 3=downloads (same mode closes)
    callback close-sidebar();
    // Click on the centre pane: close the RIGHT sidebar if it is open, otherwise
    // collapse the LEFT panel — never both at once (`app.js:1668`). `sidebar-mode`
    // is worker-owned so that half goes through `close-sidebar()`, while
    // `left-collapsed` is in-out and can be set here directly.
    callback dismiss-overlays();
    // `#btn-sidebar-clear` in QUEUE mode: reset the device's queue back to just
    // the current track (`.sidebar-clear-btn`). Only meaningful for QUEUE — the
    // original also allows it for its own local recent-history list and finished
    // downloads, neither of which exist here (RECENT is Spotify's own live
    // recently-played history, nothing local to clear; downloads are host-only).
    callback clear-queue();
    // Per-row × on a QUEUE sidebar row (`SideTrackRow.removable`).
    callback remove-queued-track(int);
    callback sidebar-play(int);
    callback bp-ensure();           // fired when the Beatport tab is first shown
    callback bp-toggle-genre();
    callback bp-select-genre(int);
    callback bp-set-mode(string);
    callback bp-play(int);
    callback bp-open-external();     // open the current chart in the default browser
    callback open-settings();
    callback close-settings();
    callback settings-refresh-devices();
    callback settings-select-device(int);
    callback set-poll-rate(int);     // poll interval in ms
    callback restart-engine();       // relaunch the bundled playback engine
    callback settings-select-output(int); // pick the engine's audio output device
    // Downloader (bundled OnTheSpot bridge).
    callback settings-apply-download-path(string);
    callback settings-start-downloader-login();
    // `#btn-sidebar-clear` in DOWNLOADS mode: drop every finished/cancelled row.
    callback clear-downloads();
    callback load-palette();         // ask the worker to (re)build the command list
    callback cmdk-query-changed(string);
    callback run-palette();          // run the currently-selected command
    callback set-mini-mode(string);  // enter/switch/exit a mini-player mode ("off" exits)
    // Resize from an edge/corner: 0 N, 1 S, 2 W, 3 E, 4 NW, 5 NE, 6 SW, 7 SE.
    callback start-resize(int);

    // ── Local library mode ──────────────────────────────────────────────────
    // The footer's Local toggle; the view cross-fades (`local-fade`) between the
    // Spotify panels and the local library. Always animates (like the slides).
    in-out property <bool> local-mode: false;
    out property <float> local-fade: root.local-mode ? 1 : 0;
    animate local-fade { duration: 280ms; easing: ease-in-out; }
    callback local-mode-changed(bool);
    in property <[LocalNode]> local-nodes: [];
    in property <[LocalRow]> local-rows: [];
    in property <string> local-kicker: "// local";
    in property <string> local-title: "";
    in property <string> local-stats: "";
    in property <string> local-empty: "";
    in property <int> local-sort-col: -1;
    in property <bool> local-sort-desc: false;
    in property <int> local-sel-count: 0;
    in property <bool> local-now-has: false;
    in property <string> local-now-title: "";
    in property <string> local-now-artist: "";
    in property <image> local-now-cover;
    in property <string> local-now-elapsed: "";
    in property <string> local-now-duration: "";
    in property <float> local-now-progress: 0;
    in property <bool> local-now-playing: false;
    // The Local view's ASCII lava backdrop: the host draws it at the panel's size and
    // runs its frames only while local audio plays (woken on these changes).
    in property <image> local-bg;
    in-out property <length> local-bg-w;
    in-out property <length> local-bg-h;
    callback local-bg-wake();
    in-out property <length> local-glow-x;
    in-out property <length> local-glow-y;
    in-out property <length> local-glow-d;
    in property <bool> local-glow-baked;
    changed local-now-playing => { root.local-bg-wake(); }
    changed local-mode => { root.local-bg-wake(); }
    // The same lava behind the Spotify now-playing pane (while it plays, cover not
    // expanded), and Settings › ascii lava, which turns both off.
    in property <image> np-bg;
    in-out property <length> np-bg-w;
    in-out property <length> np-bg-h;
    in-out property <length> np-glow-x;
    in-out property <length> np-glow-y;
    in-out property <length> np-glow-d;
    in property <bool> np-glow-baked;
    in-out property <bool> lava-on: true;
    callback set-lava-on(bool);
    // (`playing` wakes it from its own change handler, above.)
    changed art-full => { root.local-bg-wake(); }
    changed lava-on => { root.local-bg-wake(); }
    // The ASCII lava screensaver (right-click the lava): the window goes full screen
    // with only the wall in it; any click or key ends it (`lava-saver-end`).
    in property <bool> lava-saver: false;
    in property <image> saver-bg;
    callback lava-saver-end();
    in-out property <float> local-volume: 0.8;
    in property <bool> local-shuffle: false;
    in property <int> local-repeat: 0;
    in property <bool> local-drop-active: false;
    in property <string> local-drop-detail: "";
    in-out property <bool> local-carry-active: false;
    in property <string> local-carry-what: "";
    in-out property <length> local-carry-x: 0;
    in-out property <length> local-carry-y: 0;
    in-out property <int> local-drop-target: -1;
    in property <bool> local-find-open: false;
    in property <[LocalCand]> local-cands: [];
    in property <bool> local-find-busy: false;
    in property <string> local-find-confirm: "";
    in-out property <bool> local-now-open: false;
    in property <string> local-now-album: "";
    in property <color> local-now-glow: #34d39955;
    in-out property <bool> local-filters-open: false;
    in property <int> local-flt-mode: 0;
    in-out property <string> local-flt-min-text: "";
    in-out property <string> local-flt-max-text: "";
    in property <bool> local-flt-min-bad: false;
    in property <bool> local-flt-max-bad: false;
    in property <bool> local-flt-custom: false;
    in property <[LocalFlag]> local-flt-types: [];
    in property <string> local-flt-note: "";
    in property <bool> local-flt-active: false;
    // The Local queue, shown in the Queue drawer while Local mode is on.
    in property <[SideRow]> local-queue-rows: [];
    callback local-drag-begin(int);
    callback local-drag-to(int);
    callback local-drag-end();
    callback local-flt-set-mode(int);
    callback local-flt-set-len(bool, string);
    callback local-flt-reset();
    callback local-flt-toggle-type(int);
    callback local-queue-play(int);
    callback local-queue-remove(int);
    callback local-queue-clear();
    callback local-node-click(int);
    callback local-row-activate(int);
    callback local-row-select(int, bool, bool);
    callback local-row-clear-sel();
    callback local-sort(int);
    callback local-find();
    callback local-rescan();
    callback local-filter-edited(string);
    callback local-toggle-play();
    callback local-prev();
    callback local-next();
    callback local-seek(float);
    callback local-set-volume(float);
    callback local-toggle-shuffle();
    callback local-cycle-repeat();
    callback local-carry-begin(int);
    callback local-carry-end(int);
    callback local-find-toggle(int);
    callback local-find-add-folder();
    callback local-find-add-files();
    callback local-find-confirm-add();
    callback local-find-close();
    // Row menus: `kind` 0 = library row (0 = Liked Songs), 1 = drilled track row.
    callback open-context(int, int);
    callback run-context(int);       // run the menu row at this index
    callback play-row(int);          // double-click a library row → play the whole thing
    callback confirm-accept();       // the confirm dialog's Yes

    // Sign-in page (`#auth-page`): shown when there's no usable Spotify session.
    in-out property <bool> signin-open: false;
    in-out property <string> signin-client-id;
    in property <string> signin-status;
    in property <bool> signin-error;       // `.status.error`
    in property <bool> signin-ok;          // `.status.ok`
    in property <bool> signin-waiting;     // browser open, waiting for the redirect
    callback signin-authorise(string);
    callback signin-retry();               // re-open the browser, or start over
    callback signin-open-dashboard();
    // (surface, row, ctrl, shift). Surfaces match open-context's `kind`:
    // 1 = drilled tracks, 2 = search results, 3 = Beatport, 4 = sidebar.
    callback select-click(int, int, bool, bool);
    // New-playlist name prompt: opened by the host when "Create playlist" (from a
    // selection, a Beatport selection, or the queue) is chosen; nothing is created
    // until a name is given. `side` 0 = over the left panel, 1 = over the drawer.
    in-out property <bool> name-prompt-open: false;
    in property <int> name-prompt-side: 0;
    in property <string> name-prompt-note: "";
    callback name-prompt-accept(string);
    callback name-prompt-cancel();
    // Hold-to-select drags (`RowTouch`): (surface, row) when a hold starts one,
    // (surface, content-y) as the pointer moves or the list auto-scrolls, then end.
    // The host adds each drag to the existing selection.
    callback sel-drag-begin(int, int);
    callback sel-drag-move(int, length);
    callback sel-drag-end();
    callback bp-select-all();          // #btn-bp-select-all
    callback bp-create-playlist();     // #btn-bp-create
    callback sidebar-create-playlist();// #btn-sidebar-create-pl
    callback clear-selection();
    callback load-more-tracks();   // near the bottom of the drilled track list
    callback search-back();              // `#btn-search-back` ("\u{2190} Results")
    callback play-search-track(int);     // a row in the search drill-in
    callback load-more-search-tracks();  // near the bottom of the search drill-in
    callback load-more-search-results(); // near the bottom of the results list

    // Focus the root key handler on startup so Ctrl+K works before any click.
    forward-focus: rootkeys;

    function open-palette() {
        root.palette-open = true;
        root.cmdk-selected = 0;
        root.load-palette();
    }
    // The screensaver's way out: the keyboard goes back to the window's shortcuts first
    // (the saver's own FocusScope goes away with it, leaving nothing focused).
    function end-saver() {
        rootkeys.focus();
        root.lava-saver-end();
    }
    function close-palette() {
        root.palette-open = false;
        rootkeys.focus();
    }
    function toggle-palette() {
        if (root.palette-open) {
            root.close-palette();
        } else {
            root.open-palette();
        }
    }
    function palette-move(delta: int) {
        if (root.cmdk-rows.length > 0) {
            root.cmdk-selected = clamp(root.cmdk-selected + delta, 0, root.cmdk-rows.length - 1);
        }
    }

    // Root key handler: global Ctrl/Cmd+K toggles the palette from anywhere.
    rootkeys := FocusScope {
        key-pressed(e) => {
            if ((e.modifiers.control || e.modifiers.meta) && e.text == "k") {
                root.toggle-palette();
                return accept;
            }
            // Type-to-filter: only over the Library tab of the full window, with no
            // overlay open (a focused text field takes its own keys before this).
            if (root.tab == 0 && root.mini-mode == "off" && !root.palette-open && !root.settings-open
                && !root.signin-open && !root.ctx-open && !root.confirm-open && !root.name-prompt-open
                && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
                if (e.text == Key.Escape && root.list-filter != "") {
                    root.list-filter = "";
                    root.list-filter-edited("");
                    return accept;
                }
                if (e.text == Key.Backspace && root.list-filter != "") {
                    root.list-filter = root.list-filter.character-count <= 1 ? "" : root.list-filter-chop();
                    root.list-filter-edited(root.list-filter);
                    return accept;
                }
                if (root.is-printable(e.text) && (root.list-filter != "" || e.text != " ")) {
                    root.list-filter += e.text;
                    root.list-filter-edited(root.list-filter);
                    return accept;
                }
            }
            return reject;
        }

    VerticalLayout {
        spacing: 0;
        // Under the screensaver nothing here shows: not drawing it at all keeps each
        // full-screen frame to the wall's own cost.
        visible: !root.lava-saver;

        // ── Title bar ────────────────────────────────────────────────────────
        if root.mini-mode == "off" : Rectangle {
            height: 36px;
            background: Pal.bg;
            // Bottom-layer drag region: pressing empty titlebar starts a native
            // window move. Buttons/brand sit on top (their TouchAreas grab first).
            // A double-click maximizes / restores, as the caption button does. The
            // native move swallows the second click, so the host times the presses
            // (`titlebar-press` is true on the second of a double-click).
            TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        if (root.titlebar-press(self.mouse-x, self.mouse-y)) {
                            root.maximized = !root.maximized;
                        }
                    }
                }
            }
            // Centred status pill: accent dot + mono status — notices only (progress,
            // confirmations, errors); hidden when there is nothing worth saying.
            // Width-clamped so it never collides with the brand or the caption buttons.
            if root.status-text != "" : Rectangle {
                property <length> room: max(60px, min(parent.width - 360px, 520px));
                width: min(stxt.preferred-width + 34px, self.room);
                height: 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 11px;
                background: Pal.card;
                border-width: 1px;
                border-color: Pal.surface2;
                clip: true;
                Rectangle {
                    x: 11px; y: (parent.height - self.height) / 2;
                    width: 6px; height: 6px; border-radius: 3px;
                    background: Pal.accent;
                }
                stxt := Text {
                    x: 23px;
                    width: parent.width - 34px;
                    y: (parent.height - self.height) / 2;
                    text: root.status-text;
                    color: Pal.text2;
                    font-size: 11px;
                    font-family: Fonts.mono;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 0px;
                spacing: 6px;

                // Brand: the "Lightify" wordmark (also the left-panel toggle).
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 6px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        // The wordmark is the collapse-left-panel toggle: "Lightify" as a
                        // neon sign (Yellowtail). The L is the lit tube in the cover colour;
                        // collapsed, it is switched off. Hover lights the word up and lifts
                        // it a pixel — no box behind it.
                        Rectangle {
                            width: lword.width + rword.width + 10px;
                            height: 36px;
                            lta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-left-panel(); } }
                            lword := NeonText {
                                x: 5px;
                                y: (parent.height - self.height) / 2 - (lta.has-hover ? 1px : 0px);
                                text: "L";
                                ink: root.left-collapsed ? (lta.has-hover ? #4a4a4a : #3a3a3a) : Pal.accent;
                                glow: Pal.accent;
                                strength: root.left-collapsed ? 0 : (lta.has-hover ? 1.6 : 1);
                            }
                            rword := NeonText {
                                x: lword.x + lword.width;
                                y: lword.y;
                                text: "ightify";
                                ink: root.left-collapsed ? (lta.has-hover ? #e0e0e0 : #bdbdbd) : (lta.has-hover ? #ffffff : #ececec);
                                glow: #ffffff;
                                strength: root.left-collapsed ? 0 : (lta.has-hover ? 0.75 : 0.3);
                            }
                        }
                    }
                }

                // Drag fill — stretch spacer pushes the caption buttons to the right.
                Rectangle { horizontal-stretch: 1; }

                // Window caption buttons (`.wc`): 44 wide, stroked glyphs, close goes
                // Windows-red on hover.
                min-btn := Rectangle {
                    width: 44px; height: 36px;
                    background: mta.has-hover ? Pal.surface : transparent;
                    mta := TouchArea { clicked => { root.minimized = true; } }
                    Path {
                        width: 15px; height: 15px;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: "M6 12h12";
                        fill: transparent; stroke: mta.has-hover ? Pal.text : Pal.text3; stroke-width: 1.6px; stroke-line-cap: round;
                    }
                }
                max-btn := Rectangle {
                    width: 44px; height: 36px;
                    background: xta.has-hover ? Pal.surface : transparent;
                    xta := TouchArea { clicked => { root.maximized = !root.maximized; } }
                    // Maximize = one square; restore = two offset squares (drawn, not
                    // typed — the restore glyph is absent from most UI fonts).
                    Path {
                        width: 14px; height: 14px;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: root.maximized
                            ? "M8.5 5.5h8.5a1.5 1.5 0 0 1 1.5 1.5v8.5M5.5 8.5h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z"
                            : "M7 5.5h10a1.5 1.5 0 0 1 1.5 1.5v10a1.5 1.5 0 0 1-1.5 1.5H7a1.5 1.5 0 0 1-1.5-1.5V7A1.5 1.5 0 0 1 7 5.5z";
                        fill: transparent; stroke: xta.has-hover ? Pal.text : Pal.text3; stroke-width: 1.6px;
                    }
                }
                // Mini-player toggle (#btn-miniplayer): enters the last-used mini layout
                // (picture-in-picture glyph: outline frame + small filled inner rect).
                mini-btn := Rectangle {
                    width: 44px; height: 36px;
                    background: pipta.has-hover ? Pal.surface : transparent;
                    pipta := TouchArea { clicked => { root.set-mini-mode(root.mini-last); } }
                    Path {
                        width: 17px; height: 17px;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: "M5.5 5.5h13a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2z";
                        fill: transparent; stroke: pipta.has-hover ? Pal.text : Pal.text3; stroke-width: 1.6px;
                    }
                    Rectangle {
                        width: 17px * 7 / 24; height: 17px * 5 / 24; border-radius: 1px;
                        x: (parent.width - 17px)/2 + 17px * 11.5 / 24;
                        y: (parent.height - 17px)/2 + 17px * 11 / 24;
                        background: pipta.has-hover ? Pal.text : Pal.text3;
                    }
                }
                close-btn := Rectangle {
                    width: 46px; height: 36px;
                    background: cta.has-hover ? #c42b1c : transparent;
                    cta := TouchArea { clicked => { root.close-clicked(); } }
                    Path {
                        width: 15px; height: 15px;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: Icons.close;
                        fill: transparent; stroke: cta.has-hover ? #ffffff : Pal.text3; stroke-width: 1.6px; stroke-line-cap: round;
                    }
                }
            }
            // bottom border
            Rectangle { y: parent.height - 1px; height: 1px; background: #161616; }
        }

        // ── Body ─────────────────────────────────────────────────────────────
        if root.mini-mode == "off" : HorizontalLayout {
            spacing: 0;

            // The Spotify panels and the Local library, cross-fading (`local-fade`). The
            // drawer and the footer are shared by both.
            Rectangle {
                horizontal-stretch: 1;
                Rectangle {
                    opacity: 1 - root.local-fade;
                    visible: root.local-fade < 0.999;
                    HorizontalLayout {
                        spacing: 0;
            // Left panel (collapsible via the titlebar wordmark).
            Rectangle {
                width: root.left-collapsed ? 0px : 288px;
                background: Pal.panel;
                clip: true;
                // Always slides (see Motion.slide) — never snaps open or shut.
                animate width { duration: Motion.slide; easing: cubic-bezier(0.22, 0.85, 0.28, 1); }
                VerticalLayout {
                    // Pinned to the panel's full width and to its RIGHT edge, so while it
                    // narrows the content slides out to the left instead of squashing.
                    width: 288px;
                    x: parent.width - 288px;
                    // Tabs: the segmented Library / Search / Beatport control.
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px; padding-top: 10px;
                        SegTrack {
                            height: 40px;
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 2px;
                                TabBtn { label: "Library"; cmds: Icons.library; active: root.tab == 0; clicked => { root.select-tab(0); } }
                                TabBtn { label: "Search"; cmds: Icons.search; active: root.tab == 1; clicked => { root.select-tab(1); } }
                                TabBtn { label: "Beatport"; cmds: Icons.charts; active: root.tab == 2; clicked => { root.select-tab(2); } }
                            }
                        }
                    }
                    // Library list (or, when drilled, the track list with a Back bar).
                    if root.tab == 0 && !root.drilled : LibraryToolbar {
                        kicker: "// library \u{00B7} " + root.playlists.length;
                        mode: root.lib-sort-mode;
                        dir: root.lib-sort-dir;
                        recent-clicked => { root.sort-recent(); }
                        alpha-clicked => { root.sort-alpha(); }
                    }
                    if root.tab == 0 && !root.drilled : ListView {
                        vertical-stretch: 1;
                        for pl[i] in root.playlists : ListRow {
                            art: root.playlist-art[i];
                            name: pl.name;
                            sub: pl.sub;
                            active: pl.active;
                            playing: pl.playing;
                            liked: pl.liked;
                            clicked => { root.open-row(i); }
                            double-clicked => { root.play-row(i); }
                            menu(mx, my) => {
                                root.ctx-x = mx;
                                root.ctx-y = my;
                                root.open-context(0, i);
                            }
                        }
                    }
                    if root.tab == 0 && root.drilled : VerticalLayout {
                        vertical-stretch: 1;
                        // Back button + drilled title (`// tracks` kicker below).
                        Rectangle {
                            height: 46px;
                            // No `alignment` here on purpose: `alignment: start` sizes
                            // children to their content and ignores stretch, so the
                            // title had nothing to elide against and a long playlist
                            // name ran straight off the panel.
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 14px;
                                padding-top: 6px;
                                spacing: 6px;
                                // Wrapped so the layout cannot stretch the button to the
                                // bar height (a layout child's `height` is only preferred).
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    IconBtn {
                                        cmds: Icons.back; stroked: true; icon: 18px; box: 34px;
                                        clicked => { root.back-clicked(); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: root.drill-title; color: Pal.text; font-size: 15px; font-weight: 700; overflow: elide; }
                                }
                            }
                        }
                        LibraryToolbar {
                            kicker: "// tracks";
                            mode: root.lib-sort-mode;
                            dir: root.lib-sort-dir;
                            recent-clicked => { root.sort-recent(); }
                            alpha-clicked => { root.sort-alpha(); }
                        }
                        if root.tracks.length > 0 : trklist := ListView {
                            vertical-stretch: 1;
                            // Hold-to-select drag (`RowTouch`): the pointer's y inside the
                            // visible list, and an auto-scroll while it sits near an edge.
                            property <bool> dsel: false;
                            property <length> dvis;
                            function dmove(content-y: length) {
                                trklist.dvis = content-y + trklist.viewport-y;
                                root.sel-drag-move(1, content-y);
                            }
                            // Ticked by the dragging row (`RowTouch.hold-tick`) while the drag is
                            // live: scroll when the pointer sits near an edge.
                            function dtick() {
                                if (trklist.dvis < 36px || trklist.dvis > trklist.visible-height - 36px) {
                                    if (trklist.dvis < 36px) {
                                        trklist.viewport-y = min(0px, trklist.viewport-y + 16px);
                                    } else {
                                        trklist.viewport-y = max(min(0px, trklist.visible-height - trklist.viewport-height), trklist.viewport-y - 16px);
                                    }
                                    root.sel-drag-move(1, trklist.dvis - trklist.viewport-y);
                                }
                            }
                            // `nearTrackListBottom()` — the original's 320px threshold.
                            // viewport-y is negative as the list scrolls down.
                            function check-more() {
                                if (root.tracks-more
                                    && -trklist.viewport-y + trklist.visible-height
                                        >= trklist.viewport-height - 320px) {
                                    root.tracks-more = false;
                                    root.load-more-tracks();
                                }
                            }
                            changed viewport-y => { trklist.check-more(); }
                            // A page that doesn't fill the viewport must pull the next
                            // one straight away — the original re-fires from its own
                            // requestAnimationFrame for exactly this case. The gate
                            // reopening is the signal that a page just landed.
                            property <bool> more: root.tracks-more;
                            changed more => { trklist.check-more(); }
                            for t[i] in root.tracks : TrackRow {
                                has-selection: root.sel-count > 0;
                                clear-sel => { root.clear-selection(); }
                                hold-begin => { trklist.dsel = true; root.sel-drag-begin(1, i); }
                                hold-move(y) => { trklist.dmove(y); }
                                hold-tick => { trklist.dtick(); }
                                hold-end => { trklist.dsel = false; root.sel-drag-end(); }
                                name: t.name;
                                artist: t.artist;
                                playable: t.playable;
                                active: t.active;
                                playing: t.playing;
                                selected: t.selected;
                                clicked => { root.play-track(i); }
                                double-clicked => { root.clear-selection(); }
                                menu(mx, my) => {
                                    root.ctx-x = mx;
                                    root.ctx-y = my;
                                    root.open-context(1, i);
                                }
                                select-click(ctrl, shift) => { root.select-click(1, i, ctrl, shift); }
                            }
                        }
                        if root.tracks.length == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: start;
                            padding-top: 14px;
                            Text {
                                text: "No tracks to show";
                                color: Pal.text3;
                                font-size: 11px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Search view.
                    if root.tab == 1 : VerticalLayout {
                        vertical-stretch: 1;
                        Rectangle {
                            height: 54px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; padding-top: 12px; padding-bottom: 2px;
                                Rectangle {
                                    border-radius: 12px;
                                    border-width: 1px;
                                    border-color: si.has-focus ? Pal.border-strong : Pal.border-hi;
                                    background: Pal.card;
                                    Path {
                                        x: 12px; y: (parent.height - self.height) / 2;
                                        width: 16px; height: 16px;
                                        viewbox-width: 24; viewbox-height: 24;
                                        commands: Icons.search;
                                        fill: transparent; stroke: Pal.text3; stroke-width: 1.7px; stroke-line-cap: round;
                                    }
                                    HorizontalLayout {
                                        padding-left: 38px;
                                        padding-right: 12px;
                                        si := TextInput {
                                            vertical-alignment: center;
                                            color: Pal.text;
                                            font-size: 13.5px;
                                            font-weight: 500;
                                            single-line: true;
                                            text: root.search-text;
                                            edited => { root.search-text = self.text; root.query-changed(self.text); }
                                            key-pressed(e) => {
                                                if ((e.modifiers.control || e.modifiers.meta) && e.text == "k") {
                                                    root.toggle-palette();
                                                    return accept;
                                                }
                                                // Enter opens the top result; Esc clears the box.
                                                if (e.text == Key.Return && self.text != "") {
                                                    root.search-enter();
                                                    return accept;
                                                }
                                                if (e.text == Key.Escape && self.text != "") {
                                                    self.text = "";
                                                    root.search-text = "";
                                                    root.query-changed("");
                                                    return accept;
                                                }
                                                return reject;
                                            }
                                        }
                                    }
                                    if si.text == "" : Text {
                                        text: "What do you want to hear?";
                                        color: Pal.text3; font-size: 13.5px;
                                        x: 38px; y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 8px; padding-top: 10px; padding-bottom: 8px;
                                FilterBar {
                                    active: root.search-filter == "tracks" ? 1
                                          : root.search-filter == "artists" ? 2
                                          : root.search-filter == "albums" ? 3
                                          : root.search-filter == "playlists" ? 4
                                          : 0;
                                    pick(i) => {
                                        root.set-search-filter(
                                            i == 1 ? "tracks"
                                          : i == 2 ? "artists"
                                          : i == 3 ? "albums"
                                          : i == 4 ? "playlists"
                                          : "all");
                                    }
                                }
                            }
                        }
                        // `#btn-search-back` — only while drilled, like the original.
                        if root.search-drilled : Rectangle {
                            height: 40px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 14px;
                                spacing: 6px;
                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    alignment: center;
                                    IconBtn {
                                        cmds: Icons.back; stroked: true; icon: 18px; box: 34px;
                                        clicked => { root.search-back(); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: root.search-drill-title;
                                        color: Pal.text; font-size: 15px; font-weight: 700;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        if root.search-drilled : sdlist := ListView {
                            vertical-stretch: 1;
                            // Hold-to-select drag (`RowTouch`): the pointer's y inside the
                            // visible list, and an auto-scroll while it sits near an edge.
                            property <bool> dsel: false;
                            property <length> dvis;
                            function dmove(content-y: length) {
                                sdlist.dvis = content-y + sdlist.viewport-y;
                                root.sel-drag-move(5, content-y);
                            }
                            // Ticked by the dragging row (`RowTouch.hold-tick`) while the drag is
                            // live: scroll when the pointer sits near an edge.
                            function dtick() {
                                if (sdlist.dvis < 36px || sdlist.dvis > sdlist.visible-height - 36px) {
                                    if (sdlist.dvis < 36px) {
                                        sdlist.viewport-y = min(0px, sdlist.viewport-y + 16px);
                                    } else {
                                        sdlist.viewport-y = max(min(0px, sdlist.visible-height - sdlist.viewport-height), sdlist.viewport-y - 16px);
                                    }
                                    root.sel-drag-move(5, sdlist.dvis - sdlist.viewport-y);
                                }
                            }
                            function check-more() {
                                if (root.search-tracks-more
                                    && -sdlist.viewport-y + sdlist.visible-height
                                        >= sdlist.viewport-height - 320px) {
                                    root.search-tracks-more = false;
                                    root.load-more-search-tracks();
                                }
                            }
                            changed viewport-y => { sdlist.check-more(); }
                            property <bool> more: root.search-tracks-more;
                            changed more => { sdlist.check-more(); }
                            for t[i] in root.search-tracks : TrackRow {
                                has-selection: root.sel-count > 0;
                                clear-sel => { root.clear-selection(); }
                                hold-begin => { sdlist.dsel = true; root.sel-drag-begin(5, i); }
                                hold-move(y) => { sdlist.dmove(y); }
                                hold-tick => { sdlist.dtick(); }
                                hold-end => { sdlist.dsel = false; root.sel-drag-end(); }
                                name: t.name;
                                artist: t.artist;
                                playable: t.playable;
                                active: t.active;
                                playing: t.playing;
                                selected: t.selected;
                                clicked => { root.play-search-track(i); }
                                double-clicked => { root.clear-selection(); }
                                menu(mx, my) => {
                                    root.ctx-x = mx;
                                    root.ctx-y = my;
                                    root.open-context(5, i);
                                }
                                select-click(ctrl, shift) => { root.select-click(5, i, ctrl, shift); }
                            }
                        }
                        if root.search-drilled && root.search-tracks.length == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: start;
                            padding-top: 14px;
                            Text {
                                text: "No tracks to show";
                                color: Pal.text3;
                                font-size: 11px;
                                horizontal-alignment: center;
                            }
                        }
                        // Empty states (UI-PLAN search rework): searching, no results, and
                        // an empty box with no recent searches yet.
                        if !root.search-drilled && root.search-results.length == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: start;
                            padding-top: Space.xl;
                            padding-left: Space.l;
                            padding-right: Space.l;
                            spacing: Space.xs;
                            Text {
                                text: root.search-loading ? "Searching\u{2026}"
                                    : root.search-text == "" ? "Search Spotify"
                                    : "No results for \u{201c}" + root.search-text + "\u{201d}";
                                color: Pal.text2;
                                font-size: TypeScale.body;
                                font-weight: 600;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            if !root.search-loading : Text {
                                text: root.search-text == ""
                                    ? "Songs, artists, albums and playlists. Your recent searches will show up here."
                                    : "Check the spelling, or try fewer or different words.";
                                color: Pal.text3;
                                font-size: TypeScale.caption;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        if !root.search-drilled : srlist := ListView {
                            vertical-stretch: 1;
                            // Hold-to-select drag (`RowTouch`): the pointer's y inside the
                            // visible list, and an auto-scroll while it sits near an edge.
                            property <bool> dsel: false;
                            property <length> dvis;
                            function dmove(content-y: length) {
                                srlist.dvis = content-y + srlist.viewport-y;
                                root.sel-drag-move(2, content-y);
                            }
                            // Ticked by the dragging row (`RowTouch.hold-tick`) while the drag is
                            // live: scroll when the pointer sits near an edge.
                            function dtick() {
                                if (srlist.dvis < 36px || srlist.dvis > srlist.visible-height - 36px) {
                                    if (srlist.dvis < 36px) {
                                        srlist.viewport-y = min(0px, srlist.viewport-y + 16px);
                                    } else {
                                        srlist.viewport-y = max(min(0px, srlist.visible-height - srlist.viewport-height), srlist.viewport-y - 16px);
                                    }
                                    root.sel-drag-move(2, srlist.dvis - srlist.viewport-y);
                                }
                            }
                            // `nearSearchResultsBottom()` — the original's 220px threshold.
                            function check-more() {
                                if (root.search-more
                                    && -srlist.viewport-y + srlist.visible-height
                                        >= srlist.viewport-height - 220px) {
                                    root.search-more = false;
                                    root.load-more-search-results();
                                }
                            }
                            changed viewport-y => { srlist.check-more(); }
                            property <bool> more: root.search-more;
                            changed more => { srlist.check-more(); }
                            for r[i] in root.search-results : SearchResultRow {
                                has-selection: root.sel-count > 0;
                                clear-sel => { root.clear-selection(); }
                                hold-begin => { srlist.dsel = true; root.sel-drag-begin(2, i); }
                                hold-move(y) => { srlist.dmove(y); }
                                hold-tick => { srlist.dtick(); }
                                hold-end => { srlist.dsel = false; root.sel-drag-end(); }
                                name: r.name;
                                sub: r.sub;
                                kind: r.kind;
                                meta: r.meta;
                                art: root.search-art[i];
                                selectable: r.kind == "track";
                                selected: r.selected;
                                clicked => { root.open-search(i); }
                                menu(mx, my) => {
                                    root.ctx-x = mx;
                                    root.ctx-y = my;
                                    root.open-context(2, i);
                                }
                                select-click(ctrl, shift) => { root.select-click(2, i, ctrl, shift); }
                            }
                        }
                    }

                    // Beatport charts — genre picker + chart mode + scraped Top 100.
                    if root.tab == 2 : VerticalLayout {
                        vertical-stretch: 1;
                        // Genre trigger (label + caret) → toggles the genre picker list.
                        Rectangle {
                            height: 50px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; padding-top: 12px; padding-bottom: 4px;
                                Rectangle {
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.bp-genre-open ? Pal.accent : Pal.border-hi;
                                    background: gta.has-hover ? Pal.surface2 : Pal.surface;
                                    gta := TouchArea { clicked => { root.bp-toggle-genre(); } }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: root.bp-genre-label; color: Pal.text; font-size: 12px; overflow: elide; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: root.bp-genre-open ? "\u{25B4}" : "\u{25BE}"; color: Pal.text3; font-size: TypeScale.caption; }
                                        }
                                    }
                                }
                            }
                        }
                        // Chart-mode cluster — icon-only, 3 equal columns (`.bp-mode-cluster`
                        // is a `grid-template-columns: repeat(3, minmax(0,1fr))`, gap 8px).
                        Rectangle {
                            height: 42px;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 8px;
                                BpModeIconBtn {
                                    horizontal-stretch: 1;
                                    icon: @image-url("icons/beatport-tracks.png");
                                    active: root.bp-kind == "tracks";
                                    clicked => { root.bp-set-mode("tracks"); }
                                }
                                BpModeIconBtn {
                                    horizontal-stretch: 1;
                                    icon: @image-url("icons/beatport-hype.png");
                                    active: root.bp-kind == "hype";
                                    clicked => { root.bp-set-mode("hype"); }
                                }
                                BpModeIconBtn {
                                    horizontal-stretch: 1;
                                    icon: @image-url("icons/beatport-releases.png");
                                    active: root.bp-kind == "releases";
                                    clicked => { root.bp-set-mode("releases"); }
                                }
                            }
                        }
                        // Genre picker (when open) OR the chart rows.
                        if root.bp-genre-open : ListView {
                            vertical-stretch: 1;
                            for g[i] in root.bp-genres : Rectangle {
                                height: 32px;
                                background: gopt.has-hover ? Pal.surface : (i == root.bp-genre-idx ? #ffffff0a : transparent);
                                gopt := TouchArea { clicked => { root.bp-select-genre(i); } }
                                Rectangle {
                                    x: 0; width: 2px; height: parent.height;
                                    background: i == root.bp-genre-idx ? Pal.accent : transparent;
                                }
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: g;
                                            color: i == root.bp-genre-idx ? Pal.accent : Pal.text;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                        if !root.bp-genre-open && root.bp-rows.length > 0 : bplist := ListView {
                            vertical-stretch: 1;
                            // Hold-to-select drag (`RowTouch`): the pointer's y inside the
                            // visible list, and an auto-scroll while it sits near an edge.
                            property <bool> dsel: false;
                            property <length> dvis;
                            function dmove(content-y: length) {
                                bplist.dvis = content-y + bplist.viewport-y;
                                root.sel-drag-move(3, content-y);
                            }
                            // Ticked by the dragging row (`RowTouch.hold-tick`) while the drag is
                            // live: scroll when the pointer sits near an edge.
                            function dtick() {
                                if (bplist.dvis < 36px || bplist.dvis > bplist.visible-height - 36px) {
                                    if (bplist.dvis < 36px) {
                                        bplist.viewport-y = min(0px, bplist.viewport-y + 16px);
                                    } else {
                                        bplist.viewport-y = max(min(0px, bplist.visible-height - bplist.viewport-height), bplist.viewport-y - 16px);
                                    }
                                    root.sel-drag-move(3, bplist.dvis - bplist.viewport-y);
                                }
                            }
                            for r[i] in root.bp-rows : BpRow {
                                has-selection: root.sel-count > 0;
                                clear-sel => { root.clear-selection(); }
                                hold-begin => { bplist.dsel = true; root.sel-drag-begin(3, i); }
                                hold-move(y) => { bplist.dmove(y); }
                                hold-tick => { bplist.dtick(); }
                                hold-end => { bplist.dsel = false; root.sel-drag-end(); }
                                title: r.title;
                                sub: r.sub;
                                selected: r.selected;
                                clicked => { root.bp-play(i); }
                                menu(mx, my) => {
                                    root.ctx-x = mx;
                                    root.ctx-y = my;
                                    root.open-context(3, i);
                                }
                                select-click(ctrl, shift) => { root.select-click(3, i, ctrl, shift); }
                            }
                        }
                        // `.bp-actions`: Select all + Create playlist, above the status line.
                        if !root.bp-genre-open && root.bp-rows.length > 0 : Rectangle {
                            height: 34px;
                            Rectangle { y: 0; height: 1px; background: Pal.border; }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 8px;
                                ActionBtn {
                                    label: "Select all";
                                    clicked => { root.bp-select-all(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ActionBtn {
                                    label: "Create playlist";
                                    pad: 12px;
                                    enabled: root.sel-count > 0;
                                    clicked => { root.bp-create-playlist(); }
                                }
                            }
                        }
                        if !root.bp-genre-open && root.bp-rows.length == 0 : Rectangle {
                            vertical-stretch: 1;
                        }
                        // Status line (loading / count / errors) + open-in-browser fallback.
                        Rectangle {
                            height: 34px;
                            Rectangle { y: 0; height: 1px; background: Pal.border; }
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 8px; spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: root.bp-status; color: Pal.text3; font-size: TypeScale.caption; overflow: elide; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 22px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: Pal.border;
                                        background: obta.has-hover ? Pal.surface : transparent;
                                        obta := TouchArea { clicked => { root.bp-open-external(); } }
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            Text {
                                                text: "OPEN \u{2197}";
                                                vertical-alignment: center;
                                                color: obta.has-hover ? Pal.text : Pal.text2;
                                                font-size: TypeScale.micro;
                                                font-weight: 700;
                                                letter-spacing: 0.4px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // Type-to-filter pill (D7): what's being filtered and how many match.
                if root.list-filter != "" && root.tab == 0 : Rectangle {
                    x: Space.s;
                    y: parent.height - self.height - Space.s;
                    width: 288px - 2 * Space.s;
                    height: 32px;
                    border-radius: 16px;
                    background: Pal.surface2;
                    border-width: 1px;
                    border-color: Pal.accent.with-alpha(0.45);
                    TouchArea { }   // clicks on the pill don't fall through to a row
                    HorizontalLayout {
                        padding-left: Space.m;
                        padding-right: Space.xs;
                        spacing: Space.s;
                        Path {
                            width: 13px; height: 13px;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24; viewbox-height: 24;
                            fill: transparent; stroke: Pal.accent; stroke-width: 2.2px;
                            commands: "M10.5 17a6.5 6.5 0 110-13 6.5 6.5 0 010 13zM15.5 15.5L20 20";
                        }
                        Text {
                            text: root.list-filter;
                            color: Pal.text;
                            font-size: TypeScale.small;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.list-filter-count < 0 ? "" : (root.list-filter-count == 1 ? "1 match" : root.list-filter-count + " matches");
                            color: root.list-filter-count == 0 ? Pal.danger : Pal.text3;
                            font-size: TypeScale.caption;
                            vertical-alignment: center;
                        }
                        IconBtn {
                            box: 24px; icon: 12px;
                            y: (parent.height - self.height) / 2;
                            cmds: "M18.3 5.71L12 12.01 5.7 5.71 4.29 7.12l6.3 6.3-6.3 6.29 1.41 1.41 6.3-6.29 6.29 6.29 1.42-1.41-6.3-6.29 6.3-6.3z";
                            clicked => { root.list-filter = ""; root.list-filter-edited(""); }
                        }
                    }
                }
                // right border
                Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Pal.border; }
            }

            // Right panel — now playing
            npane := Rectangle {
                background: Pal.bg;
                horizontal-stretch: 1;
                clip: true;
                // Now-playing scales with the pane (UI-PLAN A3). `art-size` follows the
                // smaller of the pane's width and its height left over for the controls;
                // `k` runs 0 → 1 from the classic 236px cluster (unchanged at the
                // default 980×660) to the largest, and every other size eases with it.
                // Set from change handlers, not a binding: the art is part of this pane's
                // own size request, so a binding on the pane's (or window's) size would be
                // a layout binding loop.
                property <length> art-size: 236px;
                // Grows past 236px with room (as before); below it only when the height
                // can't fit the classic cluster — down to 96px — so a short window keeps
                // every control (and the footer below this pane) on screen instead of
                // pushing the footer out of the window. 300px ≈ everything but the art at
                // full spacing; the spacing itself tightens as the art shrinks (`c`).
                function fit-art() {
                    self.art-size = clamp(
                        max(min(236px, self.height - 300px), min(self.width * 0.34, self.height - 390px)),
                        96px, 420px);
                }
                init => { self.fit-art(); }
                changed width => { self.fit-art(); }
                changed height => { self.fit-art(); }
                property <float> k: max(0, (self.art-size - 236px) / 184px);
                // 1 at the classic size and up, 0 at the smallest: tightens the gaps.
                property <float> c: clamp((self.art-size - 96px) / 140px, 0, 1);
                // Clicking the centre pane — but never a control — dismisses an open
                // overlay: the RIGHT sidebar first, then the LEFT panel on a second
                // click. Ports the `#now-playing` click handler (`app.js:1659`).
                // Declared first so every control's own TouchArea sits above it and
                // takes its clicks, which is what the original's `closest(...)`
                // exclusion list does by hand.
                // A double-click toggles the expanded cover — unless that double-click's
                // clicks were spent closing sidebars (`pane-double-click`).
                // A right-click here (on the lava, never a control) opens the backdrop
                // menu: the screensaver.
                npta := TouchArea {
                    clicked => { root.pane-click(); }
                    double-clicked => { root.pane-double-click(); }
                    pointer-event(e) => {
                        if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                            root.ctx-x = npta.absolute-position.x + npta.mouse-x;
                            root.ctx-y = npta.absolute-position.y + npta.mouse-y;
                            root.open-context(11, 0);
                        }
                    }
                }
                // The ASCII lava (local_backdrop.rs), drawn by the host at this pane's size
                // while Spotify plays. Its frames carry the glow below (`np-glow-baked`).
                LocalBackdrop { frame: root.np-bg; sized(w, h) => { root.np-bg-w = w; root.np-bg-h = h; } }
                // Album-colour glow halo behind the art (radial gradient — the software
                // renderer has no drop-shadow, so we paint the glow explicitly).
                //
                // Centred on the ARTWORK, not on the pane. It used to sit at a constant
                // `y: -110px`, so resizing the window moved the art (it is centred in a
                // stretching layout) while the glow stayed where it was. The +12px drop
                // matches the offset of the box-shadow this replaces
                // (`0 12px 46px -8px var(--accent-dynamic-soft)`).
                // Horizontally the cover is always centred in the pane, so the glow is
                // too — `absolute-position.x` is stale on the first frame after the pane
                // is resized by a panel, which parked the glow off to one side.
                Rectangle {
                    width: npane.art-size * 2.63;
                    height: self.width;
                    x: (npane.width - self.width) / 2;
                    y: art.absolute-position.y - npane.absolute-position.y + (art.height - self.height) / 2 + 12px;
                    background: @radial-gradient(circle, root.glow 0%, transparent 60%);
                    opacity: 1 - root.art-expand;
                    // Not just transparent once the cover is fully out: not drawn at all.
                    // Nor while the lava draws this same glow into its frames.
                    visible: root.art-expand < 0.999 && !root.np-glow-baked;
                    init => { root.np-glow-x = self.x + self.width / 2; root.np-glow-y = self.y + self.height / 2; root.np-glow-d = self.width; }
                    changed x => { root.np-glow-x = self.x + self.width / 2; }
                    changed y => { root.np-glow-y = self.y + self.height / 2; }
                    changed width => { root.np-glow-x = self.x + self.width / 2; root.np-glow-y = self.y + self.height / 2; root.np-glow-d = self.width; }
                }
                // ── Expanded cover ──────────────────────────────────────────────
                // Grows out of the cover's own box to the whole pane (geometry eased by
                // `art-expand`), behind the controls, with a dark fade toward the bottom
                // so the title, seek bar and buttons stay readable on bright art.
                if root.art-expand > 0.001 : Rectangle {
                    property <length> ax: (npane.width - art.width) / 2;
                    property <length> ay: art.absolute-position.y - npane.absolute-position.y;
                    x: self.ax * (1 - root.art-expand);
                    y: self.ay * (1 - root.art-expand);
                    width: art.width + (npane.width - art.width) * root.art-expand;
                    height: art.height + (npane.height - art.height) * root.art-expand;
                    border-radius: 14px * (1 - root.art-expand);
                    clip: true;
                    background: @linear-gradient(145deg, #2b3a44 0%, #17242b 55%, #101a1f 100%);
                    if root.prev-art.width > 0 : Image {
                        source: root.prev-art;
                        width: 100%; height: 100%;
                        image-fit: cover;
                    }
                    Image {
                        source: root.album-art;
                        width: 100%; height: 100%;
                        image-fit: cover;
                        opacity: root.art-fade;
                    }
                    // Edge vignette, centred a little above the middle (the box is
                    // taller than the pane and shifted up so its centre sits at 38%).
                    // Radial gradients are shaded per pixel, so inner stops are safe.
                    Rectangle {
                        y: -parent.height * 0.24;
                        height: parent.height * 1.24;
                        opacity: root.art-expand;
                        background: @radial-gradient(circle, #0a0a0a00 0%, #0a0a0a00 50%, #0a0a0a99 100%);
                    }
                    // Fade under the controls: ONE two-stop ramp over the lower 66%.
                    // The software renderer paints each pair of linear stops as its own
                    // strip, and the strips' edges showed up as thin dark lines — so no
                    // inner stops here.
                    Rectangle {
                        y: parent.height * 0.34;
                        height: parent.height * 0.66;
                        opacity: root.art-expand;
                        background: @linear-gradient(180deg, #0a0a0a00 0%, #0a0a0ae6 100%);
                    }
                    fullta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pane-click(); }
                        double-clicked => { root.pane-double-click(); }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                root.ctx-x = fullta.absolute-position.x + fullta.mouse-x;
                                root.ctx-y = fullta.absolute-position.y + fullta.mouse-y;
                                root.open-context(6, 0);
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    padding: 12px + 12px * npane.c;
                    spacing: 8px + 6px * npane.c + 8px * npane.k;

                    // Album art with the extracted album-colour glow (dynamic drop-shadow).
                    HorizontalLayout {
                        alignment: center;
                        art := Rectangle {
                            width: npane.art-size; height: npane.art-size; border-radius: 12px + 2px * npane.k;
                            clip: true;
                            // A hairline inner ring, as on the mockup's cover.
                            border-width: 1px;
                            border-color: #ffffff10;
                            background: @linear-gradient(145deg, #2b3a44 0%, #17242b 55%, #101a1f 100%);
                            // While expanded, the full-pane layer stands in for it; the box
                            // stays in the layout so nothing below moves. Fully out, it is
                            // not drawn at all (its 1px frame and edges would otherwise
                            // still be rasterised at ~0 opacity, just above the title) —
                            // clicks then reach the expanded layer, which does the same.
                            opacity: 1 - root.art-expand;
                            visible: root.art-expand < 0.999;
                            // `showCurrentTrackContextMenu` is bound to the album art
                            // AND the track info in the original; both open the same menu.
                            artta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.pane-click(); }
                                double-clicked => { root.pane-double-click(); }
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                        root.ctx-x = artta.absolute-position.x + artta.mouse-x;
                                        root.ctx-y = artta.absolute-position.y + artta.mouse-y;
                                        root.open-context(6, 0);
                                    }
                                }
                            }
                            if root.prev-art.width > 0 : Image {
                                source: root.prev-art;
                                width: 100%;
                                height: 100%;
                                image-fit: cover;
                            }
                            Image {
                                source: root.album-art;
                                width: 100%;
                                height: 100%;
                                image-fit: cover;
                                opacity: root.art-fade;
                            }
                            // No cover loaded: the Lightify mark, dimmed into the placeholder
                            // gradient (UI-PLAN A8), instead of a generic note glyph.
                            if root.album-art.width == 0 : Image {
                                source: @image-url("../assets/lightify-icon.png");
                                width: parent.width * 0.34; height: self.width;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                opacity: 0.28;
                            }
                        }
                    }

                    // Title / artist
                    Rectangle {
                        height: 48px + 16px * npane.k;
                        infota := TouchArea {
                            clicked => { root.pane-click(); }
                            double-clicked => { root.pane-double-click(); }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                    root.ctx-x = infota.absolute-position.x + infota.mouse-x;
                                    root.ctx-y = infota.absolute-position.y + infota.mouse-y;
                                    root.open-context(6, 0);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px + 2px * npane.k;
                            // Idle ("—" + "Nothing playing" from the host) reads as a title and a
                            // hint instead of a lone dash (UI-PLAN A7).
                            property <bool> idle: root.track-name == "\u{2014}" && root.track-artist == "Nothing playing";
                            Text { text: parent.idle ? "Nothing playing" : root.track-name; color: parent.idle ? Pal.text2 : Pal.text; font-size: 19px + 9px * npane.k; font-weight: 700; letter-spacing: -0.3px; horizontal-alignment: center; overflow: elide; }
                            Text { text: parent.idle ? "Pick a playlist or a song to start" : root.track-artist; color: parent.idle ? Pal.text3 : Pal.text2; font-size: 13px + 2px * npane.k; horizontal-alignment: center; overflow: elide; }
                        }
                    }

                    // Progress
                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        Text { text: root.elapsed; color: Pal.text3; font-size: 11px; vertical-alignment: center; font-family: Fonts.mono; min-width: 32px; horizontal-alignment: right; }
                        VerticalLayout {
                            alignment: center;
                            // Taller invisible hit area around the 3px bar → click / drag to seek.
                            // Preferred, not fixed: with both panels open the pane can be
                            // narrower than the bar, and a fixed width there squeezed the
                            // drawer instead (the pane's minimum width won).
                            pbar := Rectangle {
                                preferred-width: 320px + 200px * npane.k;
                                min-width: 120px;
                                height: 14px;
                                property <float> shown: root.scrubbing-progress ? root.scrub-progress : root.progress;
                                pseek := TouchArea {
                                    moved => {
                                        if (self.pressed) {
                                            root.scrub-progress = clamp(self.mouse-x / pbar.width, 0.0, 1.0);
                                            root.scrubbing-progress = true;
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            root.scrub-progress = clamp(self.mouse-x / pbar.width, 0.0, 1.0);
                                            root.scrubbing-progress = true;
                                        }
                                        if (ev.kind == PointerEventKind.up) {
                                            root.seek(root.scrub-progress);
                                            root.scrubbing-progress = false;
                                        }
                                    }
                                }
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width; height: 4px; border-radius: 2px; background: Pal.border-hi;
                                    Rectangle { x: 0; height: parent.height; width: parent.width * pbar.shown; border-radius: 2px; background: Pal.accent; }
                                }
                                Rectangle {
                                    width: pseek.has-hover || root.scrubbing-progress ? 14px : 12px;
                                    height: self.width; border-radius: self.width / 2; background: Pal.text;
                                    x: pbar.width * pbar.shown - self.width / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        Text { text: root.duration; color: Pal.text3; font-size: 11px; vertical-alignment: center; font-family: Fonts.mono; min-width: 32px; }
                    }

                    // Transport controls
                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px + 6px * npane.k;
                        VerticalLayout { alignment: center; IconBtn { cmds: Icons.shuffle; stroked: true; icon: 18px + 2px * npane.k; box: 36px + 4px * npane.k; is-active: root.shuffle-on; clicked => { root.toggle-shuffle(); } } }
                        VerticalLayout { alignment: center; IconBtn { cmds: Icons.prev; stroked: true; fill-too: true; tint: Pal.text; icon: 21px + 3px * npane.k; box: 42px + 4px * npane.k; clicked => { root.prev-clicked(); } } }
                        // Play / pause — accent circle (colour follows the cover; hover
                        // brightens off that live colour).
                        play := Rectangle {
                            width: 54px + 8px * npane.k; height: self.width; border-radius: self.width / 2;
                            background: pta.pressed ? Pal.accent.darker(0.15) : (pta.has-hover ? Pal.accent.brighter(0.2) : Pal.accent);
                            animate background { duration: 150ms; }
                            pta := TouchArea { clicked => { root.toggle-play(); } }
                            Path {
                                width: 23px + 3px * npane.k; height: self.width;
                                x: (parent.width - self.width)/2;
                                y: (parent.height - self.height)/2;
                                viewbox-width: 24; viewbox-height: 24;
                                fill: Pal.ink;
                                commands: root.playing ? Icons.pause : Icons.play;
                            }
                        }
                        VerticalLayout { alignment: center; IconBtn { cmds: Icons.next; stroked: true; fill-too: true; tint: Pal.text; icon: 21px + 3px * npane.k; box: 42px + 4px * npane.k; clicked => { root.next-clicked(); } } }
                        VerticalLayout { alignment: center; Rectangle {
                            width: rpt.width; height: rpt.height;
                            rpt := IconBtn { cmds: Icons.repeat; stroked: true; icon: 18px + 2px * npane.k; box: 36px + 4px * npane.k; is-active: root.repeat-mode != "off"; clicked => { root.cycle-repeat(); } }
                            // Repeat-one reads as its own state (the icon alone looked
                            // identical for repeat-all and repeat-one).
                            if root.repeat-mode == "track" : Text {
                                x: parent.width - self.width - 5px; y: 2px;
                                text: "1"; color: Pal.text; font-size: 9px; font-weight: 700; font-family: Fonts.mono;
                            }
                        } }
                    }

                    // Volume — its own centred row, as in the original layout.
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        VerticalLayout { alignment: center;
                            Path { width: 17px + 2px * npane.k; height: self.width; viewbox-width: 24; viewbox-height: 24;
                                fill: transparent; stroke: Pal.text3; stroke-width: 1.6px; stroke-line-cap: round; stroke-line-join: round;
                                commands: Icons.volume; }
                        }
                        VerticalLayout { alignment: center;
                            vbar := Rectangle {
                                width: 130px + 40px * npane.k; height: 14px;
                                property <float> shown: root.scrubbing-volume ? root.scrub-volume : root.volume;
                                vta := TouchArea {
                                    moved => {
                                        if (self.pressed) {
                                            root.scrub-volume = clamp(self.mouse-x / vbar.width, 0.0, 1.0);
                                            root.scrubbing-volume = true;
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            root.scrub-volume = clamp(self.mouse-x / vbar.width, 0.0, 1.0);
                                            root.scrubbing-volume = true;
                                        }
                                        if (ev.kind == PointerEventKind.up) {
                                            root.set-volume(root.scrub-volume);
                                            root.scrubbing-volume = false;
                                        }
                                    }
                                }
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width; height: 4px; border-radius: 2px; background: Pal.border-hi;
                                    // White fill: only the seek bar carries the accent.
                                    Rectangle { x: 0; height: parent.height; width: parent.width * vbar.shown; border-radius: 2px; background: Pal.text; }
                                }
                                if vta.has-hover || root.scrubbing-volume : Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Pal.text;
                                    x: vbar.width * vbar.shown - self.width / 2; y: (parent.height - self.height) / 2; }
                            }
                        }
                    }

                    // Extras: like / station / queue — the row under the volume.
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px + 6px * npane.k;
                        VerticalLayout { alignment: center; IconBtn {
                            cmds: Icons.heart;
                            stroked: true;
                            fill-too: root.liked-current;
                            // Unliked keeps the neutral tint; liked turns heart-pink.
                            tint: root.liked-current ? Pal.heart : Pal.text3;
                            hover-tint: Pal.heart;
                            icon: 18px + 2px * npane.k; box: 36px + 4px * npane.k;
                            opacity: root.like-pending ? 0.4 : 1.0;
                            clicked => { if (!root.like-pending) { root.toggle-like(); } }
                        } }
                        VerticalLayout { alignment: center; IconBtn {
                            stroked: true; icon: 18px + 2px * npane.k; box: 36px + 4px * npane.k;
                            cmds: Icons.station;
                            clicked => { root.start-station(); }
                        } }
                        VerticalLayout { alignment: center; IconBtn { cmds: Icons.add-queue; stroked: true; icon: 18px + 2px * npane.k; box: 36px + 4px * npane.k; clicked => { root.add-queue(); } } }
                    }
                }

            }

                    }
                }
                if root.local-fade > 0.001 : LocalView {
                    opacity: root.local-fade;
                    nodes: root.local-nodes;
                    rows: root.local-rows;
                    kicker: root.local-kicker;
                    title: root.local-title;
                    stats: root.local-stats;
                    empty: root.local-empty;
                    sort-col: root.local-sort-col;
                    sort-desc: root.local-sort-desc;
                    has-selection: root.local-sel-count > 0;
                    now-has: root.local-now-has;
                    now-title: root.local-now-title;
                    now-artist: root.local-now-artist;
                    now-cover: root.local-now-cover;
                    now-elapsed: root.local-now-elapsed;
                    now-duration: root.local-now-duration;
                    now-progress: root.local-now-progress;
                    now-playing: root.local-now-playing;
                    volume: root.local-volume;
                    shuffle: root.local-shuffle;
                    repeat: root.local-repeat;
                    drop-active: root.local-drop-active;
                    drop-detail: root.local-drop-detail;
                    carry-active: root.local-carry-active;
                    carry-label: root.local-carry-what + (root.local-drop-target >= 0 && root.local-drop-target < root.local-nodes.length
                        ? " \u{2192} " + root.local-nodes[root.local-drop-target].label : "");
                    carry-x: root.local-carry-x;
                    carry-y: root.local-carry-y;
                    drop-target <=> root.local-drop-target;
                    now-open <=> root.local-now-open;
                    now-album: root.local-now-album;
                    now-glow: root.local-now-glow;
                    win-w: root.width;
                    collapsed <=> root.left-collapsed;
                    glow-x <=> root.local-glow-x;
                    glow-y <=> root.local-glow-y;
                    glow-d <=> root.local-glow-d;
                    glow-baked: root.local-glow-baked;
                    bg: root.local-bg;
                    bg-w <=> root.local-bg-w;
                    bg-h <=> root.local-bg-h;
                    filters-open <=> root.local-filters-open;
                    flt-mode: root.local-flt-mode;
                    flt-min-text <=> root.local-flt-min-text;
                    flt-max-text <=> root.local-flt-max-text;
                    flt-min-bad: root.local-flt-min-bad;
                    flt-max-bad: root.local-flt-max-bad;
                    flt-custom: root.local-flt-custom;
                    flt-types: root.local-flt-types;
                    flt-note: root.local-flt-note;
                    flt-active: root.local-flt-active;
                    flt-set-mode(m) => { root.local-flt-set-mode(m); }
                    flt-set-len(l, t) => { root.local-flt-set-len(l, t); }
                    flt-reset => { root.local-flt-reset(); }
                    flt-toggle-type(i) => { root.local-flt-toggle-type(i); }
                    drag-begin(i) => { root.local-drag-begin(i); }
                    drag-to(i) => { root.local-drag-to(i); }
                    drag-end => { root.local-drag-end(); }
                    node-click(i) => { root.local-node-click(i); }
                    node-menu(i, mx, my) => { root.ctx-x = mx; root.ctx-y = my; root.open-context(9, i); }
                    row-activate(i) => { root.local-row-activate(i); }
                    row-select(i, c, sh) => { root.local-row-select(i, c, sh); }
                    row-clear-sel => { root.local-row-clear-sel(); }
                    row-menu(i, mx, my) => { root.ctx-x = mx; root.ctx-y = my; root.open-context(8, i); }
                    bg-menu(mx, my) => { root.ctx-x = mx; root.ctx-y = my; root.open-context(11, 0); }
                    sort(c) => { root.local-sort(c); }
                    find => { root.local-find(); }
                    rescan => { root.local-rescan(); }
                    filter-edited(t) => { root.local-filter-edited(t); }
                    toggle-play => { root.local-toggle-play(); }
                    prev => { root.local-prev(); }
                    next => { root.local-next(); }
                    seek(v) => { root.local-seek(v); }
                    set-volume(v) => { root.local-volume = v; root.local-set-volume(v); }
                    toggle-shuffle => { root.local-toggle-shuffle(); }
                    cycle-repeat => { root.local-cycle-repeat(); }
                    carry-begin(i) => { root.local-drop-target = -1; root.local-carry-active = true; root.local-carry-begin(i); }
                    carry-move(x, y) => { root.local-carry-x = x; root.local-carry-y = y; }
                    carry-end => {
                        root.local-carry-active = false;
                        root.local-carry-end(root.local-drop-target);
                        root.local-drop-target = -1;
                    }
                }
            }

            // ── Drawer (queue / recent / downloads) ─────────────────────────────
            // A column of the body, not an overlay: opening it narrows the now-playing
            // pane (which re-fits its cover) instead of covering its controls. The
            // width always slides (Motion.slide); the content is pinned at full width to
            // the drawer's left edge so it slides in rather than squashing. `shown`
            // keeps the closing mode's content on screen while the drawer slides shut.
                drawer := Rectangle {
                    property <int> mode-now: root.sidebar-mode;
                    property <int> last-mode: 1;
                    changed mode-now => { if (self.mode-now != 0) { self.last-mode = self.mode-now; } }
                    property <int> shown: root.sidebar-mode != 0 ? root.sidebar-mode : self.last-mode;
                    // QUEUE in Local mode is the Local queue (its own rows and actions).
                    property <bool> lq: root.local-mode && self.shown == 1;
                    width: root.sidebar-mode == 0 ? 0px : 300px;
                    animate width { duration: Motion.slide; easing: cubic-bezier(0.22, 0.85, 0.28, 1); }
                    clip: true;
                    background: Pal.panel;
                    VerticalLayout {
                        x: 0;
                        width: 300px;
                        // Header: title + Clear (QUEUE only) + close × — mirrors
                        // `.sidebar-header` (`padding: 8px 12px`) / `.sidebar-header-actions`
                        // (`gap: 6px`).
                        Rectangle {
                            height: 50px;
                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 8px;
                                spacing: 10px;
                                Text {
                                    text: drawer.shown == 1 ? "Queue" : drawer.shown == 2 ? "Recent" : "Downloads";
                                    color: Pal.text;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: drawer.shown == 3 ? root.sidebar-dl-rows.length : drawer.lq ? root.local-queue-rows.length : root.sidebar-rows.length;
                                    color: Pal.text3;
                                    font-size: 11px;
                                    font-family: Fonts.mono;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                // `.sidebar-clear-btn` — QUEUE resets the device queue,
                                // DOWNLOADS drops every finished row. RECENT is Spotify's
                                // own live history, so it has nothing locally clearable.
                                if drawer.shown == 1 || drawer.shown == 3 : VerticalLayout {
                                    alignment: center;
                                    ActionBtn {
                                        label: "Clear";
                                        enabled: drawer.shown != 3 || root.downloads-clearable;
                                        clicked => {
                                            if (drawer.shown == 3) { root.clear-downloads(); }
                                            else if (drawer.lq) { root.local-queue-clear(); }
                                            else { root.clear-queue(); }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconBtn {
                                        cmds: Icons.close; stroked: true; icon: 15px; box: 32px;
                                        clicked => { root.close-sidebar(); }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: #161616; }
                        }
                        // A Beatport chart lining up: what it is, how far the lookup has got.
                        if drawer.shown == 1 && !drawer.lq && root.bp-strip-title != "" : Rectangle {
                            height: 64px;
                            VerticalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 7px;
                                Text {
                                    text: root.bp-strip-title;
                                    color: Pal.text3;
                                    font-size: TypeScale.micro;
                                    font-family: Fonts.mono;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "Finding on Spotify"; color: Pal.text2; font-size: TypeScale.small; horizontal-stretch: 1; vertical-alignment: bottom; }
                                    Text { text: root.bp-strip-found; color: Pal.text; font-size: 11px; font-family: Fonts.mono; vertical-alignment: bottom; }
                                    Text { text: "/ " + root.bp-strip-total; color: Pal.faint; font-size: 11px; font-family: Fonts.mono; vertical-alignment: bottom; }
                                }
                                Rectangle {
                                    height: 3px;
                                    border-radius: 2px;
                                    background: Pal.surface2;
                                    Rectangle {
                                        x: 0;
                                        width: root.bp-strip-total > 0 ? parent.width * min(1, root.bp-strip-found / root.bp-strip-total) : 0px;
                                        border-radius: 2px;
                                        background: Pal.accent;
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: #161616; }
                        }
                        // Body: track list (QUEUE/RECENT), download list, or an empty note.
                        if drawer.shown == 3 && root.sidebar-dl-rows.length > 0 : ListView {
                            vertical-stretch: 1;
                            for d[i] in root.sidebar-dl-rows : DlTrackRow {
                                name: d.name;
                                sub: d.sub;
                                progress: d.progress;
                                state: d.state;
                                clicked => { root.sidebar-play(i); }
                                menu(mx, my) => {
                                    root.ctx-x = mx;
                                    root.ctx-y = my;
                                    root.open-context(7, i);
                                }
                            }
                        }
                        if drawer.shown == 3 && root.sidebar-dl-rows.length == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: start;
                            padding-top: 16px;
                            padding-left: Space.l;
                            padding-right: Space.l;
                            spacing: Space.xs;
                            Text {
                                text: root.sidebar-empty;
                                color: Pal.text2;
                                font-size: TypeScale.small;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            if root.sidebar-empty == "No downloads queued" : Text {
                                text: "Right-click a song or playlist and choose Download.";
                                color: Pal.text3;
                                font-size: TypeScale.caption;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        if drawer.lq && root.local-queue-rows.length > 0 : ListView {
                            vertical-stretch: 1;
                            for r[i] in root.local-queue-rows : SideTrackRow {
                                name: r.name;
                                artist: r.artist;
                                time: r.time;
                                playing: r.playing;
                                selectable: false;
                                removable: !r.playing;
                                clicked => { root.local-queue-play(i); }
                                menu(mx, my) => {
                                    root.ctx-x = mx;
                                    root.ctx-y = my;
                                    root.open-context(10, i);
                                }
                                remove => { root.local-queue-remove(i); }
                            }
                        }
                        if drawer.lq && root.local-queue-rows.length == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: start;
                            padding-top: 16px;
                            padding-left: Space.l;
                            padding-right: Space.l;
                            spacing: Space.xs;
                            Text { text: "Nothing playing"; color: Pal.text2; font-size: TypeScale.small; horizontal-alignment: center; }
                            Text {
                                text: "Click a track to play it \u{2014} the rest of its list follows here. Right-click a track and choose Add to queue to play it next.";
                                color: Pal.text3; font-size: TypeScale.caption; horizontal-alignment: center; wrap: word-wrap;
                            }
                        }
                        if drawer.shown != 3 && !drawer.lq && root.sidebar-rows.length > 0 : sblist := ListView {
                            vertical-stretch: 1;
                            // Hold-to-select drag (`RowTouch`): the pointer's y inside the
                            // visible list, and an auto-scroll while it sits near an edge.
                            property <bool> dsel: false;
                            property <length> dvis;
                            function dmove(content-y: length) {
                                sblist.dvis = content-y + sblist.viewport-y;
                                root.sel-drag-move(4, content-y);
                            }
                            // Ticked by the dragging row (`RowTouch.hold-tick`) while the drag is
                            // live: scroll when the pointer sits near an edge.
                            function dtick() {
                                if (sblist.dvis < 36px || sblist.dvis > sblist.visible-height - 36px) {
                                    if (sblist.dvis < 36px) {
                                        sblist.viewport-y = min(0px, sblist.viewport-y + 16px);
                                    } else {
                                        sblist.viewport-y = max(min(0px, sblist.visible-height - sblist.viewport-height), sblist.viewport-y - 16px);
                                    }
                                    root.sel-drag-move(4, sblist.dvis - sblist.viewport-y);
                                }
                            }
                            for r[i] in root.sidebar-rows : SideTrackRow {
                                has-selection: root.sel-count > 0;
                                clear-sel => { root.clear-selection(); }
                                hold-begin => { sblist.dsel = true; root.sel-drag-begin(4, i); }
                                hold-move(y) => { sblist.dmove(y); }
                                hold-tick => { sblist.dtick(); }
                                hold-end => { sblist.dsel = false; root.sel-drag-end(); }
                                name: r.name;
                                artist: r.artist;
                                time: r.time;
                                playing: r.playing;
                                // Downloads are a host-only placeholder: no menu, no select.
                                // A chart row still being found isn't a track yet: no play,
                                // menu, select or remove.
                                pending: r.pending;
                                selectable: drawer.shown != 3 && r.pending == 0;
                                selected: r.selected;
                                removable: drawer.shown == 1 && r.pending == 0;
                                clicked => { if (r.pending == 0) { root.sidebar-play(i); } }
                                menu(mx, my) => {
                                    if (drawer.shown != 3 && r.pending == 0) {
                                        root.ctx-x = mx;
                                        root.ctx-y = my;
                                        root.open-context(4, i);
                                    }
                                }
                                select-click(ctrl, shift) => { root.select-click(4, i, ctrl, shift); }
                                remove => { root.remove-queued-track(i); }
                            }
                        }
                        if drawer.shown == 1 && !drawer.lq && root.bp-done-note != "" : HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 8px;
                            padding-bottom: 10px;
                            Text { text: root.bp-done-note; color: Pal.text3; font-size: TypeScale.small; overflow: elide; }
                        }
                        // `#sidebar-actions`: only the QUEUE mode offers it, like the original.
                        if drawer.shown == 1 && !drawer.lq && root.sidebar-rows.length > 0 : Rectangle {
                            height: 36px;
                            Rectangle { y: 0; height: 1px; background: Pal.border; }
                            HorizontalLayout {
                                padding: 6px;
                                alignment: center;
                                ActionBtn {
                                    label: "Create playlist from queue";
                                    clicked => { root.sidebar-create-playlist(); }
                                }
                            }
                        }
                        if drawer.shown != 3 && !drawer.lq && root.sidebar-rows.length == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: start;
                            padding-top: 16px;
                            padding-left: Space.l;
                            padding-right: Space.l;
                            spacing: Space.xs;
                            Text {
                                text: root.sidebar-empty;
                                color: Pal.text2;
                                font-size: TypeScale.small;
                                horizontal-alignment: center;
                            }
                            // A pointer to how the list fills (UI-PLAN A7) — only under the
                            // plain "empty" messages, never under an error or "Loading…".
                            if root.sidebar-empty == "No queued tracks" || root.sidebar-empty == "No recent tracks yet" : Text {
                                text: drawer.shown == 1
                                    ? "Right-click any song and choose Add to queue."
                                    : "Songs you play will show up here.";
                                color: Pal.text3;
                                font-size: TypeScale.caption;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                    // Left border (drawn on top of the content edge).
                    Rectangle { x: 0; width: 1px; height: parent.height; background: #1a1a1a; }
                }
        }

        // ── Status bar ───────────────────────────────────────────────────────
        if root.mini-mode == "off" : Rectangle {
            height: 42px;
            background: Pal.bg;
            Rectangle { y: 0; height: 1px; background: #161616; }
            // Settings gear stays pinned to the left edge.
            IconBtn {
                box: 32px; icon: 18px;
                x: 8px;
                y: (parent.height - self.height) / 2;
                stroked: true;
                stroke-w: 1.5px;
                show-dot: false;
                is-active: root.settings-open;
                clicked => { root.open-settings(); }
                cmds: Icons.gear;
                // An update waiting: a slow fade between the resting grey and the
                // accent (a 2.4 s cycle; animates only while there is one).
                tint: root.update-attention
                    ? Pal.text3.mix(Pal.accent, 0.5 - 0.5 * cos(animation-tick() / 1ms * 0.15deg))
                    : Pal.text3;
            }
            // Local library mode: lit while on, grey while off.
            LocalToggle {
                x: 46px;
                // Centred below the 1px top line, rounded down a pixel: the window's
                // resize edge continues the footer colour below it.
                y: (parent.height - self.height) / 2 + 1px;
                on: root.local-mode;
                clicked => {
                    root.local-mode = !root.local-mode;
                    root.local-mode-changed(root.local-mode);
                }
            }
            // Queue / recent / downloads toggles, centered in the footer.
            // Labelled toggles (UI-PLAN A4). All three labels need ~290px and the full
            // window's minimum width is 640px, so they always fit; the footer doesn't
            // exist in the mini layouts.
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                VerticalLayout { alignment: center; FootTab { label: "Queue"; active: root.sidebar-mode == 1; cmds: Icons.queue; clicked => { root.toggle-sidebar(1); } } }
                VerticalLayout { alignment: center; FootTab { label: "Recent"; active: root.sidebar-mode == 2; cmds: Icons.recent; clicked => { root.toggle-sidebar(2); } } }
                VerticalLayout { alignment: center; FootTab { label: "Downloads"; active: root.sidebar-mode == 3; cmds: Icons.download; clicked => { root.toggle-sidebar(3); } } }
            }
            // An update that's downloaded and verified: "2.3.0 ready · Restart".
            if root.update-state == "ready" : Rectangle {
                width: upl.preferred-width;
                height: 28px;
                x: parent.width - self.width - 10px;
                y: (parent.height - self.height) / 2;
                border-radius: 14px;
                background: upta.has-hover ? Pal.surface : Pal.card;
                border-width: 1px;
                border-color: Pal.border-hi;
                upta := TouchArea { clicked => { root.update-restart(); } }
                upl := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 4px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Pal.accent; }
                    }
                    Text { text: root.update-version + " ready"; color: Pal.text; font-size: TypeScale.small; font-weight: 500; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 20px;
                            width: rtxt.preferred-width + 18px;
                            border-radius: 10px;
                            background: Pal.text;
                            rtxt := Text { text: "Restart"; color: Pal.ink; font-size: 11.5px; font-weight: 700;
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        }
                    }
                }
            }
            if root.update-state == "downloading" : Text {
                x: parent.width - self.width - 16px;
                y: (parent.height - self.height) / 2;
                text: "updating\u{2026} " + Math.round(root.update-progress * 100) + "%";
                color: Pal.text3; font-size: 11px; font-family: Fonts.mono;
            }
        }

        // ── Mini-player titlebar (snap control + caption buttons) ─────────────
        if root.mini-mode != "off" : Rectangle {
            height: 32px;
            background: Pal.bg;
            TouchArea {
                width: 100%; height: 100%;
                pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.start-drag(); } }
            }
            HorizontalLayout {
                padding-left: 6px; padding-right: 0px; spacing: 2px;
                // Snap control (#mini-modes): segmented pill — square / bar / nano.
                VerticalLayout {
                    alignment: center;
                    SegTrack {
                        height: 26px;
                        HorizontalLayout {
                            padding: 1px; spacing: 1px;
                            MiniSnapBtn { kind: "square"; active: root.mini-mode == "square"; clicked => { root.set-mini-mode("square"); } }
                            MiniSnapBtn { kind: "bar"; active: root.mini-mode == "bar"; clicked => { root.set-mini-mode("bar"); } }
                            MiniSnapBtn { kind: "nano"; active: root.mini-mode == "nano"; clicked => { root.set-mini-mode("nano"); } }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // Minimize.
                Rectangle {
                    width: 36px; height: 32px;
                    background: mmta.has-hover ? Pal.surface : transparent;
                    mmta := TouchArea { clicked => { root.minimized = true; } }
                    Path { width: 14px; height: 14px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        viewbox-width: 24; viewbox-height: 24; commands: "M6 12h12";
                        fill: transparent; stroke: mmta.has-hover ? Pal.text : Pal.text3; stroke-width: 1.6px; stroke-line-cap: round; }
                }
                // Exit mini (back to the full window) — the pip glyph.
                Rectangle {
                    width: 36px; height: 32px;
                    background: exta.has-hover ? Pal.surface : transparent;
                    exta := TouchArea { clicked => { root.set-mini-mode("off"); } }
                    Path { width: 15px; height: 15px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: "M5.5 5.5h13a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2z";
                        fill: transparent; stroke: exta.has-hover ? Pal.text : Pal.text2; stroke-width: 1.6px; }
                    Rectangle {
                        width: 15px * 7 / 24; height: 15px * 5 / 24; border-radius: 1px;
                        x: (parent.width - 15px)/2 + 15px * 11.5 / 24; y: (parent.height - 15px)/2 + 15px * 11 / 24;
                        background: exta.has-hover ? Pal.text : Pal.text2;
                    }
                }
                // Close.
                Rectangle {
                    width: 38px; height: 32px;
                    background: cmta.has-hover ? #c42b1c : transparent;
                    cmta := TouchArea { clicked => { root.close-clicked(); } }
                    Path { width: 14px; height: 14px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        viewbox-width: 24; viewbox-height: 24; commands: Icons.close;
                        fill: transparent; stroke: cmta.has-hover ? #ffffff : Pal.text3; stroke-width: 1.6px; stroke-line-cap: round; }
                }
            }
        }

        // ── Mini-player content (square / bar / nano) ─────────────────────────
        if root.mini-mode != "off" : Rectangle {
            vertical-stretch: 1;
            background: Pal.bg;
            clip: true;
            // Album-tinted inset frame (mirrors the shipped inset accent border).
            border-width: 1px;
            border-color: root.mini-accent.with-alpha(0.28);

            // SQUARE: big cover + title; transport pinned to the bottom; edge line only.
            if root.mini-mode == "square" : VerticalLayout {
                padding-left: 18px; padding-right: 18px; padding-top: 16px; padding-bottom: 18px;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 236px; height: 236px; border-radius: 12px; clip: true;
                        background: @linear-gradient(145deg, #2b3a44 0%, #17242b 55%, #101a1f 100%);
                        Image { source: root.mini-art; width: 100%; height: 100%; image-fit: cover; }
                        if root.mini-art.width == 0 : Text { text: "\u{266B}"; color: #ffffff22; font-size: 64px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                    }
                }
                VerticalLayout {
                    alignment: center; spacing: 2px;
                    Text { text: root.mini-title; color: Pal.text; font-size: 16px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
                    Text { text: root.mini-artist; color: Pal.text2; font-size: 12.5px; horizontal-alignment: center; overflow: elide; }
                }
                Rectangle { vertical-stretch: 1; }
                MiniTransport {
                    playing: root.mini-playing; play-size: 44px; nav-icon: 20px; gap: 8px;
                    prev => { root.mini-prev(); }
                    toggle => { root.mini-toggle(); }
                    next => { root.mini-next(); }
                }
            }

            // BAR: horizontal strip — cover | title + inline progress | transport.
            if root.mini-mode == "bar" : HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 84px; height: 84px; border-radius: 8px; clip: true;
                        background: @linear-gradient(145deg, #2b3a44 0%, #17242b 55%, #101a1f 100%);
                        Image { source: root.mini-art; width: 100%; height: 100%; image-fit: cover; }
                        if root.mini-art.width == 0 : Text { text: "\u{266B}"; color: #ffffff22; font-size: 30px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                    }
                }
                VerticalLayout {
                    alignment: center; spacing: 4px; horizontal-stretch: 1;
                    Text { text: root.mini-title; color: Pal.text; font-size: 15px; font-weight: 700; overflow: elide; }
                    Text { text: root.mini-artist; color: Pal.text2; font-size: 12px; overflow: elide; }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.mini-elapsed; color: Pal.text3; font-size: 10.5px; vertical-alignment: center; font-family: Fonts.mono; min-width: 34px; }
                        VerticalLayout { alignment: center; horizontal-stretch: 1; MiniSeekBar { progress: root.mini-progress; seek(f) => { root.mini-seek(f); } } }
                        Text { text: root.mini-duration; color: Pal.text3; font-size: 10.5px; vertical-alignment: center; font-family: Fonts.mono; min-width: 34px; horizontal-alignment: right; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    MiniTransport {
                        playing: root.mini-playing; play-size: 32px; nav-icon: 16px; gap: 6px;
                        prev => { root.mini-prev(); }
                        toggle => { root.mini-toggle(); }
                        next => { root.mini-next(); }
                    }
                }
            }

            // NANO: cover fills; click the cover → expand to square; floating transport pill.
            if root.mini-mode == "nano" : Rectangle {
                width: 100%; height: 100%;
                Rectangle {
                    width: 100%; height: 100%; clip: true;
                    background: @linear-gradient(145deg, #2b3a44 0%, #17242b 55%, #101a1f 100%);
                    Image { source: root.mini-art; width: 100%; height: 100%; image-fit: cover; }
                    if root.mini-art.width == 0 : Text { text: "\u{266B}"; color: #ffffff22; font-size: 54px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                    nta := TouchArea { mouse-cursor: pointer; clicked => { root.set-mini-mode("square"); } }
                }
                // Floating transport pill near the bottom.
                Rectangle {
                    width: 132px; height: 40px; border-radius: 20px; background: #0c0c0cb8;
                    border-width: 1px; border-color: #ffffff1a;
                    x: (parent.width - self.width)/2; y: parent.height - self.height - 12px;
                    TouchArea { }   // swallow clicks in the pill gaps (don't fall through to expand)
                    MiniTransport {
                        width: 100%; height: 100%;
                        playing: root.mini-playing; play-size: 26px; nav-icon: 15px; gap: 10px;
                        prev => { root.mini-prev(); }
                        toggle => { root.mini-toggle(); }
                        next => { root.mini-next(); }
                    }
                }
            }

            // Edge progress line — square + nano only (bar shows the inline bar instead).
            if root.mini-mode != "bar" : Rectangle {
                x: 0; y: parent.height - self.height; height: 2px;
                width: parent.width * root.mini-progress;
                background: root.mini-accent;
            }
        }
    }
    }
    // end rootkeys FocusScope

    // ── Settings modal ───────────────────────────────────────────────────────
    // Full-window scrim + a centred two-column panel of cards (`.card`). The body
    // scrolls only if the window is too short for it.
    if root.settings-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea { clicked => { root.close-settings(); } }   // backdrop closes
        Rectangle {
            width: min(parent.width - 40px, 780px);
            height: min(sbody.preferred-height + 58px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Pal.card;
            border-radius: 18px;
            border-width: 1px;
            border-color: Pal.border-hi;
            clip: true;
            TouchArea { }   // swallow clicks so they don't reach the backdrop
            VerticalLayout {
                // Header
                Rectangle {
                    height: 58px;
                    HorizontalLayout {
                        padding-left: 22px;
                        padding-right: 12px;
                        spacing: 12px;
                        Text { text: "Settings"; color: Pal.text; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                        Text {
                            text: root.app-version == "" ? "lightify" : "lightify " + root.app-version;
                            color: Pal.text3; font-size: 11px; font-family: Fonts.mono;
                            vertical-alignment: center; horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            IconBtn { cmds: Icons.close; stroked: true; icon: 15px; box: 34px; clicked => { root.close-settings(); } }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Pal.surface2; }
                }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-height: sbody.preferred-height;
                    sbody := HorizontalLayout {
                        width: parent.viewport-width;
                        padding: 18px;
                        spacing: 14px;
                        alignment: stretch;

                        // ── Left column ──
                        // Both columns split the width evenly whatever is in them (with no
                        // download folder set, the left one used to take two thirds).
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            preferred-width: 0px;
                            spacing: 14px;
                            alignment: start;

                            // PLAYBACK ENGINE — Lightify's own Spotify Connect device.
                            // This is the whole point: audio is decoded here, so the
                            // Spotify desktop app is never part of the chain.
                            Card {
                                HorizontalLayout {
                                    Kicker { text: "// playback engine"; }
                                    PillBtn { label: "Restart"; clicked => { root.restart-engine(); } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    StatusDot { on: root.engine-ok; }
                                    Text { text: root.engine-status; color: root.engine-ok ? Pal.text : Pal.text2; font-size: 13.5px; font-weight: 500; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                }
                                Text {
                                    text: "Lightify decodes audio itself and registers as a Spotify Connect device \u{2014} the Spotify app is never required.";
                                    color: Pal.text2; font-size: 12.5px; wrap: word-wrap;
                                }
                            }

                            // AUDIO OUTPUT — which sound card the engine plays through.
                            Card {
                                Kicker { text: "// audio output"; }
                                Rectangle {
                                    // Exactly three 34px rows, so the list never cuts a
                                    // row's text in half; the rest scrolls.
                                    height: 106px;
                                    clip: true;
                                    if root.settings-outputs.length > 0 : ListView {
                                        for o[i] in root.settings-outputs : Rectangle {
                                            height: 35px;
                                            Rectangle {
                                                y: 1px; height: 33px;
                                                border-radius: 9px;
                                                background: o.active ? Pal.surface2 : (outr.has-hover ? Pal.surface : transparent);
                                            }
                                            outr := TouchArea { clicked => { root.settings-select-output(i); } }
                                            HorizontalLayout {
                                                padding-left: 10px; padding-right: 10px;
                                                Text {
                                                    text: o.name;
                                                    color: o.active || outr.has-hover ? Pal.text : Pal.text2;
                                                    font-size: 13px; font-weight: 500;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                                if o.active : VerticalLayout {
                                                    alignment: center;
                                                    Path {
                                                        width: 15px; height: 15px;
                                                        viewbox-width: 24; viewbox-height: 24;
                                                        commands: Icons.check;
                                                        fill: transparent; stroke: Pal.text; stroke-width: 2px;
                                                        stroke-line-cap: round; stroke-line-join: round;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.settings-outputs.length == 0 : Text {
                                        x: 10px; y: 8px;
                                        text: "No audio outputs found"; color: Pal.text3; font-size: TypeScale.small;
                                    }
                                }
                                if root.settings-output-note != "" : Text {
                                    text: root.settings-output-note;
                                    color: Pal.danger; font-size: TypeScale.small; wrap: word-wrap;
                                }
                            }

                            // PLAYBACK DEVICE
                            Card {
                                HorizontalLayout {
                                    Kicker { text: "// playback device"; }
                                    PillBtn { label: "Refresh"; clicked => { root.settings-refresh-devices(); } }
                                }
                                Rectangle {
                                    // One 40px row per device, up to three; the rest scrolls.
                                    // (One row while it loads or finds none, for the note.)
                                    height: Math.max(1, Math.min(3, root.settings-devices.length)) * 41px - 1px;
                                    clip: true;
                                    if root.settings-devices.length > 0 : ListView {
                                        for d[i] in root.settings-devices : Rectangle {
                                            height: 41px;
                                            Rectangle {
                                                y: 1px; height: 39px;
                                                border-radius: 9px;
                                                background: d.active ? Pal.surface2 : (dvr.has-hover ? Pal.surface : transparent);
                                            }
                                            dvr := TouchArea { clicked => { root.settings-select-device(i); } }
                                            HorizontalLayout {
                                                padding-left: 10px; padding-right: 6px; spacing: 8px;
                                                if d.active : VerticalLayout { alignment: center; StatusDot { on: true; } }
                                                Text {
                                                    text: d.name;
                                                    color: Pal.text; font-size: 13px; font-weight: 500;
                                                    vertical-alignment: center; overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    // The whole row selects; this is its visible affordance.
                                                    Rectangle {
                                                        width: seltxt.preferred-width + 22px; height: 26px; border-radius: 13px;
                                                        border-width: 1px;
                                                        border-color: dvr.has-hover ? Pal.border-strong : Pal.border-hi;
                                                        seltxt := Text { text: "Select"; color: dvr.has-hover ? Pal.text : Pal.text2; font-size: TypeScale.small; font-weight: 500;
                                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.settings-devices.length == 0 : Text {
                                        x: 10px; y: 8px; width: parent.width - 20px;
                                        text: root.settings-device-status; color: Pal.text3; font-size: TypeScale.small; wrap: word-wrap;
                                    }
                                }
                            }

                            // ASCII LAVA — the backdrop behind now playing, Spotify and Local.
                            Card {
                                Kicker { text: "// ascii lava"; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Lava behind now playing"; color: Pal.text; font-size: 13.5px; font-weight: 500; }
                                        Text { text: "Right-click the lava for the screensaver."; color: Pal.text3; font-size: 12px; wrap: word-wrap; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Switch {
                                            on: root.lava-on;
                                            toggled => {
                                                root.lava-on = !root.lava-on;
                                                root.set-lava-on(root.lava-on);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── Right column ──
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            preferred-width: 0px;
                            spacing: 14px;
                            alignment: start;

                            // POLL RATE
                            Card {
                                Kicker { text: "// poll rate"; }
                                SegTrack {
                                    height: 36px;
                                    HorizontalLayout {
                                        padding: 3px;
                                        spacing: 2px;
                                        SegBtn { label: "Slow"; note: "5s"; h: 30px; stretch: true; active: root.poll-ms == 5000; clicked => { root.set-poll-rate(5000); } }
                                        SegBtn { label: "Normal"; note: "3s"; h: 30px; stretch: true; active: root.poll-ms == 3000; clicked => { root.set-poll-rate(3000); } }
                                        SegBtn { label: "Fast"; note: "1s"; h: 30px; stretch: true; active: root.poll-ms == 1000; clicked => { root.set-poll-rate(1000); } }
                                    }
                                }
                            }

                            // DOWNLOADER — the bundled OnTheSpot bridge. It needs a Spotify
                            // account of its own (librespot credentials); the Web-API OAuth
                            // the rest of the app uses cannot pull audio.
                            Card {
                                HorizontalLayout {
                                    spacing: 8px;
                                    Kicker { text: "// downloader"; }
                                    // Stays clickable while busy: the sign-in this starts
                                    // resolves in the background (success or a timeout) with
                                    // nothing to force this open panel to notice on its own —
                                    // this is the fallback way to ask again besides the poll.
                                    PillBtn {
                                        label: root.downloader-busy ? "Waiting\u{2026} (retry)" : "Connect Spotify Downloader";
                                        enabled: !root.downloader-ready;
                                        clicked => { root.settings-start-downloader-login(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    StatusDot { on: root.downloader-ready; }
                                    Text {
                                        text: root.downloader-status;
                                        color: root.downloader-ready ? Pal.text : Pal.text2;
                                        font-size: 13px; font-weight: 500;
                                        overflow: elide; horizontal-stretch: 1; vertical-alignment: center;
                                    }
                                }
                                Kicker { text: "download folder"; }
                                // Download folder — shared with the shipped app (same config
                                // key), so a path set in either one is what both write into.
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        height: 36px;
                                        horizontal-stretch: 1;
                                        border-radius: 10px; border-width: 1px;
                                        border-color: dlpath.has-focus ? Pal.border-strong : Pal.border-hi;
                                        background: Pal.card;
                                        HorizontalLayout {
                                            padding-left: 10px; padding-right: 10px;
                                            dlpath := TextInput {
                                                vertical-alignment: center;
                                                color: Pal.text2;
                                                font-size: 11.5px;
                                                font-family: Fonts.mono;
                                                single-line: true;
                                                text: root.settings-download-path;
                                                edited => { root.settings-download-path = self.text; }
                                                accepted => { root.settings-apply-download-path(self.text); }
                                            }
                                        }
                                        if dlpath.text == "" : Text {
                                            text: "Download folder";
                                            color: Pal.text3; font-size: 11.5px; font-family: Fonts.mono;
                                            x: 10px; y: (parent.height - self.height) / 2;
                                        }
                                    }
                                    PillBtn { label: "Save"; h: 36px; clicked => { root.settings-apply-download-path(dlpath.text); } }
                                }
                            }

                            // UPDATES — lightify_core::update: signed releases from
                            // lightify.stream, downloaded in the background.
                            Card {
                                HorizontalLayout {
                                    spacing: 8px;
                                    Kicker { text: "// updates"; }
                                    PillBtn {
                                        label: root.update-state == "ready" ? "Restart now"
                                            : root.update-state == "available" ? "Download"
                                            : root.update-state == "checking" ? "Checking\u{2026}"
                                            : root.update-state == "downloading" ? "Downloading\u{2026}"
                                            : "Check now";
                                        enabled: root.update-state != "checking" && root.update-state != "downloading";
                                        clicked => {
                                            if (root.update-state == "ready") { root.update-restart(); }
                                            else { root.update-check(); }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    StatusDot { on: root.update-state == "ready" || root.update-state == "available"; }
                                    Text {
                                        text: root.update-state == "ready" ? "Lightify " + root.update-version + " downloaded \u{2014} restart to finish"
                                            : root.update-state == "available" ? "Lightify " + root.update-version + " is available"
                                            : root.update-state == "checking" ? "Checking lightify.stream\u{2026}"
                                            : root.update-state == "downloading" ? "Downloading Lightify " + root.update-version
                                            : root.update-state == "error" ? root.update-note
                                            : root.update-state == "current" ? "Lightify " + root.app-version + " is up to date"
                                            : "Lightify " + root.app-version;
                                        color: root.update-state == "error" ? Pal.danger : Pal.text;
                                        font-size: 13px; font-weight: 500;
                                        wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center;
                                    }
                                    if root.update-state == "downloading" : Text {
                                        text: Math.round(root.update-progress * 100) + "%";
                                        color: Pal.text2; font-size: 11px; font-family: Fonts.mono;
                                        vertical-alignment: center;
                                    }
                                }
                                // Stop the cog asking for attention about this version (and
                                // don't download it on its own). Under the update button:
                                // the card is too narrow for both beside the label.
                                if root.update-attention : HorizontalLayout {
                                    alignment: end;
                                    PillBtn {
                                        label: "Mark seen";
                                        clicked => { root.update-mark-seen(); }
                                    }
                                }
                                // A plain download bar while it downloads.
                                if root.update-state == "downloading" : Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Pal.surface2;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * clamp(root.update-progress, 0, 1);
                                        border-radius: 2px;
                                        background: Pal.accent;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Install updates automatically"; color: Pal.text2; font-size: 12.5px; vertical-alignment: center; horizontal-stretch: 1; }
                                    VerticalLayout {
                                        alignment: center;
                                        Switch {
                                            on: root.update-auto;
                                            toggled => {
                                                root.update-auto = !root.update-auto;
                                                root.set-update-auto(root.update-auto);
                                            }
                                        }
                                    }
                                }
                            }

                            // ACCOUNT + ABOUT
                            Card {
                                HorizontalLayout {
                                    spacing: 20px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Kicker { text: "// account"; }
                                        Text { text: root.account == "" ? "Not connected" : root.account; color: Pal.text2; font-size: 13px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Kicker { text: "// about"; }
                                        Text { text: root.app-version == "" ? "Lightify" : "Lightify " + root.app-version; color: Pal.text2; font-size: 13px; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Command palette (Ctrl+K) ─────────────────────────────────────────────
    if root.palette-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea { clicked => { root.close-palette(); } }   // backdrop closes
        Rectangle {
            width: min(parent.width - 40px, 600px);
            height: min(420px, parent.height - 110px);
            x: (parent.width - self.width) / 2;
            y: 84px;
            background: Pal.card;
            border-radius: 16px;
            border-width: 1px;
            border-color: Pal.border-hi;
            clip: true;
            TouchArea { }   // swallow clicks so they don't reach the backdrop
            VerticalLayout {
                // Query input (fuzzy filters the command list; keys drive navigation).
                Rectangle {
                    height: 56px;
                    Path {
                        x: 18px; y: (parent.height - self.height) / 2;
                        width: 18px; height: 18px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: Icons.search;
                        fill: transparent; stroke: Pal.text3; stroke-width: 1.6px; stroke-line-cap: round;
                    }
                    HorizontalLayout {
                        padding-left: 48px;
                        padding-right: 16px;
                        spacing: 10px;
                        cmdk := TextInput {
                            vertical-alignment: center;
                            color: Pal.text;
                            font-size: 15px;
                            font-weight: 500;
                            single-line: true;
                            horizontal-stretch: 1;
                            init => { self.focus(); }
                            edited => { root.cmdk-query-changed(self.text); }
                            key-pressed(e) => {
                                if (e.text == Key.UpArrow) { root.palette-move(-1); return accept; }
                                if (e.text == Key.DownArrow) { root.palette-move(1); return accept; }
                                if (e.text == Key.Return) { root.run-palette(); return accept; }
                                if (e.text == Key.Escape) { root.close-palette(); return accept; }
                                if ((e.modifiers.control || e.modifiers.meta) && e.text == "k") { root.close-palette(); return accept; }
                                return reject;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: esc.preferred-width + 14px; height: 20px; border-radius: 6px;
                                border-width: 1px; border-color: Pal.border-hi;
                                esc := Text { text: "esc"; color: Pal.text3; font-size: 10.5px; font-family: Fonts.mono;
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            }
                        }
                    }
                    if cmdk.text == "" : Text {
                        text: "Search actions, playlists\u{2026}";
                        color: Pal.text3; font-size: 15px;
                        x: 48px; y: (parent.height - self.height) / 2;
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Pal.surface2; }
                }
                // Results.
                if root.cmdk-rows.length > 0 : ListView {
                    vertical-stretch: 1;
                    for r[i] in root.cmdk-rows : Rectangle {
                        height: 42px;
                        Rectangle {
                            x: 8px; y: 1px; width: parent.width - 16px; height: 40px;
                            border-radius: 10px;
                            background: i == root.cmdk-selected ? Pal.surface2 : (cta2.has-hover ? Pal.surface : transparent);
                        }
                        cta2 := TouchArea { clicked => { root.cmdk-selected = i; root.run-palette(); } }
                        HorizontalLayout {
                            padding-left: 22px;
                            padding-right: 22px;
                            spacing: 8px;
                            Text { text: r.title; color: i == root.cmdk-selected ? Pal.text : Pal.text2; font-size: 14px; font-weight: 500; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: r.hint; color: Pal.text3; font-size: 11px; font-family: Fonts.mono; vertical-alignment: center; }
                        }
                    }
                }
                if root.cmdk-rows.length == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    alignment: start;
                    padding-top: 18px;
                    Text { text: "No matches"; color: Pal.text3; font-size: TypeScale.small; horizontal-alignment: center; }
                }
            }
        }
    }

    // ═══ Right-click menu (`.ctx-menu` / `.ctx-menu-item`) ═══
    // The width comes from the host (`menu_width`), sized to the longest label.
    if root.ctx-open : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        // The original closes on any document click; a full-window catcher is the
        // native equivalent (same as the settings / palette backdrops).
        TouchArea { clicked => { root.ctx-open = false; } }
        Rectangle {
            // "Adjust if off-screen" — the original nudges the menu back inside by 4px.
            x: max(4px, min(root.ctx-x, root.width - self.width - 4px));
            y: max(4px, min(root.ctx-y, root.height - self.height - 4px));
            width: root.ctx-w;
            height: root.ctx-items.length * 32px + 12px;      // 6px top/bottom padding
            background: Pal.surface;
            border-width: 1px;
            border-color: Pal.border-hi;
            border-radius: 12px;
            TouchArea { }   // swallow clicks inside the panel
            VerticalLayout {
                padding: 6px;
                for it[i] in root.ctx-items : Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: cta3.has-hover
                        ? (it.danger ? #f871711f : Pal.surface2)
                        : transparent;
                    cta3 := TouchArea { clicked => { root.run-context(i); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: it.label;
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                            color: it.danger
                                ? (cta3.has-hover ? #ffd0d0 : Pal.danger)
                                : (it.muted ? Pal.faint : Pal.text);
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // ═══ Confirm dialog (`#confirm-overlay` / `#confirm-panel`) ═══
    // Only "Delete playlist" uses it, and only because that call is destructive.
    if root.confirm-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea { clicked => { root.confirm-open = false; } }   // backdrop cancels
        Rectangle {
            // Height is fixed (a non-layout element can't size to its content) and
            // sized for a two-line message, so long playlist names never clip.
            width: 380px;
            height: 168px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Pal.card;
            border-radius: 16px;
            border-width: 1px;
            border-color: Pal.border-hi;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 0px;
                Text {
                    text: root.confirm-title;
                    color: Pal.text; font-size: 16px; font-weight: 700;
                }
                Rectangle { height: 8px; }
                Text {
                    text: root.confirm-message;
                    color: Pal.text2; font-size: 13px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                Rectangle { height: 14px; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillBtn { label: "No"; h: 32px; clicked => { root.confirm-open = false; } }
                    // Danger pill.
                    Rectangle {
                        width: ytxt.preferred-width + 30px; height: 32px; border-radius: 16px;
                        border-width: 1px;
                        border-color: cyes.has-hover ? Pal.danger : #f8717166;
                        background: cyes.has-hover ? #f871711f : transparent;
                        cyes := TouchArea {
                            clicked => { root.confirm-open = false; root.confirm-accept(); }
                        }
                        ytxt := Text { text: "Yes"; font-size: 13px; font-weight: 600; color: cyes.has-hover ? #ffd0d0 : Pal.danger;
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    }
                }
            }
        }
    }

    // ═══ New-playlist name prompt ═══
    // A small card over the panel the playlist is being made from; only that panel
    // dims. A click anywhere outside the card cancels, like the menus.
    if root.name-prompt-open : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        TouchArea { clicked => { root.name-prompt-open = false; root.name-prompt-cancel(); } }
        // The dimmed panel (between the title bar and the footer).
        Rectangle {
            x: root.name-prompt-side == 0 ? 0px : root.width - 300px;
            y: 36px;
            width: root.name-prompt-side == 0 ? 288px : 300px;
            height: root.height - 36px - 42px;
            background: #0a0a0ab3;
        }
        Rectangle {
            property <length> panel-x: root.name-prompt-side == 0 ? 0px : root.width - 300px;
            property <length> panel-w: root.name-prompt-side == 0 ? 288px : 300px;
            width: self.panel-w - 24px;
            height: npcard.preferred-height;
            x: self.panel-x + 12px;
            y: (root.height - self.height) / 2;
            background: Pal.card;
            border-radius: 14px;
            border-width: 1px;
            border-color: Pal.border-hi;
            TouchArea { }   // clicks on the card stay on the card
            npcard := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    Kicker { text: "// new playlist"; }
                    if root.name-prompt-note != "" : Text {
                        text: root.name-prompt-note;
                        color: Pal.text2; font-size: TypeScale.small; wrap: word-wrap;
                    }
                }
                Rectangle {
                    height: 40px;
                    border-radius: 10px;
                    background: Pal.panel;
                    border-width: 1px;
                    border-color: npin.has-focus ? Pal.border-strong : Pal.border-hi;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        npin := TextInput {
                            vertical-alignment: center;
                            single-line: true;
                            color: Pal.text;
                            font-size: 14px;
                            font-weight: 500;
                            init => { self.focus(); }
                            accepted => {
                                if (self.text != "") {
                                    root.name-prompt-open = false;
                                    root.name-prompt-accept(self.text);
                                }
                            }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.name-prompt-open = false;
                                    root.name-prompt-cancel();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                    if npin.text == "" : Text {
                        text: "Playlist name";
                        color: Pal.text3; font-size: 14px;
                        x: 12px; y: (parent.height - self.height) / 2;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillBtn {
                        label: "Cancel"; h: 32px;
                        clicked => { root.name-prompt-open = false; root.name-prompt-cancel(); }
                    }
                    // The one primary button: the white pill, live once there's a name.
                    Rectangle {
                        width: savet.preferred-width + 30px; height: 32px; border-radius: 16px;
                        background: npin.text == "" ? Pal.surface2 : (savta.has-hover ? #ffffff : Pal.text);
                        savta := TouchArea {
                            enabled: npin.text != "";
                            clicked => { root.name-prompt-open = false; root.name-prompt-accept(npin.text); }
                        }
                        savet := Text {
                            text: "Save";
                            color: npin.text == "" ? Pal.faint : Pal.ink;
                            font-size: 13px; font-weight: 700;
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }

    // ── Sign-in page (`#auth-page` / `.auth-box`) ──────────────────────────
    if root.signin-open : Rectangle {
        y: 36px;
        width: 100%;
        height: parent.height - 36px;
        background: Pal.bg;
        TouchArea { }   // swallow clicks meant for the (hidden) player underneath
        Rectangle {
            width: min(parent.width - 40px, 480px);
            height: card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Pal.card;
            border-radius: 20px;
            border-width: 1px;
            border-color: Pal.border;
            card := VerticalLayout {
                padding: 32px;
                spacing: 22px;
                VerticalLayout {
                    spacing: 8px;
                    Kicker { text: "// first run"; }
                    Text { text: "Connect Spotify"; color: Pal.text; font-size: 26px; font-weight: 700; letter-spacing: -0.4px; }
                }
                VerticalLayout {
                    spacing: 16px;
                    // Step 1, with the dashboard as a link (`.auth-link-btn`).
                    HorizontalLayout {
                        spacing: 12px;
                        StepNum { n: "1"; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            Text { text: "Go to"; color: Pal.text2; font-size: 14px; }
                            CodeBox {
                                text: "developer.spotify.com/dashboard";
                                action: "open";
                                clicked => { root.signin-open-dashboard(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        StepNum { n: "2"; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            Text { text: "Create an app \u{2014} set the redirect URI to"; color: Pal.text2; font-size: 14px; wrap: word-wrap; }
                            CodeBox { text: "http://127.0.0.1:8901/callback"; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        StepNum { n: "3"; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            Text { text: "Paste your Client ID below and authorise"; color: Pal.text2; font-size: 14px; wrap: word-wrap; }
                            Rectangle {
                                height: 40px;
                                background: Pal.panel;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: cid.has-focus ? Pal.border-strong : Pal.border-hi;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    cid := TextInput {
                                        vertical-alignment: center;
                                        single-line: true;
                                        color: Pal.text;
                                        font-size: 13px;
                                        font-family: Fonts.mono;
                                        text: root.signin-client-id;
                                        edited => { root.signin-client-id = self.text; }
                                        accepted => { if (!root.signin-waiting) { root.signin-authorise(self.text); } }
                                    }
                                }
                                if cid.text == "" : Text {
                                    text: "paste your Spotify Client ID here";
                                    color: Pal.text3; font-size: 13px; font-family: Fonts.mono;
                                    x: 12px; y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
                // `.auth-actions` + `#auth-status.status`
                HorizontalLayout {
                    spacing: 10px;
                    // The one primary button: the inverted white pill.
                    Rectangle {
                        width: atxt.preferred-width + 40px; height: 40px; border-radius: 20px;
                        background: auth.has-hover && !root.signin-waiting ? #ffffff : Pal.text;
                        opacity: root.signin-waiting ? 0.45 : 1.0;
                        auth := TouchArea {
                            clicked => { if (!root.signin-waiting) { root.signin-authorise(cid.text); } }
                        }
                        atxt := Text {
                            text: "Authorise";
                            color: Pal.ink; font-size: 14px; font-weight: 700;
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        }
                    }
                    PillBtn { label: "Retry"; h: 40px; clicked => { root.signin-retry(); } }
                    Text {
                        text: root.signin-status;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        font-size: 11.5px;
                        font-family: Fonts.mono;
                        color: root.signin-error ? Pal.danger : root.signin-ok ? Pal.accent : Pal.text3;
                    }
                }
            }
        }
    }

    if root.local-find-open : LocalFind {
        width: 100%; height: 100%;
        cands: root.local-cands;
        busy: root.local-find-busy;
        confirm-label: root.local-find-confirm;
        toggle(i) => { root.local-find-toggle(i); }
        add-folder => { root.local-find-add-folder(); }
        add-files => { root.local-find-add-files(); }
        confirm => { root.local-find-confirm-add(); }
        close => { root.local-find-close(); }
    }

    // ── Resize handles ────────────────────────────────────────────────────────
    // The window has no system frame, so its edges and corners are these. Thin (4 px
    // edges, 10 px corners) so they never cover a control's working area; off while
    // maximized and in the mini player (fixed sizes).
    if !root.maximized && root.mini-mode == "off" && !root.lava-saver : Rectangle {
        property <length> e: 4px;
        property <length> c: 10px;
        ResizeGrip { dir: 0; x: parent.c; y: 0; width: parent.width - 2 * parent.c; height: parent.e; mouse-cursor: ns-resize; grab(d) => { root.start-resize(d); } }
        ResizeGrip { dir: 1; x: parent.c; y: parent.height - parent.e; width: parent.width - 2 * parent.c; height: parent.e; mouse-cursor: ns-resize; grab(d) => { root.start-resize(d); } }
        ResizeGrip { dir: 2; x: 0; y: parent.c; width: parent.e; height: parent.height - 2 * parent.c; mouse-cursor: ew-resize; grab(d) => { root.start-resize(d); } }
        ResizeGrip { dir: 3; x: parent.width - parent.e; y: parent.c; width: parent.e; height: parent.height - 2 * parent.c; mouse-cursor: ew-resize; grab(d) => { root.start-resize(d); } }
        ResizeGrip { dir: 4; x: 0; y: 0; width: parent.c; height: parent.c; mouse-cursor: nwse-resize; grab(d) => { root.start-resize(d); } }
        ResizeGrip { dir: 5; x: parent.width - parent.c; y: 0; width: parent.c; height: parent.c; mouse-cursor: nesw-resize; grab(d) => { root.start-resize(d); } }
        ResizeGrip { dir: 6; x: 0; y: parent.height - parent.c; width: parent.c; height: parent.c; mouse-cursor: nesw-resize; grab(d) => { root.start-resize(d); } }
        ResizeGrip { dir: 7; x: parent.width - parent.c; y: parent.height - parent.c; width: parent.c; height: parent.c; mouse-cursor: nwse-resize; grab(d) => { root.start-resize(d); } }
    }

    // ── ASCII lava screensaver ────────────────────────────────────────────────
    // Over everything, in a full-screen window (the host switches it): the wall alone,
    // no cursor. Any mouse button or key ends it; moving the mouse does not.
    if root.lava-saver : Rectangle {
        width: 100%;
        height: 100%;
        background: #000;
        Image { source: root.saver-bg; width: 100%; height: 100%; image-fit: fill; }
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                root.end-saver();
                accept
            }
        }
        TouchArea {
            mouse-cursor: MouseCursor.none;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { root.end-saver(); }
            }
        }
    }
}
