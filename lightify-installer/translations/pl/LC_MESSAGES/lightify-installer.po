#: src/main.rs:328 src/ops.rs:406
msgid "this Setup file is damaged ({}) - download it again"
msgstr "ten plik instalatora jest uszkodzony ({}) - pobierz go ponownie"

#: src/main.rs:472
msgid "Setup can't start"
msgstr "Nie można uruchomić instalatora"

#: src/main.rs:520
msgid "preparing"
msgstr "przygotowywanie"

#: src/main.rs:552 src/main.rs:1335
msgid "Lightify is open. Setup can close it for you — your settings are kept, and you can reopen it when setup finishes."
msgstr "Lightify jest otwarty. Instalator może go zamknąć — ustawienia zostaną zachowane, a po zakończeniu instalacji możesz go ponownie otworzyć."

#: src/main.rs:644
msgid "Setup can't write to that folder. Pick another one, or install for everyone on this PC."
msgstr "Instalator nie może zapisywać w tym folderze. Wybierz inny albo zainstaluj dla wszystkich użytkowników tego komputera."

#: src/main.rs:698
msgid "Installing for everyone needs administrator approval."
msgstr "Instalacja dla wszystkich wymaga zgody administratora."

#: src/main.rs:735 src/main.rs:1230
msgid "Lightify is still open. Quit it from its tray icon (right-click → Quit), then press Close Lightify again."
msgstr "Lightify jest nadal otwarty. Zamknij go z ikony w zasobniku (prawy przycisk → Zakończ), a potem ponownie kliknij „Zamknij Lightify”."

#: src/main.rs:891
msgid "Lightify isn't installed"
msgstr "Lightify nie jest zainstalowany"

#: src/main.rs:892
msgid "There is no Lightify install on this PC to update. Download Setup from lightify.stream."
msgstr "Na tym komputerze nie ma instalacji Lightify do zaktualizowania. Pobierz instalator z lightify.stream."

#: src/main.rs:1119
msgid "There is no Lightify install in {}."
msgstr "W {} nie ma instalacji Lightify."

#: src/main.rs:1121
msgid "Nothing to remove"
msgstr "Nic do usunięcia"

#: src/main.rs:1186
msgid "Lightify wasn't fully removed"
msgstr "Lightify nie został całkowicie usunięty"

#: src/main.rs:1198
msgid "Lightify is open. Setup can close it for you, then remove it."
msgstr "Lightify jest otwarty. Instalator może go zamknąć, a potem usunąć."

#: src/main.rs:1330 src/ops.rs:90
msgid "Pick a folder, not the root of a drive."
msgstr "Wybierz folder, a nie katalog główny dysku."

#: src/main.rs:1342 src/ops.rs:443
msgid "copying {}"
msgstr "kopiowanie {}"

#: src/main.rs:1365 src/ops.rs:639 src/ops.rs:677
msgid "removing {}"
msgstr "usuwanie {}"

#: src/ops.rs:87
msgid "Choose a full folder path, like C:\\Programs\\Lightify."
msgstr "Podaj pełną ścieżkę folderu, np. C:\\Programs\\Lightify."

#: src/ops.rs:94
msgid "Lightify can't be installed inside the Windows folder."
msgstr "Lightify nie może być zainstalowany w folderze Windows."

#: src/ops.rs:98
msgid "That folder name has characters Windows doesn't allow."
msgstr "Ta nazwa folderu zawiera znaki niedozwolone w Windows."

