#: src/main.rs:552 src/main.rs:1335
msgid "Lightify is open. Setup can close it for you — your settings are kept, and you can reopen it when setup finishes."
msgstr "Lightify está abierto. El instalador puede cerrarlo por ti — tus ajustes se conservan y podrás volver a abrirlo cuando termine."

#: src/main.rs:644
msgid "Setup can't write to that folder. Pick another one, or install for everyone on this PC."
msgstr "El instalador no puede escribir en esa carpeta. Elige otra o instala para todos en este PC."

#: src/main.rs:698
msgid "Installing for everyone needs administrator approval."
msgstr "Instalar para todos requiere la aprobación de un administrador."

#: src/main.rs:735 src/main.rs:1230
msgid "Lightify is still open. Quit it from its tray icon (right-click → Quit), then press Close Lightify again."
msgstr "Lightify sigue abierto. Ciérralo desde su icono de la bandeja (clic derecho → Salir) y vuelve a pulsar Cerrar Lightify."

#: src/main.rs:891
msgid "Lightify isn't installed"
msgstr "Lightify no está instalado"

#: src/main.rs:892
msgid "There is no Lightify install on this PC to update. Download Setup from lightify.stream."
msgstr "No hay ninguna instalación de Lightify en este PC que actualizar. Descarga el instalador desde lightify.stream."

#: src/main.rs:1119
msgid "There is no Lightify install in {}."
msgstr "No hay ninguna instalación de Lightify en {}."

#: src/main.rs:1121
msgid "Nothing to remove"
msgstr "No hay nada que desinstalar"

#: src/main.rs:1186
msgid "Lightify wasn't fully removed"
msgstr "Lightify no se desinstaló por completo"

#: src/main.rs:1198
msgid "Lightify is open. Setup can close it for you, then remove it."
msgstr "Lightify está abierto. El instalador puede cerrarlo por ti y luego desinstalarlo."

