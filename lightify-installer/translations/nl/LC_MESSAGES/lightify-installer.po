msgstr "{} kopiëren"

#: src/main.rs:1365 src/ops.rs:639 src/ops.rs:677
msgid "removing {}"
msgstr "{} verwijderen"

#: src/ops.rs:87
msgid "Choose a full folder path, like C:\\Programs\\Lightify."
msgstr "Kies een volledig mappad, zoals C:\\Programs\\Lightify."

#: src/ops.rs:94
msgid "Lightify can't be installed inside the Windows folder."
msgstr "Lightify kan niet in de Windows-map worden geïnstalleerd."

#: src/ops.rs:98
msgid "That folder name has characters Windows doesn't allow."
msgstr "Die mapnaam bevat tekens die Windows niet toestaat."

