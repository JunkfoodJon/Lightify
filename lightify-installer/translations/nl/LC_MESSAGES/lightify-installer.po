#: src/main.rs:328 src/ops.rs:406
msgid "this Setup file is damaged ({}) - download it again"
msgstr "dit installatiebestand is beschadigd ({}) - download het opnieuw"

#: src/main.rs:472
msgid "Setup can't start"
msgstr "Installatie kan niet starten"

#: src/main.rs:520
msgid "preparing"
msgstr "voorbereiden"

#: src/main.rs:552 src/main.rs:1335
msgid "Lightify is open. Setup can close it for you — your settings are kept, and you can reopen it when setup finishes."
msgstr "Lightify is geopend. Het installatieprogramma kan het voor je sluiten — je instellingen blijven bewaard en je kunt het weer openen als de installatie klaar is."

#: src/main.rs:644
msgid "Setup can't write to that folder. Pick another one, or install for everyone on this PC."
msgstr "Het installatieprogramma kan niet naar die map schrijven. Kies een andere of installeer voor iedereen op deze pc."

#: src/main.rs:698
msgid "Installing for everyone needs administrator approval."
msgstr "Installeren voor iedereen vereist toestemming van een beheerder."

#: src/main.rs:735 src/main.rs:1230
msgid "Lightify is still open. Quit it from its tray icon (right-click → Quit), then press Close Lightify again."
msgstr "Lightify is nog geopend. Sluit het af via het pictogram in het systeemvak (rechtsklik → Afsluiten) en klik dan opnieuw op Lightify sluiten."

#: src/main.rs:891
msgid "Lightify isn't installed"
msgstr "Lightify is niet geïnstalleerd"

#: src/main.rs:892
msgid "There is no Lightify install on this PC to update. Download Setup from lightify.stream."
msgstr "Er is geen Lightify-installatie op deze pc om bij te werken. Download het installatieprogramma van lightify.stream."

#: src/main.rs:1119
msgid "There is no Lightify install in {}."
msgstr "Er is geen Lightify-installatie in {}."

#: src/main.rs:1121
msgid "Nothing to remove"
msgstr "Niets te verwijderen"

#: src/main.rs:1186
msgid "Lightify wasn't fully removed"
msgstr "Lightify is niet volledig verwijderd"

#: src/main.rs:1198
msgid "Lightify is open. Setup can close it for you, then remove it."
msgstr "Lightify is geopend. Het installatieprogramma kan het voor je sluiten en daarna verwijderen."

#: src/main.rs:1330 src/ops.rs:90
msgid "Pick a folder, not the root of a drive."
msgstr "Kies een map, niet de hoofdmap van een station."

