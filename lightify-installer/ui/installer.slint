// Lightify setup / updater / uninstaller - one window, three modes.
// Layout, copy, sizes and colours follow redesign-mockups/v3/Installer.dc.html.
// No Windows chrome anywhere: no-frame window, own title strip, own controls.

import "../../lightify-shell/ui/fonts/SpaceGrotesk-Regular.ttf";
import "../../lightify-shell/ui/fonts/SpaceGrotesk-Medium.ttf";
import "../../lightify-shell/ui/fonts/SpaceGrotesk-Bold.ttf";
import "../../lightify-shell/ui/fonts/JetBrainsMono-Regular.ttf";
import "../../lightify-shell/ui/fonts/JetBrainsMono-Medium.ttf";
import "../../lightify-shell/ui/fonts/Yellowtail-Regular.ttf";

global Pal {
    out property <color> bg: #0a0a0a;
    out property <color> panel: #0d0d0d;
    out property <color> surface: #111111;
    out property <color> s2: #161616;
    out property <color> s3: #1e1e1e;
    out property <color> line: #232323;
    out property <color> line2: #2e2e2e;
    out property <color> line3: #4a4a4a;
    out property <color> text: #f5f5f5;
    out property <color> text-ck: #d6d6d6;
    out property <color> muted: #b3b3b3;
    out property <color> dim: #969696;
    out property <color> accent: #34d399;
    out property <color> close-hover: #c42b1c;
    out property <color> danger: #f87171;
}

global Ico {
    out property <string> check: "M5 12.5l4.5 4.5L19 7.5";
    out property <string> close: "M6.5 6.5l11 11M17.5 6.5l-11 11";
    out property <string> minimize: "M6 12h12";
    out property <string> logo: "M7 4.5v15h10";
    out property <string> globe: "M3.5 12a8.5 8.5 0 1 0 17 0a8.5 8.5 0 1 0 -17 0M3.5 12h17M12 3.5c-2.6 2.4-3.9 5.2-3.9 8.5s1.3 6.1 3.9 8.5M12 3.5c2.6 2.4 3.9 5.2 3.9 8.5s-1.3 6.1-3.9 8.5";
    out property <string> chevron: "M7.5 10l4.5 4.5 4.5-4.5";
}

export struct Step {
    label: string,
    // 0 = to do, 1 = now, 2 = done
    state: int,
}

export struct LicLine {
    // 0 = paragraph, 1 = heading, 2 = sub-heading, 3 = bullet
    kind: int,
    text: string,
}

// A translated sentence around one link ("I accept the <a>licence</a>", split by
// main.rs split_link); a gap is the 4 px space next to the link.
export struct LinkText {
    before: string,
    gap-before: bool,
    link: string,
    gap-after: bool,
    after: string,
}

// A neon word, as the app's titlebar wordmark: the text over a soft glow of itself
// (no text shadow in the software renderer — two faint rings of offset copies).
component NeonText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 22px;
    in property <color> ink;
    in property <color> glow;
    in property <float> strength: 1;
    width: main.preferred-width;
    height: main.preferred-height;
    for o in [{x: 1, y: 0}, {x: 0.71, y: 0.71}, {x: 0, y: 1}, {x: -0.71, y: 0.71},
              {x: -1, y: 0}, {x: -0.71, y: -0.71}, {x: 0, y: -1}, {x: 0.71, y: -0.71}] : Text {
        x: o.x * 2.6px; y: o.y * 2.6px;
        text: root.text; font-size: root.font-size; font-family: "Yellowtail";
        color: root.glow.with-alpha(min(1, 0.11 * root.strength));
    }
    for o in [{x: 1, y: 0}, {x: 0.71, y: 0.71}, {x: 0, y: 1}, {x: -0.71, y: 0.71},
              {x: -1, y: 0}, {x: -0.71, y: -0.71}, {x: 0, y: -1}, {x: 0.71, y: -0.71}] : Text {
        x: o.x * 1.2px; y: o.y * 1.2px;
        text: root.text; font-size: root.font-size; font-family: "Yellowtail";
        color: root.glow.with-alpha(min(1, 0.3 * root.strength));
    }
    main := Text {
        x: 0; y: 0;
        text: root.text; font-size: root.font-size; font-family: "Yellowtail";
        color: root.ink;
    }
}

// The Lightify mark: an L stroke with the accent dot (24-unit grid).
component Logo inherits Rectangle {
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Ico.logo;
        fill: transparent;
        stroke: Pal.text;
        stroke-width: root.size * 2 / 24;
        stroke-line-cap: round;
    }
    Rectangle {
        width: root.size * 4.4 / 24;
        height: self.width;
        border-radius: self.width / 2;
        x: root.size * (17 - 2.2) / 24;
        y: root.size * (6.5 - 2.2) / 24;
        background: Pal.accent;
    }
}

component Icon inherits Path {
    in property <length> size: 14px;
    in property <float> weight: 1.6;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke-width: root.size * root.weight / 24;
    stroke-line-cap: round;
}

// Title-strip window control (44 x 38).
component WinBtn inherits Rectangle {
    in property <string> cmds;
    in property <bool> is-close;
    callback clicked <=> ta.clicked;
    width: 44px;
    height: 38px;
    background: ta.has-hover ? (root.is-close ? Pal.close-hover : Pal.s2) : transparent;
    animate background { duration: 120ms; }
    ta := TouchArea { }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: root.cmds;
        stroke: ta.has-hover ? (root.is-close ? #ffffff : Pal.text) : Pal.dim;
    }
}

component Lbl inherits Text {
    font-family: "JetBrains Mono";
    font-size: 11px;
    font-weight: 500;
    color: Pal.dim;
    letter-spacing: 0.22px;
}

component H1 inherits Text {
    font-size: 28px;
    font-weight: 600;
    color: Pal.text;
    letter-spacing: -0.56px;
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    in property <int> font-weight: 600;
    callback clicked;
    height: 38px;
    width: lbl.preferred-width + 40px;
    border-radius: 19px;
    border-width: 1px;
    border-color: root.primary ? Pal.text : ((ta.has-hover && root.enabled) ? Pal.line3 : Pal.line2);
    background: root.primary ? Pal.text : ((ta.has-hover && root.enabled) ? Pal.s2 : transparent);
    opacity: root.enabled ? 1 : 0.35;
    animate background, border-color { duration: 150ms; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    lbl := Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.primary ? Pal.bg : Pal.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component CheckBox inherits Rectangle {
    in property <bool> checked;
    callback toggled;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.checked ? Pal.text : Pal.line3;
    background: root.checked ? Pal.text : transparent;
    animate background, border-color { duration: 150ms; }
    if root.checked : Icon {
        x: 3px;
        y: 3px;
        size: 12px;
        weight: 3;
        commands: Ico.check;
        stroke: Pal.bg;
    }
}

// Checkbox + label; the whole row toggles.
component Check inherits Rectangle {
    in property <bool> checked;
    in property <string> text;
    callback toggled;
    height: 20px;
    width: row.preferred-width;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    row := HorizontalLayout {
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            CheckBox { checked: root.checked; }
        }
        Text {
            text: root.text;
            font-size: 13.5px;
            color: Pal.text-ck;
            vertical-alignment: center;
        }
    }
}

component Seg inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked <=> ta.clicked;
    height: 28px;
    width: t.preferred-width + 24px;
    border-radius: 14px;
    background: root.selected ? Pal.s3 : transparent;
    animate background { duration: 150ms; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; }
    t := Text {
        text: root.text;
        font-size: 12.5px;
        font-weight: 500;
        color: root.selected || (ta.has-hover && root.enabled) ? Pal.text : Pal.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The language list's button: the active language in its own name; opens the list.
component LangPill inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    callback clicked <=> ta.clicked;
    height: 32px;
    width: min(row.preferred-width, 260px);
    border-radius: 16px;
    border-width: 1px;
    border-color: ta.has-hover || root.open ? Pal.line3 : Pal.line;
    background: ta.has-hover || root.open ? Pal.s2 : Pal.surface;
    animate background, border-color { duration: 150ms; }
    ta := TouchArea { mouse-cursor: pointer; }
    row := HorizontalLayout {
        padding-left: 11px;
        padding-right: 10px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Icon { size: 14px; commands: Ico.globe; stroke: Pal.dim; }
        }
        Text {
            text: root.text;
            font-size: 12.5px;
            font-weight: 500;
            color: Pal.text;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon { size: 12px; weight: 2; commands: Ico.chevron; stroke: Pal.dim; }
        }
    }
}

component Bar inherits Rectangle {
    in property <float> value;
    height: 6px;
    border-radius: 3px;
    background: Pal.s3;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        height: parent.height;
        border-radius: 3px;
        background: Pal.accent;
        animate width { duration: 180ms; easing: ease-out; }
    }
}

component StepRow inherits HorizontalLayout {
    in property <Step> step;
    spacing: 10px;
    height: 20px;
    Rectangle {
        width: 18px;
        height: 18px;
        y: 1px;
        if root.step.state == 2 : Icon {
            x: 1.5px;
            y: 1.5px;
            size: 15px;
            weight: 2;
            commands: Ico.check;
            stroke: Pal.text;
        }
        if root.step.state == 1 : Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Pal.accent;
        }
        if root.step.state == 0 : Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            border-width: 1px;
            border-color: Pal.line3;
        }
    }
    Text {
        text: root.step.label;
        font-size: 13.5px;
        color: root.step.state == 0 ? Pal.dim : Pal.text;
        vertical-alignment: center;
    }
}

// The big check in an accent circle (done pages).
component DoneMark inherits Rectangle {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background: Pal.accent;
    Icon {
        x: 13px;
        y: 13px;
        size: 26px;
        weight: 2.4;
        commands: Ico.check;
        stroke: Pal.bg;
    }
}

// Install path: a themed single-line field (typing works too) + Change.
component PathField inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    callback edited(string);
    height: 38px;
    border-radius: 10px;
    background: Pal.surface;
    border-width: 1px;
    border-color: input.has-focus ? Pal.line3 : Pal.line2;
    clip: true;
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: true;
        font-family: "JetBrains Mono";
        font-size: 12.5px;
        color: Pal.muted;
        selection-background-color: #34d39955;
        selection-foreground-color: Pal.text;
        vertical-alignment: center;
        edited => { root.edited(self.text); }
    }
}

// The licence, rendered from LICENSE.md lines, in a themed scroller.
component LicenceView inherits Rectangle {
    in property <[LicLine]> lines;
    border-radius: 10px;
    background: Pal.panel;
    border-width: 1px;
    border-color: Pal.line;
    clip: true;
    flick := Flickable {
        x: 16px;
        y: 1px;
        width: parent.width - 32px;
        height: parent.height - 2px;
        viewport-width: self.width;
        viewport-height: lay.preferred-height;
        lay := VerticalLayout {
            width: flick.width - 8px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 8px;
            // One wrapped Text per line (a nested row would lose height-for-width).
            for l in root.lines : Text {
                text: l.kind == 3 ? "\u{2022}  " + l.text : l.text;
                wrap: word-wrap;
                font-size: l.kind == 1 ? 16px : (l.kind == 2 ? 13.5px : 12.5px);
                font-weight: l.kind == 0 || l.kind == 3 ? 400 : 600;
                color: l.kind == 0 || l.kind == 3 ? Pal.muted : Pal.text;
            }
        }
    }
    // Scroll thumb: shown when the text overflows; drag or click the track to jump.
    property <length> track: root.height - 12px;
    property <length> over: max(0px, flick.viewport-height - flick.height);
    property <length> thumb: root.over > 0 ? max(28px, root.track * flick.height / flick.viewport-height) : 0px;
    if root.over > 0 : Rectangle {
        x: root.width - 10px;
        y: 6px;
        width: 6px;
        height: root.track;
        Rectangle {
            y: (root.track - root.thumb) * (-flick.viewport-y / root.over);
            width: parent.width;
            height: root.thumb;
            border-radius: 3px;
            background: drag.has-hover || drag.pressed ? Pal.line3 : Pal.line2;
        }
        drag := TouchArea {
            function seek(py: length) {
                flick.viewport-y = -clamp((py - root.thumb / 2) / max(1px, root.track - root.thumb), 0, 1) * root.over;
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    self.seek(self.mouse-y);
                }
            }
            moved => {
                if (self.pressed) {
                    self.seek(self.mouse-y);
                }
            }
        }
    }
}

export component InstallerWindow inherits Window {
    // "install" | "update" | "uninstall"
    in property <string> mode: "install";
    // install: welcome | licence | closeapp | installing | done | error
    // uninstall: confirm | closeapp | removing | removed | error
    // update: update | error
    in property <string> page: "welcome";
    in property <string> version: "2.3.0";

    // Welcome
    in-out property <bool> for-all: false;
    in property <bool> scope-locked: false;
    in-out property <string> install-path: "%LOCALAPPDATA%\\Programs\\Lightify";
    in-out property <bool> desktop: false;
    in-out property <bool> accepted: false;
    in property <string> welcome-note;
    in property <[LicLine]> licence;
    in property <LinkText> accept;

    // Language list (LANGUAGE-PLAN.md): English first, then each bundled language in its
    // own name; hidden while English is the only one.
    in property <[string]> languages: [];
    in property <int> language-index: 0;
    in-out property <bool> lang-open: false;

    // Progress
    in property <float> progress: 0;
    in property <string> current: "";
    in property <[Step]> steps: [];

    // Done / uninstall
    in-out property <bool> launch: true;
    in-out property <bool> wipe: false;

    // Close-app prompt (install and uninstall)
    in property <bool> closing: false;
    in property <string> closeapp-note;

    // Error page
    in property <string> error-title: @tr("Setup couldn't finish");
    in property <string> error-text;
    in property <bool> error-can-back: false;

    // Update window
    in property <string> update-from: "2.2.4";
    in property <string> update-to: "2.3.0";
    in property <string> update-note: @tr("Lightify reopens where you left off.");

    callback start-drag();
    callback minimize();
    callback close-window();
    callback scope-changed(bool);
    callback language-picked(int);
    callback change-path();
    callback install();
    callback finish();
    callback show-licence();
    callback hide-licence();
    callback close-app();
    callback cancel-close-app();
    callback remove();
    callback error-back();

    title: root.mode == "uninstall" ? @tr("Uninstall Lightify") : (root.mode == "update" ? @tr("Updating Lightify") : @tr("Lightify Setup"));
    icon: @image-url("../../lightify-shell/assets/lightify-icon.png");
    no-frame: true;
    background: Pal.bg;
    default-font-family: "Space Grotesk";
    width: root.mode == "update" ? 420px : 600px;
    // Install is 80px taller than uninstall for the welcome page's Premium line (2026-11-06).
    height: root.mode == "update" ? 172px : (root.mode == "install" ? 520px : 440px);

    property <bool> busy: root.page == "installing" || root.page == "removing" || root.closing;

    // ── Update window: no strip, the whole surface drags ─────────────────────
    if root.mode == "update" : Rectangle {
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.start-drag();
                }
            }
        }
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            alignment: center;
            spacing: 14px;
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Logo { size: 26px; }
                }
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.page == "error" ? @tr("Update didn't finish") : @tr("Updating Lightify");
                        font-size: 16px;
                        font-weight: 600;
                        color: Pal.text;
                    }
                    Text {
                        // An install that recorded no version says "installed".
                        text: root.update-from == "" ? @tr("installed \u{2192} {} \u{00b7} signature checked", root.update-to)
                            : @tr("{} \u{2192} {} \u{00b7} signature checked", root.update-from, root.update-to);
                        font-family: "JetBrains Mono";
                        font-size: 11.5px;
                        color: Pal.dim;
                    }
                }
            }
            Bar { value: root.progress; }
            Text {
                text: root.page == "error" ? root.error-text : root.update-note;
                font-size: 12.5px;
                color: root.page == "error" ? Pal.danger : Pal.muted;
                overflow: elide;
            }
        }
    }

    // ── Setup / uninstall window ─────────────────────────────────────────────
    if root.mode != "update" : VerticalLayout {
        // Title strip
        Rectangle {
            height: 38px;
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.start-drag();
                    }
                }
            }
            HorizontalLayout {
                padding-left: 14px;
                spacing: 8px;
                // The wordmark, as in the app: "Lightify" as a neon sign, the L lit.
                Rectangle {
                    width: wl.width + wr.width;
                    wl := NeonText {
                        x: 0; y: (parent.height - self.height) / 2;
                        text: "L"; font-size: 21px; ink: Pal.accent; glow: Pal.accent;
                    }
                    wr := NeonText {
                        x: wl.width; y: wl.y;
                        text: "ightify"; font-size: 21px; ink: #ececec; glow: #ffffff; strength: 0.3;
                    }
                }
                Text {
                    text: root.mode == "uninstall" ? @tr("uninstall") : @tr("setup");
                    font-size: 13.5px;
                    font-weight: 600;
                    letter-spacing: -0.27px;
                    color: Pal.muted;
                    vertical-alignment: center;
                }
                Text {
                    text: root.version;
                    font-family: "JetBrains Mono";
                    font-size: 11px;
                    color: Pal.dim;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.mode != "uninstall" : WinBtn {
                    cmds: Ico.minimize;
                    clicked => { root.minimize(); }
                }
                WinBtn {
                    cmds: Ico.close;
                    is-close: true;
                    clicked => { root.close-window(); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Pal.s2;
            }
        }

        // ── Welcome ──
        if root.page == "welcome" : VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 28px;
            padding-bottom: 24px;
            spacing: 20px;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Lbl { text: @tr("// welcome"); }
                    H1 { text: @tr("Install Lightify"); }
                }
                // The language list, once a language besides English is bundled. The
                // list itself opens over the page (lang-open, at the end of the window).
                if root.languages.length > 1 : VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    horizontal-stretch: 0;
                    Lbl {
                        text: @tr("language");
                        horizontal-alignment: right;
                    }
                    HorizontalLayout {
                        alignment: end;
                        LangPill {
                            text: root.languages[root.language-index];
                            open: root.lang-open;
                            clicked => { root.lang-open = !root.lang-open; }
                        }
                    }
                }
            }
            // Owner, 2026-11-06: say up front what needs Premium.
            Text {
                text: @tr("Most features need a Spotify Premium account, including the player and the downloader. Local mode plays your own music files with any account.");
                font-size: 13px;
                color: Pal.muted;
                wrap: word-wrap;
            }
            VerticalLayout {
                spacing: 8px;
                Lbl { text: @tr("install for"); }
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        height: 36px;
                        width: segs.preferred-width;
                        border-radius: 18px;
                        background: Pal.surface;
                        border-width: 1px;
                        border-color: Pal.line;
                        segs := HorizontalLayout {
                            padding: 3px;
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 2px;
                            Seg {
                                text: @tr("Just me");
                                selected: !root.for-all;
                                enabled: !root.scope-locked;
                                clicked => {
                                    if (root.for-all) {
                                        root.for-all = false;
                                        root.scope-changed(false);
                                    }
                                }
                            }
                            Seg {
                                text: @tr("Everyone on this PC");
                                selected: root.for-all;
                                enabled: !root.scope-locked;
                                clicked => {
                                    if (!root.for-all) {
                                        root.for-all = true;
                                        root.scope-changed(true);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 8px;
                Lbl { text: @tr("install to"); }
                HorizontalLayout {
                    spacing: 8px;
                    PathField {
                        text <=> root.install-path;
                        horizontal-stretch: 1;
                    }
                    Btn {
                        text: @tr("Change");
                        font-size: 13px;
                        font-weight: 500;
                        clicked => { root.change-path(); }
                    }
                }
            }
            VerticalLayout {
                spacing: 12px;
                Check {
                    text: @tr("Desktop shortcut");
                    checked: root.desktop;
                    toggled => { root.desktop = !root.desktop; }
                }
                // "I accept the licence": the row toggles, the link opens the text. One
                // translated sentence (accept), so the link sits where each language puts it.
                Rectangle {
                    height: 20px;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.accepted = !root.accepted; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            CheckBox { checked: root.accepted; }
                        }
                        HorizontalLayout {
                            if root.accept.before != "" : Text {
                                text: root.accept.before;
                                font-size: 13.5px;
                                color: Pal.text-ck;
                                vertical-alignment: center;
                            }
                            if root.accept.gap-before : Rectangle { width: 4px; }
                            link := Text {
                                text: root.accept.link;
                                font-size: 13.5px;
                                color: link-ta.has-hover ? Pal.muted : Pal.text;
                                vertical-alignment: center;
                                link-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show-licence(); }
                                }
                                Rectangle {
                                    y: parent.height / 2 + 8px;
                                    height: 1px;
                                    background: link.color;
                                }
                            }
                            if root.accept.gap-after : Rectangle { width: 4px; }
                            if root.accept.after != "" : Text {
                                text: root.accept.after;
                                font-size: 13.5px;
                                color: Pal.text-ck;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                if root.welcome-note != "" : Text {
                    text: root.welcome-note;
                    font-size: 12.5px;
                    color: Pal.danger;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if root.welcome-note == "" : Rectangle { horizontal-stretch: 1; }
                Btn {
                    text: @tr("Cancel");
                    clicked => { root.close-window(); }
                }
                Btn {
                    text: @tr("Install");
                    primary: true;
                    enabled: root.accepted && root.install-path != "";
                    clicked => { root.install(); }
                }
            }
        }

        // ── Licence ──
        if root.page == "licence" : VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 28px;
            padding-bottom: 24px;
            spacing: 16px;
            VerticalLayout {
                spacing: 6px;
                Lbl { text: @tr("// licence"); }
                H1 { text: @tr("Licence"); }
            }
            LicenceView {
                lines: root.licence;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Btn {
                    text: @tr("Back");
                    clicked => { root.hide-licence(); }
                }
                Btn {
                    text: @tr("I accept");
                    primary: true;
                    clicked => {
                        root.accepted = true;
                        root.hide-licence();
                    }
                }
            }
        }

        // ── Lightify is running ──
        if root.page == "closeapp" : VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 28px;
            padding-bottom: 24px;
            spacing: 20px;
            VerticalLayout {
                spacing: 6px;
                Lbl { text: @tr("// lightify is open"); }
                H1 { text: @tr("Close Lightify first"); }
            }
            Text {
                text: root.closeapp-note;
                font-size: 13.5px;
                color: Pal.muted;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Btn {
                    text: @tr("Cancel");
                    enabled: !root.closing;
                    clicked => { root.cancel-close-app(); }
                }
                Btn {
                    text: root.closing ? @tr("Closing\u{2026}") : @tr("Close Lightify");
                    primary: true;
                    enabled: !root.closing;
                    clicked => { root.close-app(); }
                }
            }
        }

        // ── Installing / removing ──
        if root.page == "installing" || root.page == "removing" : VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 28px;
            padding-bottom: 24px;
            spacing: 22px;
            VerticalLayout {
                spacing: 6px;
                Lbl { text: root.page == "removing" ? @tr("// uninstalling") : @tr("// installing"); }
                H1 { text: root.page == "removing" ? @tr("Removing Lightify") : @tr("Installing Lightify"); }
            }
            VerticalLayout {
                spacing: 10px;
                Bar { value: root.progress; }
                HorizontalLayout {
                    Text {
                        text: root.current;
                        font-family: "JetBrains Mono";
                        font-size: 11.5px;
                        color: Pal.muted;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: @tr("{}%", round(clamp(root.progress, 0, 1) * 100));
                        font-family: "JetBrains Mono";
                        font-size: 11.5px;
                        color: Pal.dim;
                    }
                }
            }
            VerticalLayout {
                spacing: 10px;
                for s in root.steps : StepRow { step: s; }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                Btn {
                    text: @tr("Cancel");
                    enabled: false;
                }
            }
        }

        // ── Done ──
        if root.page == "done" : VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 28px;
            padding-bottom: 24px;
            spacing: 20px;
            HorizontalLayout {
                alignment: start;
                DoneMark { }
            }
            VerticalLayout {
                spacing: 6px;
                Lbl { text: @tr("// done"); }
                H1 { text: @tr("Lightify is installed"); }
                Text {
                    text: @tr("It keeps itself up to date from lightify.stream.");
                    font-size: 13.5px;
                    color: Pal.muted;
                }
            }
            Check {
                text: @tr("Launch Lightify");
                checked: root.launch;
                toggled => { root.launch = !root.launch; }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                Btn {
                    text: @tr("Finish");
                    primary: true;
                    clicked => { root.finish(); }
                }
            }
        }

        // ── Uninstall: confirm ──
        if root.page == "confirm" : VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 28px;
            padding-bottom: 24px;
            spacing: 20px;
            VerticalLayout {
                spacing: 6px;
                Lbl { text: @tr("// uninstall"); }
                H1 { text: @tr("Remove Lightify?"); }
            }
            Text {
                text: @tr("Removes the app, its shortcuts and the downloader bridge. Your downloaded music is never touched.");
                font-size: 13.5px;
                color: Pal.muted;
                wrap: word-wrap;
            }
            Check {
                text: @tr("Also remove my settings and Spotify sign-in");
                checked: root.wipe;
                toggled => { root.wipe = !root.wipe; }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Btn {
                    text: @tr("Cancel");
                    clicked => { root.close-window(); }
                }
                Btn {
                    text: @tr("Remove");
                    primary: true;
                    clicked => { root.remove(); }
                }
            }
        }

        // ── Uninstall: done ──
        if root.page == "removed" : VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 28px;
            padding-bottom: 24px;
            spacing: 20px;
            HorizontalLayout {
                alignment: start;
                DoneMark { }
            }
            VerticalLayout {
                spacing: 6px;
                Lbl { text: @tr("// removed"); }
                H1 { text: @tr("Lightify is removed"); }
                Text {
                    text: root.wipe ? @tr("Settings and sign-in were removed too. Your downloaded music was left where it is.") : @tr("Your settings and downloaded music were left where they are.");
                    font-size: 13.5px;
                    color: Pal.muted;
                    wrap: word-wrap;
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                Btn {
                    text: @tr("Close");
                    primary: true;
                    clicked => { root.finish(); }
                }
            }
        }

        // ── Error ──
        if root.page == "error" : VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 28px;
            padding-bottom: 24px;
            spacing: 20px;
            VerticalLayout {
                spacing: 6px;
                Lbl { text: @tr("// something went wrong"); }
                H1 { text: root.error-title; }
            }
            Rectangle {
                border-radius: 10px;
                background: Pal.surface;
                border-width: 1px;
                border-color: Pal.line2;
                height: err.preferred-height + 24px;
                err := Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: root.error-text;
                    font-family: "JetBrains Mono";
                    font-size: 12px;
                    color: Pal.muted;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                if root.error-can-back : Btn {
                    text: @tr("Back");
                    clicked => { root.error-back(); }
                }
                Btn {
                    text: @tr("Close");
                    primary: true;
                    clicked => { root.finish(); }
                }
            }
        }
    }

    // ── Language list, open over the welcome page ───────────────────────────
    // A list of our own (themed, and drawn in --shot renders), hung under its button;
    // a click anywhere else closes it. It scrolls when the languages outgrow the window.
    lang-probe := Lbl { visible: false; text: "language"; }
    if root.lang-open && root.mode == "install" && root.page == "welcome" && root.languages.length > 1 : Rectangle {
        // Under the button: title strip, page padding, the "language" label, its
        // spacing, the button (the welcome page's layout).
        property <length> top: 38px + 28px + lang-probe.preferred-height + 8px + 32px + 6px;
        TouchArea {
            clicked => { root.lang-open = false; }
        }
        lang-panel := Rectangle {
            width: min(max(lang-list.preferred-width, 180px), root.width - 64px);
            height: min(lang-list.preferred-height, root.height - parent.top - 16px);
            x: root.width - 32px - self.width;
            y: parent.top;
            border-radius: 10px;
            background: Pal.s2;
            border-width: 1px;
            border-color: Pal.line2;
            clip: true;
            TouchArea { }
            lang-flick := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: lang-list.preferred-height;
                lang-list := VerticalLayout {
                    width: lang-flick.width;
                    padding: 4px;
                    for name[i] in root.languages : Rectangle {
                        height: 30px;
                        border-radius: 7px;
                        background: row-ta.has-hover ? Pal.s3 : transparent;
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.lang-open = false;
                                root.language-picked(i);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 14px;
                            Text {
                                text: name;
                                font-size: 12.5px;
                                font-weight: i == root.language-index ? 600 : 400;
                                color: i == root.language-index ? Pal.text : Pal.muted;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Rectangle {
                                width: 14px;
                                if i == root.language-index : Icon {
                                    y: (parent.height - self.height) / 2;
                                    size: 14px;
                                    weight: 2;
                                    commands: Ico.check;
                                    stroke: Pal.accent;
                                }
                            }
                        }
                    }
                }
            }
            // Scroll thumb, when the list is taller than the window allows.
            property <length> over: max(0px, lang-flick.viewport-height - lang-flick.height);
            if lang-panel.over > 0 : Rectangle {
                property <length> track: lang-panel.height - 12px;
                property <length> thumb: max(24px, self.track * lang-flick.height / lang-flick.viewport-height);
                x: lang-panel.width - 7px;
                y: 6px + (self.track - self.thumb) * (-lang-flick.viewport-y / lang-panel.over);
                width: 3px;
                height: self.thumb;
                border-radius: 1.5px;
                background: Pal.line3;
            }
        }
    }

    // Window edge (Windows 11 also rounds the corners and draws its border in the
    // same colour; on Windows 10 this line is the edge).
    Rectangle {
        border-width: 1px;
        border-color: Pal.line;
        background: transparent;
    }
}
